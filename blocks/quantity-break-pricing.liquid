{% doc %}
  Quantity Break Pricing block (Horizon theme)
  ------------------------------------------------
  Drop this file in: /blocks/quantity-break-pricing.liquid

  What it does:
  - Two-column layout: tier list on the left, live price preview +
    "Add to cart" button on the right.
  - Clicking a tier selects it (and shows its discounted per-unit
    price + total). Clicking "Add to cart" sets the real quantity
    input to that tier's minimum quantity and submits the theme's
    own product form — so Horizon's normal add-to-cart / cart-drawer
    behaviour runs unchanged.

  IMPORTANT — about the price shown:
  This block calculates a *preview* price from the discount % you
  set here. It cannot change what the customer is actually charged
  by itself — no theme code can safely override checkout pricing.
  For the cart/checkout total to match what's shown, create matching
  Automatic Discounts in Shopify Admin -> Discounts (e.g. "min qty 2,
  2% off" and "min qty 6, 5% off") scoped to this product. Once those
  exist, adding the tier's quantity via this block's button will make
  the real cart total match the preview, because Shopify's discount
  engine reprices the cart itself.

  Add it to the product page:
  Theme editor -> Product page -> select the block/section that holds
  price + buy buttons -> Add block -> Quantity break pricing.
{% enddoc %}

{% liquid
  assign variant = product.selected_or_first_available_variant
  assign tiers = ''

  for i in (1..4)
    case i
      when 1
        assign t_min = block.settings.tier1_min
        assign t_max = block.settings.tier1_max
        assign t_pct = block.settings.tier1_discount
      when 2
        assign t_min = block.settings.tier2_min
        assign t_max = block.settings.tier2_max
        assign t_pct = block.settings.tier2_discount
      when 3
        assign t_min = block.settings.tier3_min
        assign t_max = block.settings.tier3_max
        assign t_pct = block.settings.tier3_discount
      when 4
        assign t_min = block.settings.tier4_min
        assign t_max = block.settings.tier4_max
        assign t_pct = block.settings.tier4_discount
    endcase

    if t_min > 0 and t_pct > 0
      assign tier_json = '{"min":' | append: t_min | append: ',"max":' | append: t_max | append: ',"pct":' | append: t_pct | append: '}'
      if tiers == ''
        assign tiers = tier_json
      else
        assign tiers = tiers | append: ',' | append: tier_json
      endif
    endif
  endfor

  assign tiers_json = '[' | append: tiers | append: ']'
%}

{% if tiers != '' %}
  <quantity-break-pricing
    class="qbp"
    data-base-price="{{ variant.price | default: 0 }}"
    data-variant-id="{{ variant.id }}"
    data-money-format="{{ shop.money_format | escape }}"
    data-tiers='{{ tiers_json }}'
    {{ block.shopify_attributes }}
  >
    {% if block.settings.heading != blank %}
      <p class="qbp__heading">{{ block.settings.heading }}</p>
    {% endif %}

    <div class="qbp__layout">
      <div class="qbp__col qbp__col--tiers">
        <ul class="qbp__list" role="list">
          {% for i in (1..4) %}
            {% case i %}
              {% when 1 %}
                {% assign t_min = block.settings.tier1_min %}{% assign t_max = block.settings.tier1_max %}{% assign t_pct = block.settings.tier1_discount %}
              {% when 2 %}
                {% assign t_min = block.settings.tier2_min %}{% assign t_max = block.settings.tier2_max %}{% assign t_pct = block.settings.tier2_discount %}
              {% when 3 %}
                {% assign t_min = block.settings.tier3_min %}{% assign t_max = block.settings.tier3_max %}{% assign t_pct = block.settings.tier3_discount %}
              {% when 4 %}
                {% assign t_min = block.settings.tier4_min %}{% assign t_max = block.settings.tier4_max %}{% assign t_pct = block.settings.tier4_discount %}
            {% endcase %}
            {% if t_min > 0 and t_pct > 0 %}
              <li class="qbp__tier">
                <button
                  type="button"
                  class="qbp__tier-button"
                  data-min="{{ t_min }}"
                  data-max="{{ t_max }}"
                  data-pct="{{ t_pct }}"
                  aria-pressed="false"
                >
                  <span class="qbp__tier-range">
                    {%- if t_max > 0 -%}
                      {{ t_min }}–{{ t_max }} {{ 'products.product.quantity_break.units' | default: 'units' }}
                    {%- else -%}
                      {{ t_min }}+ {{ 'products.product.quantity_break.units' | default: 'units' }}
                    {%- endif -%}
                  </span>
                  <span class="qbp__tier-discount">{{ t_pct }}% off</span>
                </button>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </div>

      <div class="qbp__col qbp__col--action">
        <p class="qbp__price-line">
          <span class="qbp__current-price"></span>
          <s class="qbp__compare-price" hidden></s>
        </p>
        <p class="qbp__savings" hidden></p>
        <p class="qbp__total" hidden></p>
        <button type="button" class="qbp__add-to-cart">
          {{ block.settings.button_label | default: 'Add to cart' }}
        </button>
        <p class="qbp__status" role="status" hidden></p>
      </div>
    </div>
  </quantity-break-pricing>
{% endif %}

<style>
  .qbp {
    display: block;
    margin-block: 1rem;
  }

  .qbp__heading {
    margin: 0 0 0.75em;
    font-weight: 600;
  }

  .qbp__layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
    align-items: start;
  }

  @media (max-width: 640px) {
    .qbp__layout {
      grid-template-columns: 1fr;
    }
  }

  .qbp__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .qbp__tier-button {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    background: transparent;
    border: 1px solid currentColor;
    border-radius: 0.5rem;
    padding: 0.6rem 0.85rem;
    font: inherit;
    color: inherit;
    cursor: pointer;
    opacity: 0.65;
    transition: opacity 0.15s ease, border-color 0.15s ease;
  }

  .qbp__tier-button[aria-pressed="true"] {
    opacity: 1;
    border-width: 2px;
    padding: calc(0.6rem - 1px) calc(0.85rem - 1px);
  }

  .qbp__tier-range {
    font-size: 0.9em;
  }

  .qbp__tier-discount {
    font-weight: 600;
  }

  .qbp__col--action {
    border: 1px solid currentColor;
    border-radius: 0.5rem;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .qbp__price-line {
    margin: 0;
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    flex-wrap: wrap;
    font-size: 1.1em;
    font-weight: 600;
  }

  .qbp__compare-price {
    font-weight: 400;
    opacity: 0.6;
  }

  .qbp__savings,
  .qbp__total {
    margin: 0;
    font-size: 0.85em;
    opacity: 0.8;
  }

  .qbp__add-to-cart {
    margin-top: 0.5rem;
    border: 1px solid currentColor;
    border-radius: 0.5rem;
    padding: 0.75rem 1rem;
    background: currentColor;
    cursor: pointer;
    font: inherit;
  }

  .qbp__add-to-cart span,
  .qbp__add-to-cart {
    color: Canvas;
  }

  .qbp__add-to-cart:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .qbp__status {
    margin: 0;
    font-size: 0.85em;
  }
</style>

<script>
  (function () {
    if (customElements.get('quantity-break-pricing')) return;

    class QuantityBreakPricing extends HTMLElement {
      connectedCallback() {
        this.basePrice = parseInt(this.dataset.basePrice, 10) || 0;
        this.variantId = this.dataset.variantId;
        this.moneyFormat = this.dataset.moneyFormat || '${{amount}}';

        try {
          this.tiers = JSON.parse(this.dataset.tiers || '[]');
        } catch (e) {
          this.tiers = [];
        }

        // The quantity input + submit button live in the theme's own
        // product form, which may be a sibling block rather than a
        // descendant of this element.
        this.form =
          this.closest('form') ||
          (this.closest('.shopify-section') || document).querySelector('form[action*="/cart/add"]');

        this._onVariantUpdate = this._onVariantUpdate.bind(this);
        const sectionRoot = this.closest('.shopify-section') || this.form || document;
        sectionRoot.addEventListener('variant:update', this._onVariantUpdate);

        this.tierButtons = Array.from(this.querySelectorAll('.qbp__tier-button'));
        this.tierButtons.forEach((btn) => {
          btn.addEventListener('click', () => this.selectTier(btn));
        });

        this.addToCartButton = this.querySelector('.qbp__add-to-cart');
        this.addToCartButton.addEventListener('click', () => this.addToCart());

        // Default to the first tier so the panel is always usable.
        if (this.tierButtons.length) this.selectTier(this.tierButtons[0]);
      }

      disconnectedCallback() {
        const sectionRoot = this.closest('.shopify-section') || this.form || document;
        sectionRoot.removeEventListener('variant:update', this._onVariantUpdate);
      }

      _onVariantUpdate(event) {
        const variant = event && event.detail && event.detail.data && event.detail.data.variant;
        if (variant && typeof variant.price === 'number') {
          this.basePrice = variant.price;
          this.variantId = variant.id;
          this.updatePricePreview();
        }
      }

      selectTier(button) {
        this.tierButtons.forEach((btn) => btn.setAttribute('aria-pressed', 'false'));
        button.setAttribute('aria-pressed', 'true');
        this.selectedTier = {
          min: parseInt(button.dataset.min, 10),
          max: parseInt(button.dataset.max, 10),
          pct: parseInt(button.dataset.pct, 10),
        };
        this.updatePricePreview();
      }

      formatMoney(cents) {
        if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
          return window.Shopify.formatMoney(cents, this.moneyFormat);
        }
        const amount = (cents / 100).toFixed(2);
        return this.moneyFormat.replace(/\{\{\s*amount\s*\}\}/, amount);
      }

      updatePricePreview() {
        const tier = this.selectedTier;
        const currentEl = this.querySelector('.qbp__current-price');
        const compareEl = this.querySelector('.qbp__compare-price');
        const savingsEl = this.querySelector('.qbp__savings');
        const totalEl = this.querySelector('.qbp__total');

        if (!tier) return;

        const unitPrice = Math.round(this.basePrice * (1 - tier.pct / 100));
        const total = unitPrice * tier.min;

        currentEl.textContent = this.formatMoney(unitPrice) + ' / unit';
        compareEl.textContent = this.formatMoney(this.basePrice);
        compareEl.hidden = tier.pct <= 0;

        savingsEl.textContent = 'You save ' + tier.pct + '%';
        savingsEl.hidden = false;

        totalEl.textContent =
          'Est. total for ' + tier.min + ': ' + this.formatMoney(total);
        totalEl.hidden = false;
      }

      setStatus(message) {
        const statusEl = this.querySelector('.qbp__status');
        statusEl.textContent = message;
        statusEl.hidden = !message;
      }

      addToCart() {
        const tier = this.selectedTier;
        if (!tier || !this.form) {
          this.setStatus('Could not find the product form on this page.');
          return;
        }

        const qtyInput = this.form.querySelector('input[name="quantity"]');
        if (qtyInput) {
          qtyInput.value = tier.min;
          qtyInput.dispatchEvent(new Event('input', { bubbles: true }));
          qtyInput.dispatchEvent(new Event('change', { bubbles: true }));
        }

        this.addToCartButton.disabled = true;
        this.setStatus('Adding to cart…');

        // Submit the theme's own product form so its existing
        // add-to-cart / cart-drawer / error handling runs as normal.
        if (typeof this.form.requestSubmit === 'function') {
          this.form.requestSubmit();
        } else {
          const submitBtn = this.form.querySelector('button[type="submit"], button[name="add"]');
          if (submitBtn) submitBtn.click();
        }

        // Re-enable shortly after; the theme's own form handles the
        // actual network request and its own loading state.
        window.setTimeout(() => {
          this.addToCartButton.disabled = false;
          this.setStatus('');
        }, 1500);
      }
    }

    customElements.define('quantity-break-pricing', QuantityBreakPricing);
  })();
</script>

