{% doc %}
  Quantity Break Pricing block (Horizon theme)
  ------------------------------------------------
  Drop this file in: /blocks/quantity-break-pricing.liquid

  What it does:
  - Renders a pricing table: Setting | Quantity | Unit price | Add to cart,
    with a "Minimum" row at full price plus one row per configured
    price break / discount tier.
  - Each row's "Add to cart" button sets the real quantity input to
    that row's quantity and submits the theme's own product form, so
    Horizon's normal add-to-cart / cart-drawer behaviour runs as-is.

  IMPORTANT — about the price shown:
  The "Unit price" column is a *preview* calculated from the discount
  % you set here. No theme code can safely change what's actually
  charged at checkout — that has to come from Shopify's own discount
  engine. For the cart/checkout total to match this table, create
  matching Automatic Discounts in Shopify Admin -> Discounts (e.g.
  min qty 20 -> the same % this tier implies) scoped to this product.
  Once those exist, clicking a row's Add to cart button makes the
  real cart total match the table, because Shopify reprices the cart
  itself once the discount's quantity condition is met.

  Add it to the product page:
  Theme editor -> Product page -> select the block/section that holds
  price + buy buttons -> Add block -> Quantity break pricing.
{% enddoc %}

{% liquid
  assign variant = product.selected_or_first_available_variant
  assign tiers = ''

  for i in (1..4)
    case i
      when 1
        assign t_min = block.settings.tier1_min
        assign t_max = block.settings.tier1_max
        assign t_pct = block.settings.tier1_discount
      when 2
        assign t_min = block.settings.tier2_min
        assign t_max = block.settings.tier2_max
        assign t_pct = block.settings.tier2_discount
      when 3
        assign t_min = block.settings.tier3_min
        assign t_max = block.settings.tier3_max
        assign t_pct = block.settings.tier3_discount
      when 4
        assign t_min = block.settings.tier4_min
        assign t_max = block.settings.tier4_max
        assign t_pct = block.settings.tier4_discount
    endcase

    if t_min > 0 and t_pct > 0
      assign tier_json = '{"min":' | append: t_min | append: ',"max":' | append: t_max | append: ',"pct":' | append: t_pct | append: '}'
      if tiers == ''
        assign tiers = tier_json
      else
        assign tiers = tiers | append: ',' | append: tier_json
      endif
    endif
  endfor

  assign tiers_json = '[' | append: tiers | append: ']'
%}

<quantity-break-pricing
  class="qbp"
  data-base-price="{{ variant.price | default: 0 }}"
  data-variant-id="{{ variant.id }}"
  data-money-format="{{ shop.money_format | escape }}"
  data-tiers='{{ tiers_json }}'
  {{ block.shopify_attributes }}
>
  {% if block.settings.heading != blank %}
    <p class="qbp__heading">{{ block.settings.heading }}</p>
  {% endif %}

  <table class="qbp__table">
    <thead>
      <tr>
        <th scope="col">{{ 'products.product.quantity_break.setting' | default: 'Setting' }}</th>
        <th scope="col">{{ 'products.product.quantity_break.quantity' | default: 'Quantity' }}</th>
        <th scope="col">{{ 'products.product.quantity_break.unit_price' | default: 'Unit price' }}</th>
        <th scope="col"><span class="visually-hidden">{{ block.settings.button_label | default: 'Add to cart' }}</span></th>
      </tr>
    </thead>
    <tbody>
      <tr class="qbp__row" data-min="1" data-max="0" data-pct="0">
        <td>{{ 'products.product.quantity_break.minimum' | default: 'Minimum' }}</td>
        <td>1</td>
        <td class="qbp__row-price">{{ variant.price | money }}</td>
        <td>
          <button type="button" class="qbp__row-add" data-min="1">
            {{ block.settings.button_label | default: 'Add to cart' }}
          </button>
        </td>
      </tr>

      {% assign break_count = 0 %}
      {% for i in (1..4) %}
        {% case i %}
          {% when 1 %}
            {% assign t_min = block.settings.tier1_min %}{% assign t_max = block.settings.tier1_max %}{% assign t_pct = block.settings.tier1_discount %}
          {% when 2 %}
            {% assign t_min = block.settings.tier2_min %}{% assign t_max = block.settings.tier2_max %}{% assign t_pct = block.settings.tier2_discount %}
          {% when 3 %}
            {% assign t_min = block.settings.tier3_min %}{% assign t_max = block.settings.tier3_max %}{% assign t_pct = block.settings.tier3_discount %}
          {% when 4 %}
            {% assign t_min = block.settings.tier4_min %}{% assign t_max = block.settings.tier4_max %}{% assign t_pct = block.settings.tier4_discount %}
        {% endcase %}
        {% if t_min > 0 and t_pct > 0 %}
          {% assign break_count = break_count | plus: 1 %}
          {% assign discount_multiplier = 100 | minus: t_pct %}
          {% assign unit_price = variant.price | times: discount_multiplier | divided_by: 100 %}
          <tr class="qbp__row" data-min="{{ t_min }}" data-max="{{ t_max }}" data-pct="{{ t_pct }}">
            <td>{{ 'products.product.quantity_break.price_break' | default: 'Price break' }} {{ break_count }}</td>
            <td>
              {%- if t_max > 0 -%}
                {{ t_min }}–{{ t_max }}
              {%- else -%}
                {{ t_min }}
              {%- endif -%}
            </td>
            <td class="qbp__row-price">{{ unit_price | money }}</td>
            <td>
              <button type="button" class="qbp__row-add" data-min="{{ t_min }}">
                {{ block.settings.button_label | default: 'Add to cart' }}
              </button>
            </td>
          </tr>
        {% endif %}
      {% endfor %}
    </tbody>
  </table>

  <p class="qbp__status" role="status" hidden></p>
</quantity-break-pricing>

<style>
  .qbp {
    display: block;
    margin-block: 1rem;
  }

  .qbp__heading {
    margin: 0 0 0.75em;
    font-weight: 600;
  }

  .qbp__table {
    width: 100%;
    border-collapse: collapse;
  }

  .qbp__table th,
  .qbp__table td {
    text-align: left;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid color-mix(in srgb, currentColor 15%, transparent);
  }

  .qbp__table thead th {
    background: color-mix(in srgb, currentColor 8%, transparent);
    font-weight: 600;
  }

  .qbp__row-price {
    white-space: nowrap;
  }

  .qbp__row-add {
    border: 1px solid currentColor;
    border-radius: 0.4rem;
    padding: 0.45rem 0.9rem;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
    white-space: nowrap;
  }

  .qbp__row-add:hover {
    background: color-mix(in srgb, currentColor 10%, transparent);
  }

  .qbp__row-add:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .qbp__status {
    margin: 0.5rem 0 0;
    font-size: 0.85em;
  }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
  }
</style>

<script>
  (function () {
    if (customElements.get('quantity-break-pricing')) return;

    class QuantityBreakPricing extends HTMLElement {
      connectedCallback() {
        this.basePrice = parseInt(this.dataset.basePrice, 10) || 0;
        this.variantId = this.dataset.variantId;
        this.moneyFormat = this.dataset.moneyFormat || '${{amount}}';

        // The quantity input + submit button live in the theme's own
        // product form, which may be a sibling block rather than a
        // descendant of this element.
        this.form =
          this.closest('form') ||
          (this.closest('.shopify-section') || document).querySelector('form[action*="/cart/add"]');

        this._onVariantUpdate = this._onVariantUpdate.bind(this);
        const sectionRoot = this.closest('.shopify-section') || this.form || document;
        sectionRoot.addEventListener('variant:update', this._onVariantUpdate);

        this.rows = Array.from(this.querySelectorAll('.qbp__row'));
        this.rows.forEach((row) => {
          const btn = row.querySelector('.qbp__row-add');
          btn.addEventListener('click', () => this.addToCart(row));
        });
      }

      disconnectedCallback() {
        const sectionRoot = this.closest('.shopify-section') || this.form || document;
        sectionRoot.removeEventListener('variant:update', this._onVariantUpdate);
      }

      _onVariantUpdate(event) {
        const variant = event && event.detail && event.detail.data && event.detail.data.variant;
        if (variant && typeof variant.price === 'number') {
          this.basePrice = variant.price;
          this.variantId = variant.id;
          this.refreshPrices();
        }
      }

      formatMoney(cents) {
        if (window.Shopify && typeof window.Shopify.formatMoney === 'function') {
          return window.Shopify.formatMoney(cents, this.moneyFormat);
        }
        const amount = (cents / 100).toFixed(2);
        return this.moneyFormat.replace(/\{\{\s*amount\s*\}\}/, amount);
      }

      refreshPrices() {
        this.rows.forEach((row) => {
          const pct = parseInt(row.dataset.pct, 10) || 0;
          const unitPrice = Math.round(this.basePrice * (1 - pct / 100));
          row.querySelector('.qbp__row-price').textContent = this.formatMoney(unitPrice);
        });
      }

      setStatus(message) {
        const statusEl = this.querySelector('.qbp__status');
        statusEl.textContent = message;
        statusEl.hidden = !message;
      }

      addToCart(row) {
        if (!this.form) {
          this.setStatus('Could not find the product form on this page.');
          return;
        }

        const qty = parseInt(row.dataset.min, 10) || 1;
        const qtyInput = this.form.querySelector('input[name="quantity"]');
        if (qtyInput) {
          qtyInput.value = qty;
          qtyInput.dispatchEvent(new Event('input', { bubbles: true }));
          qtyInput.dispatchEvent(new Event('change', { bubbles: true }));
        }

        const btn = row.querySelector('.qbp__row-add');
        btn.disabled = true;
        this.setStatus('Adding to cart…');

        // Submit the theme's own product form so its existing
        // add-to-cart / cart-drawer / error handling runs as normal.
        if (typeof this.form.requestSubmit === 'function') {
          this.form.requestSubmit();
        } else {
          const submitBtn = this.form.querySelector('button[type="submit"], button[name="add"]');
          if (submitBtn) submitBtn.click();
        }

        window.setTimeout(() => {
          btn.disabled = false;
          this.setStatus('');
        }, 1500);
      }
    }

    customElements.define('quantity-break-pricing', QuantityBreakPricing);
  })();
</script>

{% schema %}
{
  "name": "Quantity break pricing",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Buy more, save more"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Add to cart button label",
      "default": "Add to cart"
    },
    {
      "type": "header",
      "content": "Price break 1"
    },
    {
      "type": "range",
      "id": "tier1_min",
      "label": "Minimum quantity",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 20
    },
    {
      "type": "range",
      "id": "tier1_max",
      "label": "Maximum quantity (0 = no upper limit)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "tier1_discount",
      "label": "Discount",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 8
    },
    {
      "type": "header",
      "content": "Price break 2"
    },
    {
      "type": "range",
      "id": "tier2_min",
      "label": "Minimum quantity",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 50
    },
    {
      "type": "range",
      "id": "tier2_max",
      "label": "Maximum quantity (0 = no upper limit)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "tier2_discount",
      "label": "Discount",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 12
    },
    {
      "type": "header",
      "content": "Price break 3"
    },
    {
      "type": "range",
      "id": "tier3_min",
      "label": "Minimum quantity",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 100
    },
    {
      "type": "range",
      "id": "tier3_max",
      "label": "Maximum quantity (0 = no upper limit)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "tier3_discount",
      "label": "Discount",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
