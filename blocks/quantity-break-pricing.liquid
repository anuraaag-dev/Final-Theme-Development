      "content": "Price break 4 (optional)"
    },
    {
      "type": "range",
      "id": "tier4_min",
      "label": "Minimum quantity",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "tier4_max",
      "label": "Maximum quantity (0 = no upper limit)",
      "min": 0,
      "max": 100,
      "step": 1,
      "default": 0
    },
    {
      "type": "range",
      "id": "tier4_discount",
      "label": "Discount",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 0
