{% comment %}
  Renders an icon (or nothing) for the bundle tabs.
  Params:
    icon        - string: sun / moon / sparkle / star / heart / droplet / check / none
    custom_icon - optional image object; overrides the icon param when present
  Usage: {% render 'icon-step', icon: block.settings.step_icon, custom_icon: block.settings.custom_icon %}
{% endcomment %}


{% unless icon == 'none' and custom_icon == blank %}
<span class="bundle-icon-svg">
  {% if custom_icon != blank %}
    {{ custom_icon | image_url: width: 40 | image_tag: width: 20, height: 20, alt: '', loading: 'lazy' }}
  {% else %}
    {% case icon %}
      {% when 'sun' %}
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
      {% when 'moon' %}
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
      {% when 'sparkle' %}
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l1.912 5.885L20 10.8l-4.651 3.415L17.088 21 12 17.585 6.912 21l1.739-6.785L4 10.8l6.088-1.915L12 3z"/></svg>
      {% when 'star' %}
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2"/></svg>
      {% when 'heart' %}
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
      {% when 'droplet' %}
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2.69l5.66 5.66a8 8 0 1 1-11.31 0z"/></svg>
      {% when 'check' %}
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
    {% endcase %}
  {% endif %}
</span>
{% endunless %}


<style>
  .bundle-icon-svg { display: flex; align-items: center; justify-content: center; }
  .bundle-icon-svg svg,
  .bundle-icon-svg img { width: 18px; height: 18px; opacity: 0.7; }
  .bundle-tab.active .bundle-icon-svg svg,
  .bundle-tab.active .bundle-icon-svg img { opacity: 1; }
</style>


