{%- comment -%}
  Usage: {% render 'preorder-badge-pdp', product: product %}
{%- endcomment -%}

{%- if settings.preorder_enabled and settings.preorder_show_pdp -%}
  {%- assign pob_variant = product.selected_or_first_available_variant -%}

  {%- assign pob_tag_setting = settings.preorder_tag | strip | downcase -%}
  {%- assign pob_restock_prefix = settings.preorder_restock_tag_prefix | default: 'restock-' -%}
  {%- assign pob_restock_prefix_lower = pob_restock_prefix | downcase -%}
  {%- assign pob_prefix_length = pob_restock_prefix_lower.size -%}
  {%- assign pob_restock_date_string = '' -%}
  {%- assign pob_tagged = false -%}

  {%- for tag in product.tags -%}
    {%- assign pob_tag_lower = tag | downcase -%}
    {%- if pob_tag_setting != blank and pob_tag_lower == pob_tag_setting -%}
      {%- assign pob_tagged = true -%}
    {%- endif -%}
    {%- assign pob_tag_prefix_slice = pob_tag_lower | slice: 0, pob_prefix_length -%}
    {%- if pob_tag_prefix_slice == pob_restock_prefix_lower -%}
      {%- assign pob_restock_date_string = tag | slice: pob_prefix_length, 999 -%}
    {%- endif -%}
  {%- endfor -%}

  {%- assign pob_current_real_oos = false -%}
  {%- if pob_variant.inventory_management == 'shopify' and pob_variant.inventory_quantity <= 0 -%}
    {%- assign pob_current_real_oos = true -%}
  {%- endif -%}

  {%- assign pob_is_preorder = false -%}
  {%- if pob_tagged and pob_current_real_oos -%}
    {%- assign pob_is_preorder = true -%}
  {%- elsif settings.preorder_show_out_of_stock and pob_current_real_oos -%}
    {%- assign pob_is_preorder = true -%}
  {%- endif -%}

  <div data-pob-pdp-anchor>
    {%- if pob_is_preorder -%}
      <span class="pob-badge pob-badge--pdp" data-pob-badge>{{ settings.preorder_badge_text | default: 'Pre-order' }}</span>
      {%- if pob_restock_date_string != blank -%}
        <span class="pob-restock-date" data-pob-restock-date>
          {{ settings.preorder_restock_label | default: 'Expected restock:' }}
          {{ pob_restock_date_string | date: settings.preorder_date_format }}
        </span>
      {%- endif -%}
    {%- endif -%}
  </div>

  <script type="application/json" data-pob-order-data>
    {
      "handle": {{ product.handle | json }},
      "title": {{ product.title | json }},
      "tagged": {{ pob_tagged | json }},
      "showOutOfStockSetting": {{ settings.preorder_show_out_of_stock | json }},
      "badgeText": {{ settings.preorder_badge_text | default: 'Pre-order' | json }},
      "buttonText": {{ settings.preorder_button_text | default: 'Pre-order' | json }},
      "restockDate": {{ pob_restock_date_string | json }},
      "restockLabel": {{ settings.preorder_restock_label | default: 'Expected restock:' | json }},
      "currentVariantId": {{ pob_variant.id | json }},
      "optionNames": {{ product.options | json }},
      "currency": {{ cart.currency.iso_code | json }},
      "moneyFormat": {{ shop.money_format | json }},
      "variants": [
        {%- for v in product.variants -%}
          {%- assign v_real_oos = false -%}
          {%- if v.inventory_management == 'shopify' and v.inventory_quantity <= 0 -%}
            {%- assign v_real_oos = true -%}
          {%- endif -%}
          {
            "id": {{ v.id | json }},
            "title": {{ v.title | json }},
            "price": {{ v.price | json }},
            "option1": {{ v.option1 | json }},
            "option2": {{ v.option2 | json }},
            "option3": {{ v.option3 | json }},
            "realOutOfStock": {{ v_real_oos | json }}
          }{%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}