{% comment %} 
============================================================================
  COLLECTION BENTO SHOWCASE
  Asymmetric "bento grid" of navigational tiles: one large tile (image or
  uploaded video) spanning two rows on the left, two smaller tiles top
  right, and one wide tile bottom right — each linking out to a product,
  collection, or custom URL, with a title and optional status dot overlay.

  Built with Liquid, HTML, CSS and vanilla JavaScript only — no external
  libraries. Single self-contained file, Shopify Online Store 2.0
  compatible.

  NOTE ON TYPOGRAPHY: intentionally no font-family is set anywhere in this
  file's CSS. Font size, weight, letter-spacing and color are exposed as
  settings, but the typeface itself is left to inherit from the theme's
  own global font settings, so changing the font in the Theme Editor's
  typography settings is never fought by this section.
============================================================================
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign sec_id = section.id
-%}

<section
  id="CollectionBento-{{ sec_id }}"
  class="cbs"
  data-collection-bento
>
  <div class="cbs__inner">
    {%- if s.heading != blank -%}
      <h2 class="cbs__heading">{{ s.heading }}</h2>
    {%- endif -%}

    <div class="cbs__grid" data-cbs-grid>
      {%- assign small_tile_index = 0 -%}
      {%- for block in section.blocks -%}
        {%- case block.type -%}

          {%- when 'large_tile' -%}
            {%- assign bs = block.settings -%}
            <div class="cbs__tile cbs__tile--large" data-cbs-tile {{ block.shopify_attributes }}>
              <a href="{{ bs.link | default: '#' }}" class="cbs__tile-link" aria-label="{{ bs.title | escape }}">

                {%- if bs.media_type == 'video' and bs.video != blank -%}
                  <video
                    class="cbs__media cbs__media--video"
                    data-cbs-video
                    {% if bs.video_autoplay %}autoplay{% endif %}
                    {% if bs.video_loop %}loop{% endif %}
                    {% if bs.video_muted %}muted{% endif %}
                    {% unless bs.show_controls %}playsinline{% endunless %}
                    {% if bs.show_controls %}controls{% endif %}
                    preload="metadata"
                    {% if bs.image != blank %}poster="{{ bs.image | image_url: width: 1200 }}"{% endif %}
                  >
                    {%- for source in bs.video.sources -%}
                      <source src="{{ source.url }}" type="{{ source.mime_type }}">
                    {%- endfor -%}
                  </video>
                {%- elsif bs.image != blank -%}
                  <img
                    class="cbs__media"
                    src="{{ bs.image | image_url: width: 900 }}"
                    srcset="{{ bs.image | image_url: width: 500 }} 500w, {{ bs.image | image_url: width: 900 }} 900w, {{ bs.image | image_url: width: 1400 }} 1400w"
                    sizes="(min-width: 990px) 45vw, 100vw"
                    alt="{{ bs.image.alt | default: bs.title | escape }}"
                    loading="lazy"
                    width="{{ bs.image.width }}"
                    height="{{ bs.image.height }}"
                  >
                {%- else -%}
                  <div class="cbs__placeholder">{{ 'collection-1' | placeholder_svg_tag: 'cbs__placeholder-svg' }}</div>
                {%- endif -%}

                <div class="cbs__overlay" aria-hidden="true"></div>

                <div class="cbs__content">
                  {%- if bs.title != blank -%}<span class="cbs__title">{{ bs.title }}</span>{%- endif -%}
                  {%- if bs.show_badge_dot -%}<span class="cbs__badge-dot" aria-hidden="true"></span>{%- endif -%}
                </div>
              </a>
            </div>

          {%- when 'tile' -%}
            {%- assign small_tile_index = small_tile_index | plus: 1 -%}
            {%- assign bs = block.settings -%}
            <div class="cbs__tile cbs__tile--{{ small_tile_index }}" data-cbs-tile {{ block.shopify_attributes }}>
              <a href="{{ bs.link | default: '#' }}" class="cbs__tile-link" aria-label="{{ bs.title | escape }}">
                {%- if bs.image != blank -%}
                  <img
                    class="cbs__media"
                    src="{{ bs.image | image_url: width: 700 }}"
                    srcset="{{ bs.image | image_url: width: 400 }} 400w, {{ bs.image | image_url: width: 700 }} 700w, {{ bs.image | image_url: width: 1000 }} 1000w"
                    sizes="(min-width: 990px) 25vw, 100vw"
                    alt="{{ bs.image.alt | default: bs.title | escape }}"
                    loading="lazy"
                    width="{{ bs.image.width }}"
                    height="{{ bs.image.height }}"
                  >
                {%- else -%}
                  <div class="cbs__placeholder">{{ 'collection-1' | placeholder_svg_tag: 'cbs__placeholder-svg' }}</div>
                {%- endif -%}

                <div class="cbs__overlay" aria-hidden="true"></div>

                <div class="cbs__content">
                  {%- if bs.title != blank -%}<span class="cbs__title">{{ bs.title }}</span>{%- endif -%}
                  {%- if bs.show_badge_dot -%}<span class="cbs__badge-dot" aria-hidden="true"></span>{%- endif -%}
                </div>
              </a>
            </div>

        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #CollectionBento-{{ sec_id }} {
    --cbs-bg: {{ s.background_color }};
    --cbs-heading-color: {{ s.heading_color }};
    --cbs-gap: {{ s.grid_gap }}px;
    --cbs-radius: {{ s.tile_border_radius }}px;
    --cbs-overlay-color: {{ s.overlay_color }};
    --cbs-overlay-opacity: {{ s.overlay_opacity | divided_by: 100.0 }};
    --cbs-title-color: {{ s.title_color }};
    --cbs-title-size: {{ s.title_font_size }}px;
    --cbs-title-weight: {{ s.title_font_weight }};
    --cbs-badge-color: {{ s.badge_dot_color }};
    --cbs-badge-size: {{ s.badge_dot_size }}px;
    --cbs-grid-height: {{ s.grid_height_desktop }}px;
    --cbs-padding-top: {{ s.padding_top }}px;
    --cbs-padding-bottom: {{ s.padding_bottom }}px;

    display: block;
    background: var(--cbs-bg);
    padding-block: var(--cbs-padding-top) var(--cbs-padding-bottom);
  }

  {%- if s.full_width -%}
  #CollectionBento-{{ sec_id }} {
    width: 100vw;
    max-width: 100vw;
    /* Breaks the section out of the theme's page-width/container wrapper
       so its background spans the full viewport edge-to-edge, regardless
       of that wrapper's own max-width or side padding. */
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
  }
  {%- endif -%}

  #CollectionBento-{{ sec_id }} * {
    box-sizing: border-box;
  }

  #CollectionBento-{{ sec_id }} .cbs__inner {
    max-width: 1400px;
    margin: 0 auto;
    padding-inline: 24px;
  }

  #CollectionBento-{{ sec_id }} .cbs__heading {
    font-size: clamp(1.4rem, 2.6vw, 1.9rem);
    font-weight: 700;
    color: var(--cbs-heading-color);
    margin: 0 0 20px;
  }

  /* ---- Grid ---- */
  #CollectionBento-{{ sec_id }} .cbs__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    grid-template-areas:
      "large tr1 tr2"
      "large wide wide";
    gap: var(--cbs-gap);
    height: var(--cbs-grid-height);
  }

  #CollectionBento-{{ sec_id }} .cbs__tile--large { grid-area: large; }
  #CollectionBento-{{ sec_id }} .cbs__tile--1 { grid-area: tr1; }
  #CollectionBento-{{ sec_id }} .cbs__tile--2 { grid-area: tr2; }
  #CollectionBento-{{ sec_id }} .cbs__tile--3 { grid-area: wide; }

  /* ---- Tile ---- */
  #CollectionBento-{{ sec_id }} .cbs__tile {
    position: relative;
    border-radius: var(--cbs-radius);
    overflow: hidden;
    background: #1a1a1a;
  }

  #CollectionBento-{{ sec_id }} .cbs__tile-link {
    display: block;
    position: relative;
    width: 100%;
    height: 100%;
    text-decoration: none;
  }

  #CollectionBento-{{ sec_id }} .cbs__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.5s cubic-bezier(0.22,1,0.36,1);
  }

  #CollectionBento-{{ sec_id }} .cbs__placeholder,
  #CollectionBento-{{ sec_id }} .cbs__placeholder-svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: #2a2a2a;
  }

  {%- if s.enable_hover_zoom -%}
  #CollectionBento-{{ sec_id }} .cbs__tile-link:hover .cbs__media {
    transform: scale(1.05);
  }
  {%- endif -%}

  #CollectionBento-{{ sec_id }} .cbs__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, var(--cbs-overlay-color) 0%, transparent 55%);
    opacity: var(--cbs-overlay-opacity);
    pointer-events: none;
  }

  #CollectionBento-{{ sec_id }} .cbs__content {
    position: absolute;
    left: 20px;
    bottom: 18px;
    right: 20px;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  #CollectionBento-{{ sec_id }} .cbs__title {
    font-size: var(--cbs-title-size);
    font-weight: var(--cbs-title-weight);
    color: var(--cbs-title-color);
    line-height: 1.3;
    letter-spacing: 0.01em;
  }

  #CollectionBento-{{ sec_id }} .cbs__badge-dot {
    flex: 0 0 auto;
    width: var(--cbs-badge-size);
    height: var(--cbs-badge-size);
    border-radius: 50%;
    background: var(--cbs-badge-color);
    box-shadow: 0 0 0 2px rgba(255,255,255,0.25);
  }

  /* ---- Tablet: large tile full width top, two small tiles side by side,
     wide tile full width bottom ---- */
  @media screen and (max-width: 989px) {
    #CollectionBento-{{ sec_id }} .cbs__grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto auto;
      grid-template-areas:
        "large large"
        "tr1 tr2"
        "wide wide";
      height: auto;
    }

    #CollectionBento-{{ sec_id }} .cbs__tile--large {
      aspect-ratio: 16 / 9;
    }

    #CollectionBento-{{ sec_id }} .cbs__tile--1,
    #CollectionBento-{{ sec_id }} .cbs__tile--2 {
      aspect-ratio: 1 / 1;
    }

    #CollectionBento-{{ sec_id }} .cbs__tile--3 {
      aspect-ratio: 21 / 9;
    }
  }

  /* ---- Mobile: fully stacked single column ---- */
  @media screen and (max-width: 749px) {
    #CollectionBento-{{ sec_id }} .cbs__grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        "large"
        "tr1"
        "tr2"
        "wide";
      gap: {{ s.grid_gap | times: 0.7 | round }}px;
    }

    #CollectionBento-{{ sec_id }} .cbs__tile--large {
      aspect-ratio: {{ s.mobile_tile_aspect_ratio }};
    }

    #CollectionBento-{{ sec_id }} .cbs__tile--1,
    #CollectionBento-{{ sec_id }} .cbs__tile--2,
    #CollectionBento-{{ sec_id }} .cbs__tile--3 {
      aspect-ratio: {{ s.mobile_tile_aspect_ratio }};
    }

    #CollectionBento-{{ sec_id }} .cbs__content {
      left: 16px;
      right: 16px;
      bottom: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #CollectionBento-{{ sec_id }} .cbs__media {
      transition: none !important;
    }
  }
</style> 



<script>
(function () {
  'use strict';

  var section = document.getElementById('CollectionBento-{{ sec_id }}');
  if (!section) return;

  /* ------------------------------------------------------------------
     Video autoplay resilience for the large tile's video (if used).
     Some mobile browsers block autoplay even when muted+playsinline are
     set if the attributes were applied after parse; force a play() call
     and retry once on the first user interaction if it was blocked.
     ------------------------------------------------------------------ */
  var video = section.querySelector('[data-cbs-video]');
  if (video) {
    var tryPlay = function () {
      var playPromise = video.play();
      if (playPromise && typeof playPromise.catch === 'function') {
        playPromise.catch(function () {
          var resumeOnInteraction = function () {
            video.play().catch(function () {});
            document.removeEventListener('touchstart', resumeOnInteraction);
            document.removeEventListener('click', resumeOnInteraction);
          };
          document.addEventListener('touchstart', resumeOnInteraction, { once: true, passive: true });
          document.addEventListener('click', resumeOnInteraction, { once: true });
        });
      }
    };

    if (video.hasAttribute('autoplay')) {
      if (video.readyState >= 2) {
        tryPlay();
      } else {
        video.addEventListener('loadeddata', tryPlay, { once: true });
      }

      // Pause while scrolled off-screen and resume when back in view, so
      // an autoplaying video isn't burning battery/bandwidth for a tile
      // the visitor isn't currently looking at.
      if ('IntersectionObserver' in window) {
        var videoObserver = new IntersectionObserver(function (entries) {
          entries.forEach(function (entry) {
            if (entry.isIntersecting) {
              video.play().catch(function () {});
            } else {
              video.pause();
            }
          });
        }, { threshold: 0.1 });
        videoObserver.observe(video);
      }
    }
  }
})();
</script>

{% schema %}
{
  "name": "Collection Bento Showcase",
  "tag": "section",
  "class": "section section--collection-bento",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (optional)"
    },
    {
      "type": "header",
      "content": "Grid Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width section",
      "info": "Breaks the section out of the theme's content container so its background spans the full browser width edge-to-edge. Content inside still stays readable at a max-width.",
      "default": true
    },
    {
      "type": "range",
      "id": "grid_gap",
      "label": "Gap between tiles",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "tile_border_radius",
      "label": "Tile corner radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "grid_height_desktop",
      "label": "Grid height (desktop)",
      "min": 300,
      "max": 900,
      "step": 10,
      "unit": "px",
      "default": 500
    },
    {
      "type": "select",
      "id": "mobile_tile_aspect_ratio",
      "label": "Tile aspect ratio (mobile, stacked)",
      "options": [
        { "value": "1/1", "label": "Square" },
        { "value": "4/3", "label": "Landscape" },
        { "value": "3/4", "label": "Portrait" },
        { "value": "16/9", "label": "Widescreen" }
      ],
      "default": "4/3"
    },
    {
      "type": "checkbox",
      "id": "enable_hover_zoom",
      "label": "Zoom media on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Overlay"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay gradient color",
      "default": "#000000"
    },
    {
      "type": "range",
