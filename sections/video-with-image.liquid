<style>

  #vis-{{ section.id }} {
    --vis-bg:          {{ section.settings.section_bg }};
    --vis-radius:      {{ section.settings.border_radius }}px;
    --vis-min-h-desk:  {{ section.settings.min_height_desktop }}px;
    --vis-min-h-mob:   {{ section.settings.min_height_mobile }}px;
    --vis-overlay-rgb: {{ section.settings.image_overlay_color | color_to_rgb | remove: 'rgb(' | remove: ')' }};
    --vis-overlay-op:  {{ section.settings.image_overlay_opacity | divided_by: 100.0 }};
    --vis-heading-color: {{ section.settings.heading_color }};
    --vis-sub-color:     {{ section.settings.subheading_color }};
    --vis-btn-bg:        {{ section.settings.btn_bg }};
    --vis-btn-text:      {{ section.settings.btn_text_color }};
    --vis-btn-border:    {{ section.settings.btn_border_color }};
    --vis-ease:          cubic-bezier(0.4, 0, 0.2, 1);

    background: var(--vis-bg);
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }

  /* ── Section label ─────────────────────────────────────── */
  #vis-{{ section.id }} .vis-section-label {
    text-align: {{ section.settings.section_label_align }};
    padding: 0 24px;
    margin: 0 auto {{ section.settings.label_gap }}px;
    max-width: {% if section.settings.full_width %}100%{% else %}1400px{% endif %};
    color: {{ section.settings.section_label_color }};
    font-size: clamp(11px, 1.1vw, 13px);
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* ── Outer container ───────────────────────────────────── */
  #vis-{{ section.id }} .vis-outer {
    max-width: 100%;
    margin: 0 auto;
    position: relative;
    {% unless section.settings.full_width %}padding: 0 24px;{% endunless %}
  }

  /* ── Row ───────────────────────────────────────────────── */
  #vis-{{ section.id }} .vis-row {
    display: flex;
    align-items: stretch;
    overflow: hidden;
    border-radius: var(--vis-radius);
    {% if section.settings.show_shadow %}
    box-shadow: 0 12px 60px rgba(0,0,0,0.12);
    {% endif %}
    min-height: var(--vis-min-h-desk);
  }

  /* ── Panels ────────────────────────────────────────────── */
  #vis-{{ section.id }} .vis-panel {
    flex: 0 0 50%;
    position: relative;
    overflow: hidden;
    min-height: var(--vis-min-h-desk);
  }

  #vis-{{ section.id }} .vis-panel--video {
    order: {% if section.settings.layout == 'video_right' %}2{% else %}1{% endif %};
    background: #000;
  }
  #vis-{{ section.id }} .vis-panel--image {
    order: {% if section.settings.layout == 'video_right' %}1{% else %}2{% endif %};
    background: #1a1a1a;
  }

  /* ── Hosted video ──────────────────────────────────────── */
  #vis-{{ section.id }} .vis-video-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  #vis-{{ section.id }} .vis-video-wrap video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  /* Shopify sometimes wraps video in <deferred-media> or a <div> —
     make sure any intermediate wrapper also fills the panel */
  #vis-{{ section.id }} .vis-hosted-video--desk,
  #vis-{{ section.id }} .vis-hosted-video--mob {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  #vis-{{ section.id }} .vis-hosted-video--desk > *,
  #vis-{{ section.id }} .vis-hosted-video--mob > * {
    position: absolute;
    inset: 0;
    width: 100% !important;
    height: 100% !important;
  }

  /* ── YT / Vimeo iframe ─────────────────────────────────── */
  #vis-{{ section.id }} .vis-iframe-wrap {
    position: absolute;
    inset: -10%;
    width: 120%;
    height: 120%;
    pointer-events: none;
  }
  #vis-{{ section.id }} .vis-iframe-wrap iframe {
    width: 100%;
    height: 100%;
    border: none;
    pointer-events: none;
  }

  /* ── Placeholder SVG ───────────────────────────────────── */
  #vis-{{ section.id }} .vis-video-placeholder {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.25;
  }

  /* ── Video scrim ───────────────────────────────────────── */
  {% if section.settings.show_video_scrim %}
  #vis-{{ section.id }} .vis-panel--video::after {
    content: '';
    position: absolute;
    inset: 0;
    background: rgba(0,0,0,{{ section.settings.video_scrim_opacity | divided_by: 100.0 }});
    pointer-events: none;
    z-index: 1;
  }
  {% endif %}

  /* ── Play icon ─────────────────────────────────────────── */
  {% if section.settings.show_play_icon %}
  #vis-{{ section.id }} .vis-play-icon {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    pointer-events: none;
  }
  #vis-{{ section.id }} .vis-play-icon svg {
    width: 64px;
    height: 64px;
    opacity: 0.55;
    filter: drop-shadow(0 2px 12px rgba(0,0,0,0.4));
    transition: opacity 0.3s;
  }
  #vis-{{ section.id }} .vis-panel--video:hover .vis-play-icon svg {
    opacity: 0.85;
  }
  {% endif %}

  /* ── Image ─────────────────────────────────────────────── */
  #vis-{{ section.id }} .vis-image-wrap {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  #vis-{{ section.id }} .vis-image-wrap img,
  #vis-{{ section.id }} .vis-image-wrap svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
    transition: transform 0.9s var(--vis-ease);
  }
  {% if section.settings.image_zoom_on_hover %}
  #vis-{{ section.id }} .vis-panel--image:hover .vis-image-wrap img {
    transform: scale(1.04);
  }
  {% endif %}

  #vis-{{ section.id }} .vis-image-overlay {
    position: absolute;
    inset: 0;
    background: rgba(var(--vis-overlay-rgb), var(--vis-overlay-op));
    pointer-events: none;
    z-index: 1;
  }

  /* ── Text content ──────────────────────────────────────── */
  #vis-{{ section.id }} .vis-content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: {{ section.settings.content_padding }}px;
    box-sizing: border-box;
    z-index: 2;
  }
  #vis-{{ section.id }} .vis-content[data-v="top"]    { justify-content: flex-start; }
  #vis-{{ section.id }} .vis-content[data-v="center"] { justify-content: center; }
  #vis-{{ section.id }} .vis-content[data-v="bottom"] { justify-content: flex-end; }
  #vis-{{ section.id }} .vis-content[data-h="left"]   { align-items: flex-start; text-align: left; }
  #vis-{{ section.id }} .vis-content[data-h="center"] { align-items: center;     text-align: center; }
  #vis-{{ section.id }} .vis-content[data-h="right"]  { align-items: flex-end;   text-align: right; }

  #vis-{{ section.id }} .vis-eyebrow {
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--vis-heading-color);
    opacity: 0.7;
    margin: 0 0 12px;
  }

  #vis-{{ section.id }} .vis-heading {
    margin: 0 0 16px;
    font-size: clamp(24px, 3.2vw, 52px);
    font-weight: {{ section.settings.heading_weight }};
    line-height: 1.08;
    color: var(--vis-heading-color);
    text-shadow: 0 2px 24px rgba(0,0,0,0.25);
    letter-spacing: -0.01em;
  }

  #vis-{{ section.id }} .vis-subheading {
    margin: 0 0 28px;
    font-size: clamp(13px, 1.4vw, 17px);
    line-height: 1.6;
    color: var(--vis-sub-color);
    text-shadow: 0 1px 8px rgba(0,0,0,0.2);
    max-width: 420px;
  }
  #vis-{{ section.id }} .vis-subheading p { margin: 0; }

  /* ── Button ────────────────────────────────────────────── */
  #vis-{{ section.id }} .vis-btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 13px 32px;
    font-size: 12px;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: {{ section.settings.btn_radius }}px;
    transition: transform 0.2s var(--vis-ease), opacity 0.2s, box-shadow 0.2s;
    cursor: pointer;
    white-space: nowrap;
  }
  #vis-{{ section.id }} .vis-btn--primary {
    background: var(--vis-btn-bg);
    color: var(--vis-btn-text);
    border: 6px solid var(--vis-btn-bg);
  }
  #vis-{{ section.id }} .vis-btn--secondary {
    background: transparent;
    color: var(--vis-btn-text);
    border: 6px solid var(--vis-btn-border);
  }
  #vis-{{ section.id }} .vis-btn--link {
    background: transparent;
    color: var(--vis-heading-color);
    border: none;
    padding-left: 0;
    padding-right: 0;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  #vis-{{ section.id }} .vis-btn:hover {
    opacity: 0.85;
    transform: translateY(-2px);
  }
  #vis-{{ section.id }} .vis-btn--primary:hover {
    box-shadow: 0 6px 24px rgba(0,0,0,0.18);
  }
  #vis-{{ section.id }} .vis-btn svg {
    width: 15px;
    height: 15px;
    flex-shrink: 0;
    transition: transform 0.2s var(--vis-ease);
  }
  #vis-{{ section.id }} .vis-btn:hover svg {
    transform: translateX(4px);
  }

  /* ── Divider ───────────────────────────────────────────── */
  {% if section.settings.show_divider %}
  #vis-{{ section.id }} .vis-divider {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    transform: translateX(-50%);
    width: {{ section.settings.divider_width }}px;
    background: {{ section.settings.divider_color }};
    z-index: 10;
    pointer-events: none;
  }
  {% endif %}

  /* ── Hosted video visibility swap ──────────────────────── */
  #vis-{{ section.id }} .vis-hosted-video--mob { display: none; }

  /* ─────────────────────────────────────────────────────────
     RESPONSIVE BREAKPOINTS
     989px  tablet  → panels stack vertically, full width
     749px  mobile  → reduced padding & type sizes
     480px  small   → further reduction
     ───────────────────────────────────────────────────────── */

  @media (max-width: 989px) {

    #vis-{{ section.id }} .vis-row {
      flex-direction: {% if section.settings.mobile_stack_order == 'image_first' %}column-reverse{% else %}column{% endif %};
      min-height: unset;
    }

    /* Each panel goes full width and resets its desktop order */
    #vis-{{ section.id }} .vis-panel {
      flex: 0 0 100%;
      width: 100%;
      min-height: var(--vis-min-h-mob);
      order: unset !important;
    }

    /* Divider only makes sense side-by-side */
    {% if section.settings.show_divider %}
    #vis-{{ section.id }} .vis-divider { display: none; }
    {% endif %}

    #vis-{{ section.id }} .vis-subheading {
      max-width: 100%;
    }

    #vis-{{ section.id }} .vis-content {
      padding: {{ section.settings.content_padding | times: 0.8 | round }}px;
    }
  }

  @media (max-width: 749px) {

    #vis-{{ section.id }} {
      padding: {{ section.settings.padding_top | times: 0.6 | round }}px 0
               {{ section.settings.padding_bottom | times: 0.6 | round }}px;
    }

    #vis-{{ section.id }} .vis-outer {
      {% unless section.settings.full_width %}padding: 0 16px;{% endunless %}
    }

    #vis-{{ section.id }} .vis-section-label {
      padding: 0 16px;
      margin-bottom: {{ section.settings.label_gap | times: 0.7 | round }}px;
    }

    {% if section.settings.hide_video_mobile %}
    #vis-{{ section.id }} .vis-panel--video { display: none; }
    {% endif %}

    #vis-{{ section.id }} .vis-panel {
      min-height: {{ section.settings.min_height_mobile | times: 1 | round }}px;
    }

    #vis-{{ section.id }} .vis-content {
      padding: {{ section.settings.content_padding | times: 0.65 | round }}px;
    }

    #vis-{{ section.id }} .vis-eyebrow {
      font-size: 10px;
      margin-bottom: 8px;
    }

    #vis-{{ section.id }} .vis-heading {
      font-size: clamp(22px, 7vw, 36px);
      margin-bottom: 10px;
    }

    #vis-{{ section.id }} .vis-subheading {
      font-size: clamp(13px, 3.8vw, 16px);
      margin-bottom: 20px;
    }

    #vis-{{ section.id }} .vis-btn {
      padding: 11px 22px;
      font-size: 11px;
    }

    /* Swap to mobile video ONLY when a mobile video is actually set */
    {% if section.settings.video_hosted_mobile != blank %}
    #vis-{{ section.id }} .vis-hosted-video--desk { display: none; }
    #vis-{{ section.id }} .vis-hosted-video--mob  { display: block; }
    {% endif %}
  }

  @media (max-width: 480px) {

    #vis-{{ section.id }} .vis-panel {
      min-height: {{ section.settings.min_height_mobile | times: 1 | round }}px;
    }

    #vis-{{ section.id }} .vis-content {
      padding: {{ section.settings.content_padding | times: 0.5 | round }}px;
    }

    #vis-{{ section.id }} .vis-heading {
      font-size: clamp(20px, 8vw, 30px);
    }
  }

</style>


{%- liquid
  assign video_id             = section.settings.video_url.id
  assign has_hosted_video     = false
  assign has_hosted_video_mob = false
  if section.settings.video_hosted != blank
    assign has_hosted_video = true
  endif
  if section.settings.video_hosted_mobile != blank
    assign has_hosted_video_mob = true
  endif
  assign lcp_optimization = section.settings.enable_lcp_optimization
-%}

<div id="vis-{{ section.id }}" data-vis-root>

  {%- if section.settings.section_label != blank -%}
    <p class="vis-section-label">{{ section.settings.section_label }}</p>
  {%- endif -%}

  <div class="vis-outer">

    {%- if section.settings.show_divider -%}
      <div class="vis-divider" aria-hidden="true"></div>
    {%- endif -%}

    <div class="vis-row">

      <!-- ── Video panel ─────────────────────────────── -->
      <div class="vis-panel vis-panel--video" aria-label="Video">

        {%- if has_hosted_video or has_hosted_video_mob -%}
          <div class="vis-video-wrap">
            {%- if has_hosted_video -%}
              <div class="vis-hosted-video vis-hosted-video--desk">
                {{ section.settings.video_hosted | video_tag:
                    autoplay: true, loop: true, muted: true,
                    controls: false, playsinline: true,
                    image_size: '800x',
                    class: 'vis-video-el' }}
              </div>
            {%- endif -%}
            {%- if has_hosted_video_mob -%}
              <div class="vis-hosted-video vis-hosted-video--mob">
                {{ section.settings.video_hosted_mobile | video_tag:
                    autoplay: true, loop: true, muted: true,
                    controls: false, playsinline: true,
                    image_size: '600x',
                    class: 'vis-video-el' }}
              </div>
            {%- endif -%}
          </div>

        {%- elsif section.settings.video_url != blank -%}
          <div class="vis-iframe-wrap">
            {%- if section.settings.video_url.type == 'youtube' -%}
              <iframe
                src="https://www.youtube.com/embed/{{ video_id }}?autoplay=1&mute=1&loop=1&controls=0&playlist={{ video_id }}&playsinline=1&rel=0"
                allow="autoplay; encrypted-media"
                title="{{ section.settings.heading | default: 'Video' }}"
              ></iframe>
            {%- elsif section.settings.video_url.type == 'vimeo' -%}
              <iframe
                src="https://player.vimeo.com/video/{{ video_id }}?autoplay=1&muted=1&loop=1&controls=0&background=1"
                allow="autoplay; encrypted-media"
                title="{{ section.settings.heading | default: 'Video' }}"
              ></iframe>
            {%- endif -%}
          </div>

        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'vis-video-placeholder' }}
        {%- endif -%}

        {%- if section.settings.show_play_icon
              and section.settings.video_url == blank
              and has_hosted_video == false -%}
          <div class="vis-play-icon" aria-hidden="true">
            <svg viewBox="0 0 80 80" fill="none">
              <circle cx="40" cy="40" r="38" stroke="white" stroke-width="2" fill="rgba(0,0,0,0.3)"/>
              <polygon points="32,24 32,56 60,40" fill="white"/>
            </svg>
          </div>
        {%- endif -%}

      </div>
      {%- comment -%}/.vis-panel--video{%- endcomment -%}

      <!-- ── Image panel ─────────────────────────────── -->
      <div class="vis-panel vis-panel--image">

        <div class="vis-image-wrap">
          {%- if section.settings.image != blank -%}
            {%- if lcp_optimization -%}
              {{
                section.settings.image
                | image_url: width: 1400
                | image_tag:
                  loading: 'eager',
                  fetchpriority: 'high',
                  alt: section.settings.heading | default: '',
                  widths: '400, 600, 800, 1000, 1200, 1400',
                  sizes: '(max-width: 989px) 100vw, 50vw'
              }}
            {%- else -%}
              {{
                section.settings.image
                | image_url: width: 1400
                | image_tag:
                  loading: 'lazy',
                  alt: section.settings.heading | default: '',
                  widths: '400, 600, 800, 1000, 1200, 1400',
                  sizes: '(max-width: 989px) 100vw, 50vw'
              }}
            {%- endif -%}
          {%- else -%}
            {{ 'collection-apparel-1' | placeholder_svg_tag: 'vis-video-placeholder' }}
          {%- endif -%}
        </div>

        <div class="vis-image-overlay" aria-hidden="true"></div>

        <div
          class="vis-content"
          data-v="{{ section.settings.text_vertical | default: 'center' }}"
          data-h="{{ section.settings.text_horizontal | default: 'left' }}"
        >
          {%- if section.settings.eyebrow != blank -%}
            <p class="vis-eyebrow">{{ section.settings.eyebrow }}</p>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <{{ section.settings.heading_tag }} class="vis-heading">
              {{ section.settings.heading }}
            </{{ section.settings.heading_tag }}>
          {%- endif -%}

          {%- if section.settings.subheading != blank -%}
            <div class="vis-subheading">{{ section.settings.subheading }}</div>
          {%- endif -%}

          {%- if section.settings.btn_label != blank -%}
            <a
              class="vis-btn vis-btn--{{ section.settings.btn_style }}"
              href="{{ section.settings.btn_url | default: '#' }}"
              {% if section.settings.btn_new_tab %}target="_blank" rel="noopener noreferrer"{% endif %}
            >
              {{- section.settings.btn_label -}}
              {%- if section.settings.btn_show_arrow -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"/>
                  <polyline points="13 6 19 12 13 18"/>
                </svg>
              {%- endif -%}
            </a>
          {%- endif -%}

        </div>
        {%- comment -%}/.vis-content{%- endcomment -%}

      </div>
      {%- comment -%}/.vis-panel--image{%- endcomment -%}

    </div>
    {%- comment -%}/.vis-row{%- endcomment -%}
  </div>
  {%- comment -%}/.vis-outer{%- endcomment -%}
</div>


<script>
(function () {
  var root = document.getElementById('vis-{{ section.id }}');
  if (!root) return;

  var videos = Array.prototype.slice.call(root.querySelectorAll('video'));
  if (!videos.length) return;

  /* ── Force all required attributes for iOS Safari autoplay ── */
  /* iOS requires muted + playsinline + autoplay as real HTML    */
  /* attributes — not just JS properties.                        */
  videos.forEach(function (v) {
    v.muted      = true;
    v.loop       = true;
    v.setAttribute('muted', '');
    v.setAttribute('playsinline', '');
    v.setAttribute('autoplay', '');
    v.setAttribute('loop', '');
  });

  /* ── Play immediately on load ─────────────────────────────── */
  function tryPlay(v) {
    if (v.paused) {
      var p = v.play();
      if (p && p.catch) p.catch(function () {});
    }
  }

  videos.forEach(function (v) {
    /* Try right away — works if video is already loaded */
    tryPlay(v);
    /* Also try once metadata is ready (covers lazy-loaded sources) */
    v.addEventListener('loadedmetadata', function () { tryPlay(v); }, { once: true });
    /* And once enough data has buffered */
    v.addEventListener('canplay', function () { tryPlay(v); }, { once: true });
  });

  /* ── Pause when scrolled fully out of view (battery saving) ── */
  if ('IntersectionObserver' in window) {
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          tryPlay(entry.target);
        } else {
          entry.target.pause && entry.target.pause();
        }
      });
    }, { threshold: 0 }); /* threshold:0 = trigger as soon as any pixel is visible */

    videos.forEach(function (v) { io.observe(v); });
  }
})();
</script>


{% schema %}
{
  "name": "Video + Image Split",
  "tag": "section",
  "class": "vis-section-wrapper",
  "disabled_on": { "groups": ["header", "footer"] },
  "settings": [
    {
      "type": "header",
      "content": "Performance"
    },
    {
      "type": "checkbox",
      "id": "enable_lcp_optimization",
      "label": "Enable LCP optimization",
      "default": true,
      "info": "Prioritizes the panel image for fastest paint: loads it eagerly with fetchpriority=\"high\" instead of lazily, while keeping accurate responsive sizes/srcset. Turn off if this section sits further down the page (below the fold), since lazy-loading is better there."
    },
    {
      "type": "header",
      "content": "Section label"
    },
    {
      "type": "text",
      "id": "section_label",
      "label": "Eyebrow / section label"
    },
    {
      "type": "select",
      "id": "section_label_align",
      "label": "Label alignment",
      "options": [
        { "value": "left",   "label": "Left"   },
        { "value": "center", "label": "Center" },
        { "value": "right",  "label": "Right"  }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "section_label_color",
      "label": "Label colour",
      "default": "#111111"
    },
    {
      "type": "range",
      "id": "label_gap",
      "label": "Gap below label (px)",
      "min": 0, "max": 60, "step": 4,
      "default": 20
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Video position",
      "options": [
        { "value": "video_left",  "label": "Video left, image right" },
        { "value": "video_right", "label": "Video right, image left" }
      ],
      "default": "video_left"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width",
      "default": false
    },
    {
      "type": "select",
