<script src="{{ 'search-drawer.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'page-header.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign search_style = 'none'
  if section.settings.show_search
    assign search_style = 'modal'
  endif
-%}

<style>
  :root {
    --logo-width: {{ section.settings.mobile_screen_logo_width }}px;
    --logo-width-mobile: {{ section.settings.mobile_screen_logo_width }}px;
    --logo-width-desk: {{ section.settings.large_screen_logo_width }}px;
    --header-bg: #ffffff;
    --header-text: #1a1a1a;
    --header-border: #e8e8e8;
    --header-height: 64px;
    --sidebar-width: 420px;
    --accent: #1a1a1a;
    --overlay-bg: rgba(0, 0, 0, 0.45);
    --transition-speed: 0.38s;
    --transition-ease: cubic-bezier(0.77, 0, 0.175, 1);
    
    {% comment %} --font-primary: 'Georgia', 'Times New Roman', serif; {% endcomment %}
    {% comment %} --font-ui: 'Helvetica Neue', Arial, sans-serif; {% endcomment %}
  }

  *, *::before, *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .wt-header {
    position: relative;
    width: 100%;
    background: var(--header-bg);
    border-bottom: 1px solid var(--header-border);
    z-index: 100;
    {% comment %} font-family: var(--font-ui); {% endcomment %}
    font-family: var(--font-nav-family);
  }

  .wt-header--sticky {
    position: sticky;
    top: 0;
  }

  .wt-header--shadow {
    box-shadow: 0 2px 16px rgba(0,0,0,0.07);
  }

  .wt-header__body {
    display: flex;
    align-items: center;
    height: var(--header-height);
    padding: 0 24px;
    gap: 0;
    position: relative;
  }

  /* =============================================
     LAYOUT B: CENTERED + MEGA MENU (Desktop)
  ============================================= */
  @media (min-width: 991px) {
    .wt-header--layout-centered .wt-header__body {
      display: grid;
      grid-template-columns: 1fr auto 1fr;
      height: 50px;
    }

    .wt-header--layout-centered .wt-header__logo-wrapper {
      position: relative;
      left: auto;
      top: auto;
      transform: none;
      display: flex;
      justify-content: center;
    }

    .wt-header--layout-centered .wt-header__panel {
      justify-content: flex-end;
      margin-left: 0;
    }

    .wt-header--layout-centered .wt-header__menu-trigger {
      display: none;
    }

    /* Mega nav bar */
    .wt-header__mega-nav {
      display: block;
      background: var(--header-bg);
      border-top: 1px solid var(--header-border);
      position: relative;
    }

    .mega-menu {
      list-style: none;
      display: flex;
      justify-content: center;
      margin: 0;
      padding: 0;
    }

    .mega-menu__item {
      position: static;
    }

    .mega-menu__link {
      display: block;
      padding: 12px 25px;
      font-size: 13.5px;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      text-decoration: none;
      color: var(--header-text);
      transition: color 0.2s;
    }

    .mega-menu__link:hover {
      color: #555;
    }

    /* ---- DROPDOWN WRAPPER ---- */
    .mega-dropdown {
      position: absolute;
      left: 0;
      right: 0;
      top: 103%;
      background: #fff;
      border-bottom: 1px solid var(--header-border);
      box-shadow: 0 10px 30px rgba(0,0,0,0.08);
      padding: 36px 48px;
      visibility: hidden;
      opacity: 0;
      transform: translateY(8px);
      transition: opacity 0.28s ease, transform 0.28s ease, visibility 0.28s;
      z-index: 200;
      max-width: 85%;
      margin: 0 auto;
      border-radius: 20px;
    }

    .mega-menu__item:hover .mega-dropdown {
      visibility: visible;
      opacity: 1;
      transform: translateY(0);
    }

    /* ---- DROPDOWN INNER LAYOUT ----
       Single unified CSS grid for ALL cases.
       grid-template-columns is set via inline style in Liquid,
       computed as: nav_child_count + category_count + promo_count columns = 1fr each.
       This makes every column — nav, category-products, or promo image — exactly
       equal width across the full dropdown width.
    ---- */
    .mega-dropdown__grid {
      display: grid;
      gap: 24px;
      align-items: start;
      /* grid-template-columns injected inline per dropdown */
    }

    /* Nav column: text links */
    .mega-dropdown__column {
      min-width: 0; /* allow shrinking inside grid */
    }

    /* Subtle visual separator: first promo col gets a left border when nav/category cols precede it */
    .mega-promo-col--first {
      border-left: 1px solid var(--header-border);
      padding-left: 24px;
      margin-left: -12px; /* pull into the gap so border sits centred */
    }

    /* Nav column title */
    .mega-dropdown__column-title {
      font-weight: 700;
      margin-bottom: 14px;
      display: block;
      text-decoration: none;
      color: var(--header-text);
      font-size: 13px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
    }

    .mega-dropdown__link {
      text-decoration: none;
      color: #666;
      display: block;
      padding: 5px 0;
      font-size: 13px;
      transition: color 0.18s;
    }

    .mega-dropdown__link:hover {
      color: var(--header-text);
    }

    /* ---- CATEGORY MENU COLUMN (new) ----
       Same grid cell type as a nav column, but instead of plain text links it
       lists live products pulled from the block's assigned collection. ---- */
    .mega-category-col {
      min-width: 0;
    }

    .mega-category-col__products {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-top: 4px;
    }

    .mega-category-product {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 8px;
      border-radius: 10px;
      background: #f6f6f6;
      text-decoration: none;
      transition: background 0.2s ease, transform 0.2s ease;
    }

    .mega-category-product:hover {
      background: #ededed;
      transform: translateX(2px);
    }

    .mega-category-product__thumb {
      width: 44px;
      height: 44px;
      border-radius: 8px;
      overflow: hidden;
      flex-shrink: 0;
      background: #e6e6e6;
    }

    .mega-category-product__thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    .mega-category-product__info {
      display: flex;
      flex-direction: column;
      gap: 2px;
      min-width: 0;
    }

    .mega-category-product__title {
      font-size: 13px;
      font-weight: 600;
      color: var(--header-text);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .mega-category-product__price {
      font-size: 12.5px;
      color: #555;
      display: flex;
      gap: 6px;
      align-items: baseline;
    }

    .mega-category-product__compare {
      text-decoration: line-through;
      color: #999;
      font-weight: 400;
      font-size: 11.5px;
    }

    .mega-category-col__button {
      display: inline-block;
      margin-top: 12px;
      font-size: 12px;
      font-weight: 600;
      text-decoration: underline;
      text-underline-offset: 3px;
      color: var(--header-text);
    }

    /* ---- PROMO IMAGE COLUMN ---- */
    /* Each promo image sits directly as a grid column child — no wrapper */
    .mega-promo-col {
      min-width: 0;
    }

    .mega-promo-col__link {
      display: block;
      text-decoration: none;
      color: var(--header-text);
    }

    .mega-promo-col__picture {
      display: block;
      position: relative;
      overflow: hidden;
      border-radius: 4px;
      background: #f4f4f4;
      aspect-ratio: 3 / 4;
    }

    .mega-promo-col__img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.42s var(--transition-ease);
    }

    .mega-promo-col__link:hover .mega-promo-col__img {
      transform: scale(1.04);
    }

    .mega-promo-col__heading {
      display: block;
      margin-top: 9px;
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.02em;
      color: var(--header-text);
      line-height: 1.3;
    }

    .mega-promo-col__caption {
      display: block;
      margin-top: 3px;
      font-size: 12px;
      color: #888;
      line-height: 1.4;
    }

    .mega-promo-col__button {
      display: inline-block;
      margin-top: 12px;
      padding: 8px 18px;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      border: 1.5px solid var(--header-text);
      border-radius: 2px;
      color: var(--header-text);
      transition: background 0.25s ease, color 0.25s ease;
    }

    .mega-promo-col__link:hover .mega-promo-col__button {
      background: var(--header-text);
      color: #fff;
    }

    /* "Featured" label above first promo image */
    {% comment %} .mega-promo-col--first .mega-promo-col__link::before {
      content: '';
      display: block;
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: #aaa;
      margin-bottom: 10px;
    } {% endcomment %}
  }

  /* =============================================
     MEDIUM SCREENS (991px - 1280px) tweaks
  ============================================= */
  @media (min-width: 991px) and (max-width: 1280px) {
    .mega-dropdown {
      padding: 28px 32px;
    }

    .mega-dropdown__grid {
      gap: 16px;
    }

    .mega-menu__link {
      padding: 16px 18px;
      font-size: 12.5px;
    }

    .mega-category-product__thumb {
      width: 38px;
      height: 38px;
    }
  }

  /* =============================================
     MOBILE OVERRIDE
  ============================================= */
  @media (max-width: 990px) {
    .wt-header--layout-centered .wt-header__body {
      display: flex !important;
    }

    .wt-header--layout-centered .wt-header__logo-wrapper {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
    }

    .wt-header--layout-centered .wt-header__menu-trigger {
      display: flex !important;
    }

    .wt-header__mega-nav {
      display: none !important;
    }

    .wt-header__search-left-layout {
      display: none !important;
    }
  }

  /* =============================================
     SHARED / ORIGINAL STYLES
  ============================================= */
  .wt-header__menu-trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    cursor: pointer;
    border: none;
    background: none;
    flex-shrink: 0;
    color: var(--header-text);
    text-decoration: none;
    border-radius: 4px;
    transition: background 0.2s;
  }

  .wt-header__menu-trigger:hover {
    background: rgba(0,0,0,0.05);
  }

  .wt-header__menu-trigger svg {
    width: 22px;
    height: 22px;
  }

  .wt-header__logo-wrapper {
    position: absolute;
    left: 50%;
    top: 50%;
    transform: translate(-50%, -50%);
    display: flex;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    z-index: 1;
  }

  .wt-header__logo-wrapper > * {
    pointer-events: auto;
  }

  .wt-header__logo {
    margin: 0;
    line-height: 1;
  }

  .wt-header__logo__link {
    display: block;
    text-decoration: none;
    color: var(--header-text);
    font-family: var(--font-nav-family);
    font-size: 22px;
    letter-spacing: 0.08em;
    font-weight: 400;
  }

  .wt-header__logo__img {
    display: block;
    width: var(--logo-width-desk, 120px);
    height: auto;
    object-fit: contain;
  }

  .wt-header__logo__img--mobile {
    display: none;
  }

  @media (max-width: 990px) {
    .wt-header__logo__img { display: none; }
    .wt-header__logo__img--mobile {
      display: block;
      width: var(--logo-width-mobile, 90px);
    }
  }

  .wt-header__nav-teaser {
    display: none;
  }

  @media (min-width: 991px) {
    .wt-header__nav-teaser {
      display: flex;
      align-items: center;
      gap: 0;
      flex: 1;
    }
  }

  .wt-header__nav-teaser__list {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 4px;
  }

  .wt-header__nav-teaser__link {
    display: inline-block;
    padding: 8px 16px;
    {% comment %} font-family: var(--font-ui); {% endcomment %}
    font-family: var(--font-nav-family);
    font-size: 13.5px;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--header-text);
    text-decoration: none;
    position: relative;
    transition: color 0.2s;
  }

  .wt-header__nav-teaser__link::after {
    content: '';
    position: absolute;
    bottom: 4px;
    left: 16px;
    right: 16px;
    height: 1px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.28s var(--transition-ease);
  }

  .wt-header__nav-teaser__link:hover::after,
  .wt-header__nav-teaser__link--active::after {
    transform: scaleX(1);
  }

  .wt-header__panel {
    display: flex;
    align-items: center;
    list-style: none;
    gap: 4px;
    margin-left: auto;
    flex-shrink: 0;
  }

  .wt-header__panel__link {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 8px 10px;
    color: var(--header-text);
    text-decoration: none;
    font-size: 13px;
    border-radius: 4px;
    transition: background 0.2s;
    position: relative;
  }

  .wt-header__panel__link:hover {
    background: rgba(0,0,0,0.05);
  }

  .wt-header__panel__link svg {
    width: 20px;
    height: 20px;
  }

  .wt-header__panel__label { display: none; }

  .wt-header__panel__counter {
    position: absolute;
    top: 4px;
    right: 4px;
    min-width: 16px;
    height: 16px;
    background: var(--accent);
    color: #fff;
    font-size: 10px;
    font-weight: 600;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    line-height: 1;
  }

  .wt-header__search-trigger {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    cursor: pointer;
    border: none;
    background: none;
    color: var(--header-text);
    border-radius: 4px;
    transition: background 0.2s;
  }

  .wt-header__search-trigger:hover { background: rgba(0,0,0,0.05); }
  .wt-header__search-trigger svg { width: 20px; height: 20px; }
  .search-modal__content { left: 25%; }

  /* ---- OVERLAY ---- */
  .wt-drawer-overlay {
    display: none;
    position: fixed;
    inset: 0;
    background: var(--overlay-bg);
    z-index: 200;
    opacity: 0;
    transition: opacity var(--transition-speed) ease;
  }

  .wt-drawer-overlay.is-open {
    display: block;
    opacity: 1;
  }

  /* ---- SIDEBAR DRAWER ---- */
  .wt-drawer--nav {
    position: fixed;
    top: 0;
    left: 0;
    height: 100%;
    width: var(--sidebar-width);
    max-width: 100vw;
    background: #fff;
    z-index: 300;
    transform: translateX(-100%);
    transition: transform var(--transition-speed) var(--transition-ease);
    display: flex;
    flex-direction: column;
    overflow: hidden;
  }

  .wt-drawer--nav.is-open {
    transform: translateX(0);
  }

  @media (max-width: 990px) {
    .wt-drawer--nav { width: 100vw; }
  }

  .wt-drawer__title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px 28px 18px;
    border-bottom: 1px solid var(--header-border);
    flex-shrink: 0;
  }

  .wt-drawer__title__text {
    {% comment %} font-family: var(--font-ui); {% endcomment %}
    font-family: var(--font-nav-family);
    font-size: 15px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--header-text);
  }

  .wt-drawer__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    cursor: pointer;
    border: none;
    background: none;
    color: var(--header-text);
    border-radius: 4px;
    transition: background 0.2s;
    flex-shrink: 0;
  }

  .wt-drawer__close:hover { background: rgba(0,0,0,0.06); }
  .wt-drawer__close svg { width: 18px; height: 18px; }

  .wt-drawer__content {
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
  }

  .wt-drawer__nav-scroll {
    flex: 1;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 8px 0;
  }

  .wt-drawer__nav-scroll::-webkit-scrollbar { width: 4px; }
  .wt-drawer__nav-scroll::-webkit-scrollbar-track { background: transparent; }
  .wt-drawer__nav-scroll::-webkit-scrollbar-thumb { background: #ddd; border-radius: 2px; }

  /* ---- DRAWER NAV ITEMS ---- */
  .wt-nav__list { list-style: none; padding: 0; margin: 0; }
  .wt-nav__item { border-bottom: 1px solid var(--header-border); }
  .wt-nav__item:last-child { border-bottom: none; }

  .wt-nav__link-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 28px;
    min-height: 56px;
    cursor: pointer;
    text-decoration: none;
    color: var(--header-text);
    {% comment %} font-family: var(--font-ui); {% endcomment %}
    font-family: var(--font-nav-family);
    font-size: 15px;
    font-weight: 400;
    letter-spacing: 0.01em;
    transition: background 0.18s;
    user-select: none;
    -webkit-tap-highlight-color: transparent;
  }

  .wt-nav__link-row:hover { background: rgba(0,0,0,0.028); }
  .wt-nav__link-text { flex: 1; }

  .wt-nav__toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    flex-shrink: 0;
    border-radius: 4px;
    color: #888;
  }

  .wt-nav__toggle svg {
    width: 16px;
    height: 16px;
    transition: transform 0.28s var(--transition-ease);
  }

  .wt-nav__item.is-open > .wt-nav__link-row .wt-nav__toggle svg { transform: rotate(45deg); }

  .wt-nav__submenu {
    list-style: none;
    padding: 0;
    margin: 0;
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.38s var(--transition-ease);
    background: #fafafa;
  }

  .wt-nav__item.is-open > .wt-nav__submenu { max-height: 3000px; }

  .wt-nav__submenu-item { border-top: 1px solid #f0f0f0; }
  .wt-nav__submenu-item:first-child { border-top: 1px solid var(--header-border); }

  .wt-nav__submenu-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 28px 0 44px;
    min-height: 48px;
    {% comment %} font-family: var(--font-ui); {% endcomment %}
    font-family: var(--font-nav-family);
    font-size: 13.5px;
    font-weight: 400;
    color: #444;
    text-decoration: none;
    letter-spacing: 0.01em;
    transition: background 0.18s, color 0.18s;
  }

  .wt-nav__submenu-link:hover { background: rgba(0,0,0,0.035); color: var(--header-text); }

  .wt-nav__subsubmenu {
    list-style: none;
    padding: 0;
    margin: 0;
    overflow: hidden;
    max-height: 0;
    transition: max-height 0.32s var(--transition-ease);
    background: #f4f4f4;
  }

  .wt-nav__submenu-item.is-open > .wt-nav__subsubmenu { max-height: 1000px; }
  .wt-nav__submenu-item.is-open > .wt-nav__submenu-link .wt-nav__toggle svg { transform: rotate(45deg); }

  .wt-nav__subsubmenu-link {
    display: block;
    padding: 12px 28px 12px 60px;
    {% comment %} font-family: var(--font-ui); {% endcomment %}
    font-family: var(--font-nav-family);
    font-size: 13px;
    color: #666;
    text-decoration: none;
    border-top: 1px solid #ececec;
    transition: background 0.15s, color 0.15s;
  }

  .wt-nav__subsubmenu-link:hover { background: rgba(0,0,0,0.04); color: #222; }

  /* =============================================
     DRAWER PROMO GALLERY (Mobile / Sidebar)
  ============================================= */

  /* Promo section inside drawer */
  .wt-nav__promo-section {
    border-top: 1px solid var(--header-border);
    padding: 16px 20px 20px;
    background: #fafafa;
  }

  .wt-nav__promo-label {
    display: block;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #aaa;
    margin-bottom: 12px;
    padding: 0 8px;
  }

  /* Scroll horizontally on narrow screens, wrap on wider sidebar */
  .wt-nav__promo-gallery {
    list-style: none;
    display: flex;
    gap: 10px;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 4px;
  }

  .wt-nav__promo-gallery::-webkit-scrollbar { display: none; }

  .wt-nav__promo-gallery__item {
    flex: 0 0 130px; /* fixed width card, scrollable row */
  }
  .ak{
  height: 100%;
}
  .ak img{
    object-fit: cover;
    border-radius: 10px;
    height: 100%;
  }

  /* On wider sidebar (≥420px desktop drawer) allow wrapping */
  @media (min-width: 420px) {
    .ak-mob{
      padding: 10px;
    }
    .ak-mob img{
    border-radius: 10px;
  }
  wt-nav__subsubmenu{
    padding: 10px;
  }
    .wt-nav__promo-gallery {
      flex-wrap: wrap;
      overflow-x: visible;
    }

    .wt-nav__promo-gallery__item {
      flex: 1 1 calc(50% - 5px);
      max-width: calc(50% - 5px);
    }
  }

  .wt-nav__promo-gallery__link {
    display: block;
    text-decoration: none;
    color: var(--header-text);
  }

  .wt-nav__promo-gallery__picture {
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: 6px;
    background: #efefef;
    aspect-ratio: 3 / 4;
  }

  .wt-nav__promo-gallery__img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.35s ease;
  }

  .wt-nav__promo-gallery__link:active .wt-nav__promo-gallery__img {
    transform: scale(1.03);
  }

  .wt-nav__promo-gallery__heading {
    display: block;
    margin-top: 7px;
    font-size: 12px;
    font-weight: 600;
    color: var(--header-text);
    line-height: 1.3;
    padding: 0 2px;
  }

  .wt-nav__promo-gallery__caption {
    display: block;
    margin-top: 2px;
    font-size: 11px;
    color: #999;
    line-height: 1.3;
    padding: 0 2px;
  }

  .wt-nav__promo-gallery__button {
    display: inline-block;
    margin-top: 8px;
    margin-inline: 2px;
    padding: 6px 14px;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    border: 1.5px solid var(--header-text);
    border-radius: 2px;
    color: var(--header-text);
  }

  /* =============================================
     DRAWER CATEGORY PRODUCT LIST (new, mobile/sidebar)
  ============================================= */
  .wt-nav__category-label {
    display: block;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #999;
    background: #fafafa;
    border-top: 1px solid var(--header-border);
    padding: 16px 20px 8px !important;
  }

  /* Each category row reuses the existing .wt-nav__submenu-item /
     .wt-nav__subsubmenu collapse mechanics (max-height transition + icon
     rotate) already defined above — only the product-card content styling
     is new here. */
  .wt-nav__category-accordion-group {
    background: #fafafa;
  }

  .wt-nav__category-products {
    list-style: none;
    margin: 0;
    {% comment %} padding: 8px 20px 16px 44px; {% endcomment %}
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .wt-nav__category-product {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px;
    border-radius: 8px;
    background: #f6f6f6;
    text-decoration: none;
  }

  .wt-nav__category-product__thumb {
    width: 40px;
    height: 40px;
    border-radius: 6px;
    overflow: hidden;
    flex-shrink: 0;
    background: #eee;
  }

  .wt-nav__category-product__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .wt-nav__category-product__info {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .wt-nav__category-product__title {
    font-size: 13px;
    font-weight: 500;
    color: var(--header-text);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .wt-nav__category-product__price {
    font-size: 12px;
    color: #666;
    display: flex;
    gap: 6px;
  }

  .wt-nav__category-product__price s {
    color: #aaa;
  }

  .wt-icon { display: inline-flex; align-items: center; justify-content: center; }

  @media (max-width: 990px) {
    .wt-header__body { padding: 0 16px; }
  }
</style>

<div class="wt-drawer-overlay" id="wt-drawer-overlay" aria-hidden="true"></div>

<header
  id="shopify-section-{{ section.id }}"
  class="wt-header wt-header--layout-{{ section.settings.header_layout }}{% if section.settings.sticky_header %} wt-header--sticky{% endif %}{% if section.settings.show_shadow %} wt-header--shadow{% endif %}{% if section.settings.show_line_separator %} wt-header--separator{% endif %}"
  role="banner"
>
  <div class="wt-header__body">

    <div class="wt-header__left-section-logic">
      <a href="#" class="wt-header__menu-trigger wt-icon" id="wt-menu-trigger">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </a>

      {% if section.settings.header_layout == 'sidebar' %}
        {%- if section.settings.teaser_menu != blank -%}
          <nav class="wt-header__nav-teaser" aria-label="Teaser navigation">
            <ul class="wt-header__nav-teaser__list">
              {%- for link in section.settings.teaser_menu.links -%}
                {% if forloop.index <= 3 %}
                  <li class="wt-header__nav-teaser__item">
                    <a href="{{ link.url | default: '#' }}" class="wt-header__nav-teaser__link{% if link.current %} wt-header__nav-teaser__link--active{% endif %}">
                      {{- link.title | escape -}}
                    </a>
                  </li>
                {% endif %}
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
      {% else %}
        <div class="wt-header__search-left-layout">
          {%- render 'search', style: search_style, display_style: 'icon' -%}
        </div>
      {% endif %}
    </div>

    <div class="wt-header__logo-wrapper">
      {%- if request.page_type == 'index' -%}
        <h1 itemscope itemtype="http://schema.org/Organization" class="wt-header__logo">
      {%- else -%}
        <div itemscope itemtype="http://schema.org/Organization" class="wt-header__logo">
      {%- endif -%}
        <a href="{{ routes.root_url }}" class="wt-header__logo__link">
          {%- if section.settings.logo != blank -%}
            {%- assign large_size = section.settings.large_screen_logo_width -%}
            <img srcset="{{ section.settings.logo | image_url: width: large_size }} 1x" src="{{ section.settings.logo | image_url: width: large_size }}" class="wt-header__logo__img" alt="{{ shop.name }}">
            <img src="{{ section.settings.logo | image_url: width: section.settings.mobile_screen_logo_width }}" class="wt-header__logo__img wt-header__logo__img--mobile" alt="{{ shop.name }}">
          {%- else -%}
            {{ shop.name }}
          {%- endif -%}
        </a>
      {%- if request.page_type == 'index' -%}</h1>{%- else -%}</div>{%- endif -%}
    </div>

    <ul class="wt-header__panel" role="list">
      {%- if section.settings.header_layout == 'sidebar' and search_style != 'none' -%}
        <li class="wt-header__panel__item">
          {%- render 'search', style: search_style, display_style: 'icon' -%}
        </li>
      {%- endif -%}

      {%- if shop.customer_accounts_enabled -%}
        <li class="wt-header__panel__item">
          <a href="{{ routes.account_url }}" class="wt-header__panel__link wt-icon">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
              <circle cx="12" cy="8" r="4"/><path stroke-linecap="round" d="M4 20c0-4 3.6-7 8-7s8 3 8 7"/>
            </svg>
          </a>
        </li>
      {%- endif -%}

      <li class="wt-header__panel__item">
        <a href="{{ routes.cart_url }}" class="wt-header__panel__link wt-icon" id="cart-icon-bubble">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.75">
            <path stroke-linecap="round" d="M6 2L3 6v14a2 2 0 002 2h14a2 2 0 002-2V6l-3-4z"/><path stroke-linecap="round" d="M3 6h18M16 10a4 4 0 01-8 0"/>
          </svg>
          {%- if cart.item_count != 0 -%}<span class="wt-header__panel__counter">{{ cart.item_count }}</span>{%- endif -%}
        </a>
      </li>
    </ul>
  </div>

  {%- comment -%}
    ============================================================
    LAYOUT B: CENTERED MEGA NAV (Desktop only)

    KEY LAYOUT LOGIC — single unified CSS grid:
    • Count nav child columns     (child_count)
    • Count category product cols (category_count) — NEW
    • Count promo image columns   (promo_count)
    • total_cols = child_count + category_count + promo_count
    • grid-template-columns: repeat(total_cols, 1fr)
    • All nav columns, category columns, AND promo image columns are direct
      grid children → every column is exactly equal width, spanning full
      dropdown width.

    Edge cases:
      1. Only promo, no sub-links/categories → promo images fill width equally
      2. Sub-links + categories + promo       → nav cols, then category cols,
                                                 then promo cols, all equal grid
      3. Only sub-links, no promo/categories   → nav cols fill width equally
      4. Only categories (the new case)        → category cols fill width
                                                 equally, matching the reference
                                                 "AudioSphere Series / FitSmart
                                                 Line" two-column product layout
    ============================================================
  {%- endcomment -%}
  {% if section.settings.header_layout == 'centered' %}
    <nav class="wt-header__mega-nav" aria-label="Main navigation">
      <ul class="mega-menu">
        {%- for link in section.settings.menu.links -%}

          {%- liquid
            assign mega_block    = nil
            assign has_promo     = false
            assign promo_count   = 0

            if section.blocks.size > 0
              for block in section.blocks
                assign trigger_handle = block.settings.title | handle | strip
                if link.handle == trigger_handle and block.type == 'promo_column'
                  assign mega_block = block
                  for i in (1..6)
                    assign img_key = 'desktop_image_' | append: i
                    if block.settings[img_key]
                      assign has_promo = true
                      assign promo_count = promo_count | plus: 1
                    endif
                  endfor
                  break
                endif
              endfor
            endif

            # NEW: count Category Menu Blocks attached to this link. Unlike
            # promo_column (single block per link, matched above), multiple
            # category_menu blocks can attach to the same link — e.g. the
            # reference design's "AudioSphere Series" + "FitSmart Line"
            # side-by-side product columns — so this only counts; each
            # matching block is rendered directly in the loop further down.
            # NEW: count total categories attached to this link. A single
            # category_menu block now holds a *list* of collections (at
            # least 2, per the reference "AudioSphere Series" + "FitSmart
            # Line" columns), so this sums every collection across every
            # matching block — each collection becomes its own column.
            assign category_count = 0
            if section.blocks.size > 0
              for block in section.blocks
                assign trigger_handle = block.settings.title | handle | strip
                if link.handle == trigger_handle and block.type == 'category_menu'
                  assign category_count = category_count | plus: block.settings.collections.size
                endif
              endfor
            endif
            assign has_category = false
            if category_count > 0
              assign has_category = true
            endif

            assign has_children = false
            assign child_count  = 0
            if link.links != blank
              assign has_children = true
              assign child_count  = link.links.size
            endif

            assign total_cols = child_count | plus: category_count | plus: promo_count

            assign has_preceding_columns = false
            if has_children
              assign has_preceding_columns = true
            endif
            if has_category
              assign has_preceding_columns = true
            endif
          -%}

          <li class="mega-menu__item">
            <a href="{{ link.url }}" class="mega-menu__link{% if link.current %} mega-menu__link--active{% endif %}">
              {{ link.title | escape }}
            </a>

            {%- if has_children or has_category or has_promo -%}
              <div class="mega-dropdown">
                <div
                  class="mega-dropdown__grid"
                  style="grid-template-columns: repeat(4, 1fr);"
                >

                  {%- comment %} ---- NAV COLUMNS — each child is a direct grid cell ---- {%- endcomment -%}
                  {%- if has_children -%}
                    {%- for child_link in link.links -%}
                      <div class="mega-dropdown__column">
                        <a href="{{ child_link.url }}" class="mega-dropdown__column-title">{{ child_link.title | escape }}</a>
                        {%- if child_link.links != blank -%}
                          <ul class="mega-dropdown__list">
                            {%- for grandchild in child_link.links -%}
                              <li><a href="{{ grandchild.url }}" class="mega-dropdown__link">{{ grandchild.title | escape }}</a></li>
                            {%- endfor -%}
                          </ul>
                        {%- endif -%}
                      </div>
                    {%- endfor -%}
                  {%- endif -%}

                  {%- comment %} ---- CATEGORY MENU COLUMNS (new) — each collection inside a
                       matching category_menu block's collection list gets its own grid
                       cell listing live products from that collection ---- {%- endcomment -%}
                  {%- if has_category -%}
                    {%- for cat_block in section.blocks -%}
                      {%- assign cat_trigger_handle = cat_block.settings.title | handle | strip -%}
                      {%- if cat_block.type == 'category_menu' and link.handle == cat_trigger_handle -%}
                        {%- for cat_collection in cat_block.settings.collections -%}
                          <div class="mega-dropdown__column mega-category-col">
                            <span class="mega-dropdown__column-title">{{ cat_collection.title }}</span>
                            <div class="mega-category-col__products">
                              {%- for product in cat_collection.products limit: cat_block.settings.product_count -%}
                                <a href="{{ product.url }}" class="mega-category-product">
                                  <span class="mega-category-product__thumb">
                                    {%- if product.featured_image -%}
                                      <img
                                        src="{{ product.featured_image | image_url: width: 100 }}"
                                        alt="{{ product.featured_image.alt | default: product.title | escape }}"
                                        loading="lazy"
                                        width="44"
                                        height="44"
                                      >
                                    {%- elsif cat_block.settings.category_image -%}
                                      <img
                                        src="{{ cat_block.settings.category_image | image_url: width: 100 }}"
                                        alt=""
                                        loading="lazy"
                                        width="44"
                                        height="44"
                                      >
                                    {%- endif -%}
                                  </span>
                                  <span class="mega-category-product__info">
                                    {%- if cat_block.settings.show_product_title -%}
                                      <span class="mega-category-product__title">{{ product.title | escape }}</span>
                                    {%- endif -%}
                                    {%- if cat_block.settings.show_price -%}
                                      <span class="mega-category-product__price">
                                        {{ product.price | money }}
                                        {%- if product.compare_at_price > product.price -%}
                                          <s class="mega-category-product__compare">{{ product.compare_at_price | money }}</s>
                                        {%- endif -%}
                                      </span>
                                    {%- endif -%}
                                  </span>
                                </a>
                              {%- endfor -%}
                            </div>
                          </div>
                        {%- endfor -%}
                        
                        <!--This is a testing line -->
                        {% if cat_block.settings.desktop_image_1 != blank %}
                          <div class="ak">
                            <img
                              src="{{ cat_block.settings.desktop_image_1 | image_url: width: 800 }}"
                              alt="{{ cat_block.settings.desktop_image_1.alt | escape }}"
                              width="{{ cat_block.settings.desktop_image_1.width }}"
                              height="{{ cat_block.settings.desktop_image_1.height }}"
                              loading="lazy"
                            >
                          </div>
                        {% endif %}
                      
                        {% if cat_block.settings.desktop_image_2 != blank %}
                          <div class="ak">
                            <img
                              src="{{ cat_block.settings.desktop_image_2 | image_url: width: 800 }}"
                              alt="{{ cat_block.settings.desktop_image_2.alt | escape }}"
                              width="{{ cat_block.settings.desktop_image_2.width }}"
                              height="{{ cat_block.settings.desktop_image_2.height }}"
                              loading="lazy"
                            >
                            </div>
                        {% endif %}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}

                  {%- comment %} ---- PROMO IMAGE COLUMNS — each image is a direct grid cell ---- {%- endcomment -%}
                  {%- if has_promo -%}
                    {%- assign promo_loop_index = 0 -%}
                    {%- for i in (1..6) -%}
                      {%- assign img_key     = 'desktop_image_' | append: i -%}
                      {%- assign link_key    = 'link_'           | append: i -%}
                      {%- assign heading_key = 'heading_'        | append: i -%}
                      {%- assign text_key    = 'text_'           | append: i -%}
                      {%- if mega_block.settings[img_key] -%}
                        {%- assign promo_img = mega_block.settings[img_key] -%}
                        {%- assign is_first_promo = false -%}
                        {%- if promo_loop_index == 0 and has_preceding_columns -%}
                          {%- assign is_first_promo = true -%}
                        {%- endif -%}
                        <div class="mega-promo-col{% if is_first_promo %} mega-promo-col--first{% endif %}">
                          <a
                            href="{{ mega_block.settings[link_key] | default: '#' }}"
                            class="mega-promo-col__link"
                          >
                            <span class="mega-promo-col__picture">
                              <img
                                class="mega-promo-col__img"
                                srcset="
                                  {%- if promo_img.width >= 400 -%}{{ promo_img | image_url: width: 400 }} 400w,{%- endif -%}
                                  {%- if promo_img.width >= 800 -%}{{ promo_img | image_url: width: 800 }} 800w,{%- endif -%}
                                  {%- if promo_img.width >= 1200 -%}{{ promo_img | image_url: width: 1200 }} 1200w{%- endif -%}
                                "
                                sizes="(min-width: 1200px) 220px, (min-width: 991px) 160px, 130px"
                                src="{{ promo_img | image_url: width: 400 }}"
                                alt="{{ promo_img.alt | default: mega_block.settings[heading_key] | escape }}"
                                loading="lazy"
                                width="{{ promo_img.width }}"
                                height="{{ promo_img.height }}"
                              >
                            </span>
                            {%- if mega_block.settings[heading_key] != blank -%}
                              <span class="mega-promo-col__heading">{{ mega_block.settings[heading_key] }}</span>
                            {%- endif -%}
                            {%- if mega_block.settings[text_key] != blank -%}
                              <p class="mega-promo-col__caption">{{ mega_block.settings[text_key] }}</p>
                            {%- endif -%}
                            {%- assign button_text_key = 'button_text_' | append: i -%}
                            {%- if mega_block.settings[button_text_key] != blank -%}
                              <span class="mega-promo-col__button">{{ mega_block.settings[button_text_key] }}</span>
                            {%- endif -%}
                          </a>
                        </div>
                        {%- assign promo_loop_index = promo_loop_index | plus: 1 -%}
                      {%- endif -%}
                    {%- endfor -%}
                  {%- endif -%}

                </div>
              </div>
            {%- endif -%}
          </li>

        {%- endfor -%}
      </ul>
    </nav>
  {% endif %}

</header>

{%- comment -%}
  ============================================================
  SIDEBAR DRAWER
  Used for: mobile (both layouts) + desktop Layout A
  Promo images and category product lists rendered inside the expandable
  submenu section.
  ============================================================
{%- endcomment -%}
<aside class="wt-drawer--nav" id="wt-drawer-nav" aria-label="Site navigation" aria-hidden="true" role="dialog">
  <div class="wt-drawer__content">
    <div class="wt-drawer__title">
      <span class="wt-drawer__title__text">{{ section.settings.drawer_title | default: 'Shop by' }}</span>
      <button class="wt-drawer__close wt-icon" id="wt-drawer-close">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>

    <div class="wt-drawer__nav-scroll">
      {%- if section.settings.menu != blank -%}
        <ul class="wt-nav__list" role="list">
          {%- for link in section.settings.menu.links -%}

            {%- liquid
              assign drawer_mega_block = nil
              assign drawer_has_promo = false
              assign drawer_promo_count = 0

              if section.blocks.size > 0
                for block in section.blocks
                  assign trigger_handle = block.settings.title | handle | strip
                  if link.handle == trigger_handle and block.type == 'promo_column'
                    assign drawer_mega_block = block
                    for i in (1..6)
                      assign img_key = 'desktop_image_' | append: i
                      if block.settings[img_key]
                        assign drawer_has_promo = true
                        assign drawer_promo_count = drawer_promo_count | plus: 1
                      endif
                    endfor
                    break
                  endif
                endfor
              endif

              # NEW: count categories for the drawer (same matching rule as
              # desktop — one block can hold a list of 2+ collections).
              assign drawer_category_count = 0
              if section.blocks.size > 0
                for block in section.blocks
                  assign trigger_handle = block.settings.title | handle | strip
                  if link.handle == trigger_handle and block.type == 'category_menu'
                    assign drawer_category_count = drawer_category_count | plus: block.settings.collections.size
                  endif
                endfor
              endif
              assign drawer_has_category = false
              if drawer_category_count > 0
                assign drawer_has_category = true
              endif

              assign drawer_has_children = false
              if link.links != blank
                assign drawer_has_children = true
              endif
            -%}

            <li class="wt-nav__item{% if drawer_has_children or drawer_has_category or drawer_has_promo %} wt-nav__item--has-children{% endif %}" data-level="1">

              {%- if drawer_has_children or drawer_has_category or drawer_has_promo -%}
                <div class="wt-nav__link-row" role="button" tabindex="0" data-toggle="submenu">
                  <a href="{{ link.url | default: '#' }}" class="wt-nav__link-text" tabindex="-1">{{- link.title | escape -}}</a>
                  <span class="wt-nav__toggle" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M12 5v14M5 12h14"/>
                    </svg>
                  </span>
                </div>

                <ul class="wt-nav__submenu" role="list">

                  {%- comment %} Regular child links {%- endcomment -%}
                  {%- if drawer_has_children -%}
                    {%- for child_link in link.links -%}
                      <li class="wt-nav__submenu-item{% if child_link.links != blank %} wt-nav__item--has-children{% endif %}">
                        {%- if child_link.links != blank -%}
                          <div class="wt-nav__submenu-link" role="button" tabindex="0" data-toggle="submenu">
                            <a href="{{ child_link.url | default: '#' }}" class="wt-nav__link-text">{{- child_link.title | escape -}}</a>
                            <span class="wt-nav__toggle">
                              <svg viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path d="M12 5v14M5 12h14"/>
                              </svg>
                            </span>
                          </div>
                          <ul class="wt-nav__subsubmenu" role="list">
                            {%- for grandchild_link in child_link.links -%}
                              <li>
                                <a href="{{ grandchild_link.url }}" class="wt-nav__subsubmenu-link">{{ grandchild_link.title | escape }}</a>
                              </li>
                            {%- endfor -%}
                          </ul>
                        {%- else -%}
                          <a href="{{ child_link.url }}" class="wt-nav__submenu-link">{{ child_link.title | escape }}</a>
                        {%- endif -%}
                      </li>
                    {%- endfor -%}
                  {%- endif -%}

                  {%- comment %} Category accordions inside drawer (new): each selected
                       collection becomes its own tap-to-expand row. Wrapped in a
                       single <ul data-category-accordion-group> so the JS below can
                       enforce "only one open at a time" scoped to just these rows,
                       without touching the existing general submenu toggle behavior
                       used elsewhere. {%- endcomment -%}
                  {%- if drawer_has_category -%}
                    <li class="wt-nav__submenu-item" style="padding: 0; border-top: none;">
                      <span class="wt-nav__category-label" style="padding: 16px 20px 4px;">Shop by category</span>
                      <ul class="wt-nav__category-accordion-group" data-category-accordion-group role="list">
                        {%- for cat_block in section.blocks -%}
                          {%- assign cat_trigger_handle = cat_block.settings.title | handle | strip -%}
                          {%- if cat_block.type == 'category_menu' and link.handle == cat_trigger_handle -%}
                            {%- for d_cat_collection in cat_block.settings.collections -%}
                              <li class="wt-nav__submenu-item wt-nav__category-accordion-item">
                                <div class="wt-nav__submenu-link" role="button" tabindex="0" data-toggle="submenu">
                                  <span class="wt-nav__link-text">{{ d_cat_collection.title }}</span>
                                  <span class="wt-nav__toggle" aria-hidden="true">
                                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                      <path d="M12 5v14M5 12h14"/>
                                    </svg>
                                  </span>
                                </div>
                                <ul class="wt-nav__subsubmenu wt-nav__category-products" role="list">
                                  {%- for product in d_cat_collection.products limit: cat_block.settings.product_count -%}
                                    <li>
                                      <a href="{{ product.url }}" class="wt-nav__category-product">
                                        <span class="wt-nav__category-product__thumb">
                                          {%- if product.featured_image -%}
                                            <img
                                              src="{{ product.featured_image | image_url: width: 100 }}"
                                              alt="{{ product.featured_image.alt | default: product.title | escape }}"
                                              loading="lazy"
                                              width="40"
                                              height="40"
                                            >
                                          {%- elsif cat_block.settings.category_image -%}
                                            <img
                                              src="{{ cat_block.settings.category_image | image_url: width: 100 }}"
                                              alt=""
                                              loading="lazy"
                                              width="40"
                                              height="40"
                                            >
                                          {%- endif -%}
                                        </span>
                                        <span class="wt-nav__category-product__info">
                                          {%- if cat_block.settings.show_product_title -%}
                                            <span class="wt-nav__category-product__title">{{ product.title | escape }}</span>
                                          {%- endif -%}
                                          {%- if cat_block.settings.show_price -%}
                                            <span class="wt-nav__category-product__price">
                                              {{ product.price | money }}
                                              {%- if product.compare_at_price > product.price -%}
                                                <s>{{ product.compare_at_price | money }}</s>
                                              {%- endif -%}
                                            </span>
                                          {%- endif -%}
                                        </span>
                                      </a>
                                    </li>
                                  {%- endfor -%}
                                </ul>
                              </li>
                            {%- endfor -%}

                            {% if cat_block.settings.desktop_image_1 != blank %}
                              <div class="ak-mob">
                                <img
                                  src="{{ cat_block.settings.desktop_image_1 | image_url: width: 800 }}"
                                  alt="{{ cat_block.settings.desktop_image_1.alt | escape }}"
                                  width="{{ cat_block.settings.desktop_image_1.width }}"
                                  height="{{ cat_block.settings.desktop_image_1.height }}"
                                  loading="lazy"
                                >
                              </div>
                            {% endif %}
                          
                            {% if cat_block.settings.desktop_image_2 != blank %}
                              <div class="ak-mob">
                                <img
                                  src="{{ cat_block.settings.desktop_image_2 | image_url: width: 800 }}"
                                  alt="{{ cat_block.settings.desktop_image_2.alt | escape }}"
                                  width="{{ cat_block.settings.desktop_image_2.width }}"
                                  height="{{ cat_block.settings.desktop_image_2.height }}"
                                  loading="lazy"
                                >
                                </div>
                            {% endif %}
                            {% comment %} Test {% endcomment %}
                          {%- endif -%}
                        {%- endfor -%}
                      </ul>
                    </li>
                  {%- endif -%}

                  {%- comment %} Promo gallery inside drawer {%- endcomment -%}
                  {%- if drawer_has_promo -%}
                    <li class="wt-nav__submenu-item" style="padding: 0; border-top: none;">
                      <div class="wt-nav__promo-section">
                        <span class="wt-nav__promo-label">Featured</span>
                        <ul class="wt-nav__promo-gallery">
                          {%- for i in (1..6) -%}
                            {%- assign img_key     = 'desktop_image_' | append: i -%}
                            {%- assign link_key    = 'link_'           | append: i -%}
                            {%- assign heading_key = 'heading_'        | append: i -%}
                            {%- assign text_key    = 'text_'           | append: i -%}
                            {%- if drawer_mega_block.settings[img_key] -%}
                              {%- assign d_img = drawer_mega_block.settings[img_key] -%}
                              <li class="wt-nav__promo-gallery__item">
                                <a
                                  href="{{ drawer_mega_block.settings[link_key] | default: '#' }}"
                                  class="wt-nav__promo-gallery__link"
                                >
                                  <span class="wt-nav__promo-gallery__picture">
                                    <img
                                      class="wt-nav__promo-gallery__img"
                                      src="{{ d_img | image_url: width: 300 }}"
                                      srcset="{{ d_img | image_url: width: 200 }} 200w, {{ d_img | image_url: width: 300 }} 300w"
                                      sizes="130px"
                                      alt="{{ d_img.alt | default: drawer_mega_block.settings[heading_key] | escape }}"
                                      loading="lazy"
                                      width="{{ d_img.width }}"
                                      height="{{ d_img.height }}"
                                    >
                                  </span>
                                  {%- if drawer_mega_block.settings[heading_key] != blank -%}
                                    <span class="wt-nav__promo-gallery__heading">{{ drawer_mega_block.settings[heading_key] }}</span>
                                  {%- endif -%}
                                  {%- if drawer_mega_block.settings[text_key] != blank -%}
                                    <p class="wt-nav__promo-gallery__caption">{{ drawer_mega_block.settings[text_key] }}</p>
                                  {%- endif -%}
                                  {%- assign d_button_text_key = 'button_text_' | append: i -%}
                                  {%- if drawer_mega_block.settings[d_button_text_key] != blank -%}
                                    <span class="wt-nav__promo-gallery__button">{{ drawer_mega_block.settings[d_button_text_key] }}</span>
                                  {%- endif -%}
                                </a>
                              </li>
                            {%- endif -%}
                          {%- endfor -%}
                        </ul>
                      </div>
                    </li>
                  {%- endif -%}

                </ul>

              {%- else -%}
                <a href="{{ link.url }}" class="wt-nav__link-row">
                  <span class="wt-nav__link-text">{{- link.title | escape -}}</span>
                </a>
              {%- endif -%}

            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</aside>

<script>
(function () {
  'use strict';

  const trigger   = document.getElementById('wt-menu-trigger');
  const drawer    = document.getElementById('wt-drawer-nav');
  const overlay   = document.getElementById('wt-drawer-overlay');
  const closeBtn  = document.getElementById('wt-drawer-close');

  if (!trigger || !drawer || !overlay) return;

  function openDrawer() {
    drawer.classList.add('is-open');
    drawer.setAttribute('aria-hidden', 'false');
    overlay.classList.add('is-open');
    document.body.style.overflow = 'hidden';
  }

  function closeDrawer() {
    drawer.classList.remove('is-open');
    drawer.setAttribute('aria-hidden', 'true');
    overlay.classList.remove('is-open');
    document.body.style.overflow = '';
  }

  trigger.addEventListener('click', function (e) { e.preventDefault(); openDrawer(); });
  if (closeBtn) closeBtn.addEventListener('click', closeDrawer);
  overlay.addEventListener('click', closeDrawer);

  document.addEventListener('keydown', function (e) {
    if (e.key === 'Escape') closeDrawer();
  });

  /* Accordion toggles — works for all levels */
  function toggleAccordionItem(parentItem) {
    if (!parentItem) return;

    // Category accordion rows (the new per-collection product lists) close
    // their siblings first, so only one is ever open at a time — scoped to
    // just their own group, so this never touches the existing general
    // submenu behavior used everywhere else in the drawer.
    if (parentItem.classList.contains('wt-nav__category-accordion-item')) {
      var wasOpen = parentItem.classList.contains('is-open');
      var group = parentItem.closest('[data-category-accordion-group]');
      if (group) {
        group.querySelectorAll('.wt-nav__category-accordion-item.is-open').forEach(function (openItem) {
          if (openItem !== parentItem) openItem.classList.remove('is-open');
        });
      }
      parentItem.classList.toggle('is-open', !wasOpen);
      return;
    }

    parentItem.classList.toggle('is-open');
  }

  document.querySelectorAll('[data-toggle="submenu"]').forEach(function (row) {
    row.addEventListener('click', function (e) {
      /* Allow actual link clicks through */
      var target = e.target.closest('a');
      if (target && target.getAttribute('href') && !target.getAttribute('href').startsWith('#')) return;
      e.preventDefault();
      toggleAccordionItem(row.closest('.wt-nav__item, .wt-nav__submenu-item'));
    });

    row.addEventListener('keydown', function (e) {
      if (e.key === 'Enter' || e.key === ' ') {
        e.preventDefault();
        toggleAccordionItem(row.closest('.wt-nav__item, .wt-nav__submenu-item'));
      }
    });
  });

  /* ------------------------------------------------------------------
     Live cart count.
    
     ------------------------------------------------------------------ */
  var cartLink = document.getElementById('cart-icon-bubble');

  function updateCartCount() {
    if (!cartLink) return;
    fetch('/cart.js')
      .then(function (res) { return res.json(); })
      .then(function (cart) {
        var counter = cartLink.querySelector('.wt-header__panel__counter');
        if (cart.item_count > 0) {
          if (!counter) {
            counter = document.createElement('span');
            counter.className = 'wt-header__panel__counter';
            cartLink.appendChild(counter);
          }
          counter.textContent = cart.item_count;
        } else if (counter) {
          counter.remove();
        }
      })
      .catch(function (err) {
        console.error('Cart count update failed', err);
      });
  }

  // Still supported, in case any code on the site dispatches it directly.
  document.addEventListener('cart:updated', updateCartCount);

  // Catch every cart mutation regardless of source: wrap fetch once,
  // globally, and check the request URL for Shopify's cart AJAX endpoints.
  if (window.fetch && !window.__wtCartFetchPatched) {
    window.__wtCartFetchPatched = true;
    var originalFetch = window.fetch;
    window.fetch = function (input, init) {
      var request = originalFetch.apply(this, arguments);
      var url = (input && input.url) ? input.url : input;
      if (typeof url === 'string' && /\/cart\/(add|update|change|clear)(\.js)?(\?|$)/.test(url)) {
        request.then(function (response) {
          if (response && response.ok) {
            updateCartCount();
            document.dispatchEvent(new CustomEvent('cart:updated'));
          }
        }).catch(function () { /* ignore — original request's own error handling still runs */ });
      }
      return request;
    };
  }

  // Belt-and-braces: some older cart integrations still use a plain HTML
  // form POST to /cart/add (not fetch). If it's a normal (non-AJAX)
  // submission, the browser navigates and reloads anyway, refreshing the
  // count naturally — nothing extra needed for that case.

  // Also refresh on bfcache restores (e.g. hitting Back after adding to
  // cart on a previous page), since that skips a fresh server render.
  window.addEventListener('pageshow', function (e) {
    if (e.persisted) updateCartCount();
  });
})();
</script>

