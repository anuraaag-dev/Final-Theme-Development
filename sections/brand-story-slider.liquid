    {
      "type": "image_picker",
      "id": "image_back",
      "label": "Back image"
    },
    {
      "type": "image_picker",
      "id": "image_front",
      "label": "Front image"
    },
    {
      "type": "header",
      "content": "Photo Card Style"
    },
    {
