{%- comment -%}
============================================================================
  BRAND STORY SLIDER (tilted overlapping photo cards + text)
  Two overlapping, oppositely-tilted "photo card" images on one side and
  an eyebrow/heading/body text block with prev/next navigation on the
  other. Arrows cycle through full slides (each slide = its own image
  pair + its own text) via repeatable blocks.

  Desktop: images left, text right, side by side.
  Mobile: images stack above, text stacks below (explicit requirement).

  Built with Liquid, HTML, CSS and vanilla JavaScript only — no external
  libraries. Single self-contained file, Shopify Online Store 2.0
  compatible.
============================================================================
{%- endcomment -%}

{%- liquid
  assign s = section.settings
  assign sec_id = section.id
  assign slide_blocks = section.blocks | where: 'type', 'slide'
  assign slide_count = slide_blocks.size
-%}

<section
  id="BrandStory-{{ sec_id }}"
  class="bst"
  data-brand-story
>
  <div class="bst__inner">
    <div class="bst__grid">

      <!-- ===================== IMAGE COLLAGE (fixed — does not change when navigating) ===================== -->
      <div class="bst__images" data-bst-images-wrap>
        <div class="bst__image-pair">
          <div class="bst__card bst__card--back">
            {%- if s.image_back != blank -%}
              <img
                src="{{ s.image_back | image_url: width: 700 }}"
                srcset="{{ s.image_back | image_url: width: 400 }} 400w, {{ s.image_back | image_url: width: 700 }} 700w"
                sizes="(min-width: 990px) 25vw, 45vw"
                alt="{{ s.image_back.alt | escape }}"
                loading="lazy"
                width="{{ s.image_back.width }}"
                height="{{ s.image_back.height }}"
              >
            {%- else -%}
              {{ 'lifestyle-1' | placeholder_svg_tag: 'bst__placeholder-svg' }}
            {%- endif -%}
          </div>
          <div class="bst__card bst__card--front">
            {%- if s.image_front != blank -%}
              <img
                src="{{ s.image_front | image_url: width: 800 }}"
                srcset="{{ s.image_front | image_url: width: 500 }} 500w, {{ s.image_front | image_url: width: 800 }} 800w"
                sizes="(min-width: 990px) 28vw, 55vw"
                alt="{{ s.image_front.alt | escape }}"
                loading="lazy"
                width="{{ s.image_front.width }}"
                height="{{ s.image_front.height }}"
              >
            {%- else -%}
              {{ 'lifestyle-2' | placeholder_svg_tag: 'bst__placeholder-svg' }}
            {%- endif -%}
          </div>
        </div>
      </div>

      <!-- ===================== TEXT CONTENT (slides between blocks) ===================== -->
      <div class="bst__content">
        <div class="bst__text-viewport" data-bst-viewport>
          <div class="bst__text-track" data-bst-track>
            {%- for block in section.blocks -%}
              {%- if block.type == 'slide' -%}
                {%- assign bs = block.settings -%}
                <div class="bst__text" data-bst-slide-text {{ block.shopify_attributes }}>
                  {%- if bs.eyebrow != blank -%}
                    <span class="bst__eyebrow">{{ bs.eyebrow }}</span>
                  {%- endif -%}
                  {%- if bs.heading != blank -%}
                    <h2 class="bst__heading">{{ bs.heading }}</h2>
                  {%- endif -%}
                  {%- if bs.body != blank -%}
                    <div class="bst__body">{{ bs.body }}</div>
                  {%- endif -%}
                  {%- if bs.button_text != blank and bs.button_link != blank -%}
                    <a href="{{ bs.button_link }}" class="bst__button">{{ bs.button_text }}</a>
                  {%- endif -%}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>

        {%- if slide_count > 1 -%}
          <div class="bst__nav" data-bst-nav>
            <button type="button" class="bst__nav-btn bst__nav-btn--prev" data-bst-prev aria-label="Previous story">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <button type="button" class="bst__nav-btn bst__nav-btn--next" data-bst-next aria-label="Next story">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
          </div>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

<style>
  #BrandStory-{{ sec_id }} {
    --bst-bg: {{ s.background_color }};
    --bst-eyebrow-color: {{ s.eyebrow_color }};
    --bst-heading-color: {{ s.heading_color }};
    --bst-body-color: {{ s.body_color }};
    --bst-accent-color: {{ s.accent_color }};
    --bst-button-bg: {{ s.button_bg_color }};
    --bst-button-text: {{ s.button_text_color }};
    --bst-nav-bg: {{ s.nav_bg_color }};
    --bst-nav-icon: {{ s.nav_icon_color }};
    --bst-card-border-color: {{ s.card_border_color }};
    --bst-card-border-width: {{ s.card_border_width }}px;
    --bst-card-radius: {{ s.card_border_radius }}px;
    --bst-back-tilt: {{ s.back_card_tilt }}deg;
    --bst-front-tilt: {{ s.front_card_tilt }}deg;
    --bst-gap: {{ s.column_gap }}px;
    --bst-collage-height: {{ s.collage_height_desktop }}px;
    --bst-collage-height-mobile: {{ s.collage_height_mobile }}px;
    --bst-padding-top: {{ s.padding_top }}px;
    --bst-padding-bottom: {{ s.padding_bottom }}px;

    display: block;
    background: var(--bst-bg);
    padding-block: var(--bst-padding-top) var(--bst-padding-bottom);
    overflow: hidden;
  }

  {%- if s.full_width -%}
  #BrandStory-{{ sec_id }} {
    width: 100vw;
    max-width: 100vw;
    /* Breaks the section out of the theme's page-width/container wrapper
       so its background spans the full viewport edge-to-edge, regardless
       of that wrapper's own max-width or side padding. */
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
  }
  {%- endif -%}

  #BrandStory-{{ sec_id }} * {
    box-sizing: border-box;
  }

  #BrandStory-{{ sec_id }} .bst__inner {
    max-width: 1400px;
    margin: 0 auto;
    padding-inline: 24px;
  }

  /* ---- Grid: images left / text right on desktop ---- */
  #BrandStory-{{ sec_id }} .bst__grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-areas: "images content";
    gap: var(--bst-gap);
    align-items: center;
  }

  #BrandStory-{{ sec_id }} .bst__images {
    grid-area: images;
    position: relative;
    height: var(--bst-collage-height);
  }

  #BrandStory-{{ sec_id }} .bst__content {
    grid-area: content;
  }

  /* ---- Image pair: fixed, single, does not change when navigating ---- */
  #BrandStory-{{ sec_id }} .bst__image-pair {
    position: absolute;
    inset: 0;
  }

  #BrandStory-{{ sec_id }} .bst__card {
    position: absolute;
    border: var(--bst-card-border-width) solid var(--bst-card-border-color);
    border-radius: var(--bst-card-radius);
    overflow: hidden;
    box-shadow: 0 18px 40px rgba(0,0,0,0.18);
    background: #ddd;
  }

  #BrandStory-{{ sec_id }} .bst__card img,
  #BrandStory-{{ sec_id }} .bst__placeholder-svg {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #BrandStory-{{ sec_id }} .bst__card--back {
    left: 0;
    top: 18%;
    width: 52%;
    aspect-ratio: 3 / 4;
    transform: rotate(var(--bst-back-tilt));
    z-index: 1;
  }

  #BrandStory-{{ sec_id }} .bst__card--front {
    right: 6%;
    top: 0;
    width: 58%;
    aspect-ratio: 3 / 4;
    transform: rotate(var(--bst-front-tilt));
    z-index: 2;
  }

  /* ---- Text: slides horizontally between blocks (viewport clips,
     track holds all slides in a row and translates) ---- */
  #BrandStory-{{ sec_id }} .bst__text-viewport {
    overflow: hidden;
    width: 100%;
  }

  #BrandStory-{{ sec_id }} .bst__text-track {
    display: flex;
    align-items: flex-start;
    transition: transform 0.5s cubic-bezier(0.65, 0, 0.35, 1);
    will-change: transform;
  }

  #BrandStory-{{ sec_id }} .bst__text {
    flex: 0 0 100%;
    min-width: 0;
    max-width: 100%;
  }

  #BrandStory-{{ sec_id }} .bst__eyebrow {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--bst-accent-color);
    margin-bottom: 14px;
  }

  #BrandStory-{{ sec_id }} .bst__heading {
    font-size: clamp(1.6rem, 3.2vw, 2.5rem);
    font-weight: 700;
    color: var(--bst-heading-color);
    line-height: 1.2;
    margin: 0 0 18px;
  }

  #BrandStory-{{ sec_id }} .bst__body {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--bst-body-color);
    max-width: 46em;
  }

  #BrandStory-{{ sec_id }} .bst__body p {
    margin: 0 0 1em;
  }

  #BrandStory-{{ sec_id }} .bst__body p:last-child {
    margin-bottom: 0;
  }

  #BrandStory-{{ sec_id }} .bst__body a {
    color: var(--bst-accent-color);
  }

  #BrandStory-{{ sec_id }} .bst__button {
    display: inline-block;
    margin-top: 20px;
    padding: 12px 26px;
    border-radius: 4px;
    background: var(--bst-button-bg);
    color: var(--bst-button-text);
    font-size: 0.88rem;
    font-weight: 600;
    text-decoration: none;
    transition: opacity 0.25s ease;
  }

  #BrandStory-{{ sec_id }} .bst__button:hover {
    opacity: 0.85;
  }

  /* ---- Nav arrows ---- */
  #BrandStory-{{ sec_id }} .bst__nav {
    display: flex;
    gap: 10px;
    margin-top: 28px;
  }

  #BrandStory-{{ sec_id }} .bst__nav-btn {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--bst-card-border-color);
    background: var(--bst-nav-bg);
    color: var(--bst-nav-icon);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.2s ease, background 0.2s ease;
  }

  #BrandStory-{{ sec_id }} .bst__nav-btn:hover {
    transform: translateY(-1px);
  }

  #BrandStory-{{ sec_id }} .bst__nav-btn svg {
    width: 16px;
    height: 16px;
  }

  /* ---- Tablet ---- */
  @media screen and (max-width: 989px) {
    #BrandStory-{{ sec_id }} .bst__card--back {
      width: 50%;
    }
    #BrandStory-{{ sec_id }} .bst__card--front {
      width: 56%;
    }
  }

  /* ---- Mobile: images stack ABOVE text (explicit requirement) ---- */
  @media screen and (max-width: 749px) {
    #BrandStory-{{ sec_id }} .bst__grid {
      grid-template-columns: 1fr;
      grid-template-areas:
        "images"
        "content";
      gap: 40px;
    }

    #BrandStory-{{ sec_id }} .bst__images {
      height: var(--bst-collage-height-mobile);
    }

    #BrandStory-{{ sec_id }} .bst__card--back {
      left: 4%;
      width: 54%;
    }

    #BrandStory-{{ sec_id }} .bst__card--front {
      right: 4%;
      width: 60%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #BrandStory-{{ sec_id }} .bst__text-track {
      transition: none !important;
    }
  }
</style>

<script>
(function () {
  'use strict';

  var section = document.getElementById('BrandStory-{{ sec_id }}');
  if (!section) return;

  var track = section.querySelector('[data-bst-track]');
  var textSlides = Array.prototype.slice.call(section.querySelectorAll('[data-bst-slide-text]'));
  var prevBtn = section.querySelector('[data-bst-prev]');
  var nextBtn = section.querySelector('[data-bst-next]');

  if (!track || !textSlides.length) return;

  var currentIndex = 0;
  var total = textSlides.length;

  function goTo(index) {
    currentIndex = ((index % total) + total) % total;
    track.style.transform = 'translateX(-' + (currentIndex * 100) + '%)';
  }

  if (prevBtn) {
    prevBtn.addEventListener('click', function () {
      goTo(currentIndex - 1);
    });
  }

  if (nextBtn) {
    nextBtn.addEventListener('click', function () {
      goTo(currentIndex + 1);
    });
  }
})();
</script>

{% schema %}
{
  "name": "Brand Story Slider",
  "tag": "section",
  "class": "section section--brand-story",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full width section",
      "info": "Breaks the section out of the theme's content container so its background spans the full browser width edge-to-edge. Content inside still stays readable at a max-width.",
      "default": true
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Gap between images and text",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "collage_height_desktop",
      "label": "Image collage height (desktop)",
