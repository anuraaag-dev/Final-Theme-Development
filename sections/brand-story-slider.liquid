      "type": "range",
      "id": "collage_height_mobile",
      "label": "Image collage height (mobile)",
      "min": 250,
      "max": 550,
      "step": 10,
      "unit": "px",
      "default": 360
    },
    {
      "type": "header",
      "content": "Images (fixed — same for every slide)"
