<section class="bundle-builder" id="BundleBuilder-{{ section.id }}" style="--bundle-scroll-color: {{ section.settings.p_color }};">
  <div class="bundle-container">
    <div class="bundle-products-area">

      <div class="bundle-header">
        <h2 class="bundle-main-title">{{ section.settings.heading }}</h2>
        <p class="bundle-subtitle">{{ section.settings.subtext }}</p>
      </div>

      <div class="toggle-sidebar-wrapper">
        <span>Show Items</span>
        <label class="switch">
          <input type="checkbox" id="toggle-sidebar-view" checked>
          <span class="slider round"></span>
        </label>
      </div>

      <div class="bundle-tabs-wrapper">
        <div class="bundle-tabs">
          {% for block in section.blocks %}
            <button class="bundle-tab {% if forloop.first %}active{% endif %}" data-tab="{{ forloop.index }}">
              {% render 'icon-step', icon: block.settings.step_icon, custom_icon: block.settings.custom_icon %}
              {{ block.settings.step_title }}
            </button>
          {% endfor %}
        </div>
      </div>

      {% for block in section.blocks %}
        <div class="bundle-tab-content {% if forloop.first %}active{% endif %}" data-content="{{ forloop.index }}">

          <div class="bundle-grid-wrapper" data-scroll-dir="{{ section.settings.grid_scroll_direction }}">

            <button class="bundle-scroll-arrow prev" type="button" aria-label="Previous products">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            </button>

            <div class="bundle-grid" data-scroll-dir="{{ section.settings.grid_scroll_direction }}" style="--cards-per-view: {{ section.settings.cards_per_view }};">
              {% for product in block.settings.collection.products limit: 12 %}
                <div class="bundle-product-card" style="padding-top:40px;">
                  <img
                    src="{{ product.featured_image | image_url: width: 300 }}"
                    alt="{{ product.title }}"
                    loading="lazy"
                    width="300"
                    height="300"
                  >
                  <h4>{{ product.title }}</h4>
                  <div class="price-container">
                    {% if product.compare_at_price > product.price %}
                      <span class="compare-price-strike">{{ product.compare_at_price | money }}</span>
                    {% endif %}
                    <span class="price-actual">{{ product.price | money }}</span>
                  </div>
                  <button
                    class="bundle-add"
                    data-id="{{ product.variants.first.id }}"
                    data-title="{{ product.title }}"
                    data-price="{{ product.price }}"
                    data-image="{{ product.featured_image | image_url: width: 100 }}"
                    data-step="{{ forloop.parentloop.index }}"
                  >
                    ADD TO BUNDLE
                  </button>
                </div>
              {% endfor %}
            </div>

            <button class="bundle-scroll-arrow next" type="button" aria-label="Next products">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </button>

            <div class="bundle-scroll-track">
              <div class="bundle-scroll-fill"></div>
            </div>

          </div>

        </div>
      {% endfor %}

    </div>

    <div class="bundle-summary">
      <h3 class="summary-title">{{ section.settings.bundle_h }}</h3>
      <p class="summary-promo" id="promo-text">Add items to unlock discounts.</p>

      <div class="bundle-progress-container">
        <div class="progress-line">
          <div id="progress-bar-fill"></div>
        </div>
        <div class="progress-labels">
          <span class="tier-label">{{ section.settings.tier1_discount }}% off</span>
          <span class="tier-label">{{ section.settings.tier2_discount }}% off</span>
          <span class="tier-label">{{ section.settings.tier3_discount }}% off</span>
        </div>
      </div>

      <div class="steps-tracker">
        {% for block in section.blocks %}
          <div class="step-group">
            <div class="step-row" id="step-row-{{ forloop.index }}">
              <div class="step-info">
                <div class="step-titles-box">
                  <span class="step-label"> {{ block.settings.tier1_head }} Bundle</span>
                  <span class="step-requirement">{{ block.settings.required_qty }} required</span>
                </div>
                <span class="step-status"><span class="count">0</span> added</span>
              </div>
            </div>
            <div class="selected-items-sidebar" id="selected-list-{{ forloop.index }}"></div>
          </div>
        {% endfor %}
      </div>

      <div class="bundle-footer">
        <div class="total-row">
          <span>Total</span>
          <div class="price-stack">
            <span id="bundle-total-strike" class="total-strike"></span>
            <span id="bundle-total">$0.00</span>
          </div>
        </div>
        <button id="bundle-add-cart" disabled>Add all to cart</button>
      </div>
    </div>

  </div>

  <div id="bundle-toast">Item added!</div>
</section>

<style>
  .selected-items-sidebar {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    overflow-y: hidden;
    gap: 10px;
    padding: 10px 0;
    -webkit-overflow-scrolling: touch;
  }
  .selected-items-sidebar::-webkit-scrollbar { height: 4px; }
  .selected-items-sidebar::-webkit-scrollbar-thumb { background: #ccc; border-radius: 10px; }

  .sidebar-item {
    flex: 0 0 auto;
    display: flex;
    align-items: center;
  }

  .toggle-sidebar-wrapper {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 20px;
    font-size: 14px;
    font-weight: 600;
  }

  .switch { position: relative; display: inline-block; width: 40px; height: 22px; }
  .switch input { opacity: 0; width: 0; height: 0; }
  .slider { position: absolute; cursor: pointer; top: 0; left: 0; right: 0; bottom: 0; background-color: #ccc; transition: .4s; border-radius: 34px; }
  .slider:before { position: absolute; content: ""; height: 16px; width: 16px; left: 3px; bottom: 3px; background-color: white; transition: .4s; border-radius: 50%; }
  input:checked + .slider { background-color: #000; }
  input:checked + .slider:before { transform: translateX(18px); }
  .hide-sidebar-list { display: none !important; }

  .bundle-builder { padding: 40px 0; background: #fff; position: relative; }
  .bundle-container { display: flex; gap: 30px; max-width: 1300px; margin: 0 auto; padding: 0 20px; align-items: start; }
  .bundle-products-area { flex: 1; min-width: 0; }
  .bundle-summary { width: 360px; position: sticky; top: 20px; background: #fff; border: 1px solid #eee; border-radius: 16px; padding: 20px; box-sizing: border-box; }

  .progress-line { height: 5px; background: #e0e0e0; border-radius: 10px; overflow: hidden; margin-bottom: 8px; position: relative; width: 100%; }
  #progress-bar-fill { height: 100%; width: 0%; transition: width 0.4s ease; display: block; background-color: {{ section.settings.p_color }} !important; }
  .progress-labels { display: flex; justify-content: space-between; font-size: 11px; color: #999; margin-bottom: 20px; }
  .tier-label.active { color: {{ section.settings.p_color }}; font-weight: 700; text-decoration: underline; }

  .bundle-tabs { display: flex; gap: 8px; background: #f4f4f4; padding: 6px; border-radius: 100px; width: 100%; margin: 0 auto 30px; }
  .bundle-tab { flex: 1; border: none; background: transparent; padding: 10px 18px; border-radius: 100px; cursor: pointer; display: flex; align-items: center; justify-content: center; gap: 6px; font-weight: 500; }
  .bundle-tab.active { background: #fff; box-shadow: 0 4px 10px rgba(0,0,0,0.05); }

  .bundle-tab-content { display: none; }
  .bundle-tab-content.active { display: block; }

  /* --- Scrollable product grid --- */
  .bundle-grid-wrapper {
    position: relative;
    padding: 0 6px 22px;
  }

  .bundle-grid {
    display: grid;
    gap: 15px;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
  }
  .bundle-grid::-webkit-scrollbar { display: none; }
  .bundle-grid { scrollbar-width: none; -ms-overflow-style: none; }

  /* Horizontal mode: exactly one row, scrolls sideways */
  .bundle-grid[data-scroll-dir="horizontal"] {
    grid-auto-flow: column;
    grid-template-rows: 1fr;
    grid-auto-columns: minmax(140px, calc((100% - (var(--cards-per-view, 4) - 1) * 15px) / var(--cards-per-view, 4)));
    overflow-x: auto;
    overflow-y: hidden;
  }

  /* Vertical mode: 3 columns, height locked to ~2 rows, scrolls down */
  .bundle-grid[data-scroll-dir="vertical"] {
    grid-template-columns: repeat(3, 1fr);
    overflow-y: auto;
    overflow-x: hidden;
  }

  /* Responsive step-down: horizontal cards-per-view */
  @media (max-width: 900px) {
    .bundle-grid[data-scroll-dir="horizontal"] { --cards-per-view: 3 !important; }
  }
  @media (max-width: 640px) {
    .bundle-grid[data-scroll-dir="horizontal"] { --cards-per-view: 2 !important; }
  }
  @media (max-width: 420px) {
    .bundle-grid[data-scroll-dir="horizontal"] { --cards-per-view: 1.15 !important; }
  }

  /* Responsive step-down: vertical column count */
  @media (max-width: 640px) {
    .bundle-grid[data-scroll-dir="vertical"] { grid-template-columns: repeat(2, 1fr) !important; }
  }
  @media (max-width: 380px) {
    .bundle-grid[data-scroll-dir="vertical"] { grid-template-columns: 1fr !important; }
  }

  .bundle-scroll-arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 34px;
    height: 34px;
    border-radius: 50%;
    border: 1px solid #eee;
    background: #fff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    z-index: 2;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08);
    transition: opacity 0.2s, transform 0.2s;
    color: #333;
  }
  .bundle-scroll-arrow.prev { left: -6px; }
  .bundle-scroll-arrow.next { right: -6px; }
  .bundle-scroll-arrow:hover { transform: translateY(-50%) scale(1.06); }
  .bundle-scroll-arrow.disabled { opacity: 0.25; pointer-events: none; }

  .bundle-grid-wrapper[data-scroll-dir="vertical"] .bundle-scroll-arrow.prev {
    top: -6px; left: 50%; transform: translateX(-50%) rotate(90deg);
  }
  .bundle-grid-wrapper[data-scroll-dir="vertical"] .bundle-scroll-arrow.next {
    top: auto; bottom: -6px; left: 50%; right: auto; transform: translateX(-50%) rotate(90deg);
  }
  .bundle-grid-wrapper[data-scroll-dir="vertical"] .bundle-scroll-arrow.prev:hover,
  .bundle-grid-wrapper[data-scroll-dir="vertical"] .bundle-scroll-arrow.next:hover {
    transform: translateX(-50%) rotate(90deg) scale(1.06);
  }
  .bundle-grid-wrapper[data-scroll-dir="vertical"] { padding: 22px 6px 0; }

  /* Custom "comet" progress track: fades out behind, stays dark ahead */
  .bundle-scroll-track {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: rgba(0,0,0,0.08);
    border-radius: 10px;
    overflow: hidden;
  }
  .bundle-grid-wrapper[data-scroll-dir="vertical"] .bundle-scroll-track {
    top: 0;
    bottom: 0;
    left: auto;
    right: 0;
    width: 3px;
    height: auto;
  }
  .bundle-scroll-fill {
    position: absolute;
    top: 0;
    left: 0;
    height: 100%;
    border-radius: 10px;
    transition: left 0.35s ease, top 0.35s ease, width 0.35s ease, height 0.35s ease, background 0.35s ease;
  }

  .bundle-product-card { background: #f8fbf8; border-radius: 12px; padding: 15px; text-align: center; }
  .bundle-product-card img { width: 100%; height: auto; mix-blend-mode: multiply; }
  .price-container { margin: 10px 0; display: flex; justify-content: center; gap: 8px; }
  .compare-price-strike { text-decoration: line-through; color: #999; font-size: 13px; }
  .bundle-add { width: 100%; padding: 10px; border-radius: 100px; border: 1px solid #ddd; background: #fff; cursor: pointer; font-weight: 600; font-size: 12px; }

  .sidebar-item { display: flex; align-items: center; gap: 10px; background: #fafafa; padding: 8px; border-radius: 8px; border: 1px solid #f0f0f0; margin-bottom: 8px; }
  .sidebar-item img { width: 40px; height: 40px; object-fit: cover; border-radius: 4px; }
  .sidebar-item span { flex: 1; font-size: 12px; font-weight: 500; text-align: left; }
  .remove-item { background: none; border: none; color: #ccc; cursor: pointer; font-size: 18px; }

  .total-strike { text-decoration: line-through; color: #999; font-size: 15px; display: none; }
  #bundle-total { font-size: 24px; font-weight: 700; color: #000; }
  #bundle-add-cart { width: 100%; margin-top: 15px; padding: 15px; border-radius: 100px; border: none; background: #ccc; color: #fff; font-weight: 700; cursor: not-allowed; transition: 0.3s; }
  #bundle-add-cart.ready { background: #000; cursor: pointer; }

  #bundle-toast { position: fixed; bottom: 20px; right: 20px; background: #000; color: #fff; padding: 10px 20px; border-radius: 50px; font-size: 12px; opacity: 0; visibility: hidden; transition: 0.3s; z-index: 999; }
  #bundle-toast.show { opacity: 1; visibility: visible; }

  @media (max-width: 1024px) {
    .bundle-container { flex-direction: column; }
    .bundle-summary { width: 100%; position: static; margin-top: 30px; }
  }
</style>

<script>
(function () {
  function initBundleBuilder() {
    const sidebarToggle = document.getElementById('toggle-sidebar-view');
    const sidebarLists = document.querySelectorAll('.selected-items-sidebar');

    if (sidebarToggle) {
      sidebarToggle.addEventListener('change', function () {
        sidebarLists.forEach((list) => {
          list.style.display = this.checked ? 'flex' : 'block';
        });
      });
      if (!sidebarToggle.checked) {
        sidebarLists.forEach((list) => (list.style.display = 'block'));
      }
    }

    let bundle = [];
    const settings = {
      t1: parseInt('{{ section.settings.tier1_qty }}') || 3,
      d1: parseInt('{{ section.settings.tier1_discount }}') || 5,
      t2: parseInt('{{ section.settings.tier2_qty }}') || 5,
      d2: parseInt('{{ section.settings.tier2_discount }}') || 10,
      t3: parseInt('{{ section.settings.tier3_qty }}') || 8,
      d3: parseInt('{{ section.settings.tier3_discount }}') || 15,
    };

    function updateUI() {
      const counts = { 1: 0, 2: 0, 3: 0 };
      let rawTotal = 0;
      document.querySelectorAll('.selected-items-sidebar').forEach((list) => (list.innerHTML = ''));

      bundle.forEach((item) => {
        counts[item.step]++;
        rawTotal += item.price;
        const listContainer = document.getElementById(`selected-list-${item.step}`);
        if (listContainer) {
          listContainer.insertAdjacentHTML(
            'beforeend',
            `<div class="sidebar-item"><img src="${item.image}"><span>${item.title}</span><button class="remove-item" data-uid="${item.uid}">×</button></div>`
          );
        }
      });

      Object.keys(counts).forEach((step) => {
        const el = document.querySelector(`#step-row-${step} .count`);
        if (el) el.innerText = counts[step];
      });

      let discountPercent = 0;
      let appliedCode = '';
      const labels = document.querySelectorAll('.tier-label');
      labels.forEach((l) => l.classList.remove('active'));
      let promoMsg = '';

      if (bundle.length >= settings.t3) {
        discountPercent = settings.d3;
        appliedCode = 'BUNDLE' + settings.d3;
        if (labels[2]) labels[2].classList.add('active');
        promoMsg = 'Maximum discount reached!';
      } else if (bundle.length >= settings.t2) {
        discountPercent = settings.d2;
        appliedCode = 'BUNDLE' + settings.d2;
        if (labels[1]) labels[1].classList.add('active');
        promoMsg = `Add ${settings.t3 - bundle.length} more to get ${settings.d3}% off.`;
      } else if (bundle.length >= settings.t1) {
        discountPercent = settings.d1;
        appliedCode = 'BUNDLE' + settings.d1;
        if (labels[0]) labels[0].classList.add('active');
        promoMsg = `Add ${settings.t2 - bundle.length} more to get ${settings.d2}% off.`;
      } else {
        promoMsg = `Add ${settings.t1 - bundle.length} more to get ${settings.d1}% off.`;
      }

      const promoEl = document.getElementById('promo-text');
      if (promoEl) promoEl.innerText = promoMsg;

      const progressBar = document.getElementById('progress-bar-fill');
      if (progressBar) {
        const percentage = Math.min((bundle.length / settings.t3) * 100, 100);
        progressBar.style.width = percentage + '%';
      }

      const finalTotal = rawTotal * (1 - discountPercent / 100);
      const strikeEl = document.getElementById('bundle-total-strike');
      const totalEl = document.getElementById('bundle-total');
      const format = (v) => '$' + (v / 100).toFixed(2);

      if (strikeEl) {
        if (discountPercent > 0) {
          strikeEl.innerText = format(rawTotal);
          strikeEl.style.display = 'block';
        } else {
          strikeEl.style.display = 'none';
        }
      }
      if (totalEl) totalEl.innerText = format(finalTotal);

      const cartBtn = document.getElementById('bundle-add-cart');
      if (cartBtn) {
        cartBtn.disabled = bundle.length === 0;
        cartBtn.classList.toggle('ready', bundle.length > 0);
        cartBtn.dataset.discountCode = appliedCode;
      }
    }

    /* ---------- Scrollable grid: arrows + comet progress track ---------- */
    const gridRefreshers = [];

    function setupGridScroller(wrapper) {
      const grid = wrapper.querySelector('.bundle-grid');
      if (!grid) return;

      const direction = grid.dataset.scrollDir === 'vertical' ? 'vertical' : 'horizontal';
      const prevBtn = wrapper.querySelector('.bundle-scroll-arrow.prev');
      const nextBtn = wrapper.querySelector('.bundle-scroll-arrow.next');
      const fill = wrapper.querySelector('.bundle-scroll-fill');
      let lastPos = 0;

      function measureCard() {
        const card = grid.querySelector('.bundle-product-card');
        if (!card) return { size: 0, gap: 15 };
        const gap = parseFloat(getComputedStyle(grid).gap) || 15;
        const size = direction === 'vertical'
          ? card.getBoundingClientRect().height
          : card.getBoundingClientRect().width;
        return { size, gap };
      }

      function applyVerticalCap() {
        if (direction !== 'vertical') return;
        const { size, gap } = measureCard();
        if (size > 0) grid.style.maxHeight = (size * 2 + gap) + 'px';
      }

      function refresh() {
        applyVerticalCap();

        const pos = direction === 'vertical' ? grid.scrollTop : grid.scrollLeft;
        const viewSize = direction === 'vertical' ? grid.clientHeight : grid.clientWidth;
        const fullSize = direction === 'vertical' ? grid.scrollHeight : grid.scrollWidth;
        const maxScroll = Math.max(fullSize - viewSize, 0);

        if (prevBtn) prevBtn.classList.toggle('disabled', pos <= 2);
        if (nextBtn) nextBtn.classList.toggle('disabled', pos >= maxScroll - 2 || maxScroll <= 0);

        if (fill) {
          const visibleRatio = fullSize > 0 ? viewSize / fullSize : 1;
          const headPct = Math.min(Math.max(visibleRatio * 100, 10), 100);
          const remainingPct = 100 - headPct;
          const pct = maxScroll > 0 ? pos / maxScroll : 0;
          const headStart = pct * remainingPct;
          const goingForward = pos >= lastPos;
          lastPos = pos;

          if (direction === 'vertical') {
            fill.style.top = headStart + '%';
            fill.style.height = headPct + '%';
            fill.style.left = '0';
            fill.style.width = '100%';
            fill.style.background = goingForward
              ? 'linear-gradient(to bottom, transparent, var(--bundle-scroll-color, #000))'
              : 'linear-gradient(to top, transparent, var(--bundle-scroll-color, #000))';
          } else {
            fill.style.left = headStart + '%';
            fill.style.width = headPct + '%';
            fill.style.top = '0';
            fill.style.height = '100%';
            fill.style.background = goingForward
              ? 'linear-gradient(to right, transparent, var(--bundle-scroll-color, #000))'
              : 'linear-gradient(to left, transparent, var(--bundle-scroll-color, #000))';
          }
        }
      }

      function scrollOneCard(dir) {
        const { size, gap } = measureCard();
        const amount = (size + gap) * dir;
        grid.scrollBy(
          direction === 'vertical' ? { top: amount, behavior: 'smooth' } : { left: amount, behavior: 'smooth' }
        );
      }

      if (prevBtn) prevBtn.addEventListener('click', () => scrollOneCard(-1));
      if (nextBtn) nextBtn.addEventListener('click', () => scrollOneCard(1));
      grid.addEventListener('scroll', refresh);

      gridRefreshers.push(refresh);
      refresh();
    }

    document.querySelectorAll('.bundle-grid-wrapper').forEach(setupGridScroller);

    // Re-measure once images have had a chance to load/settle, and on resize
    setTimeout(() => gridRefreshers.forEach((fn) => fn()), 150);
    window.addEventListener('resize', () => gridRefreshers.forEach((fn) => fn()));

    /* ---------- Delegated clicks (tabs, add, remove, checkout) ---------- */
    document.addEventListener('click', function (e) {
      const tabBtn = e.target.closest('.bundle-tab');
      if (tabBtn) {
        document.querySelectorAll('.bundle-tab, .bundle-tab-content').forEach((el) => el.classList.remove('active'));
        tabBtn.classList.add('active');
        const target = document.querySelector(`[data-content="${tabBtn.dataset.tab}"]`);
        if (target) target.classList.add('active');
        // Newly-visible tab's grid had 0 dimensions while hidden — remeasure now
        gridRefreshers.forEach((fn) => fn());
        return;
      }

      const addBtn = e.target.closest('.bundle-add');
      if (addBtn) {
        bundle.push({
          uid: Date.now() + Math.random(),
          id: addBtn.dataset.id,
          title: addBtn.dataset.title,
          price: parseInt(addBtn.dataset.price),
          image: addBtn.dataset.image,
          step: addBtn.dataset.step,
        });
        const toast = document.getElementById('bundle-toast');
        if (toast) {
          toast.innerText = addBtn.dataset.title + ' added!';
          toast.classList.add('show');
          setTimeout(() => toast.classList.remove('show'), 2000);
        }
        updateUI();
        return;
      }

      const removeBtn = e.target.closest('.remove-item');
      if (removeBtn) {
        const uid = parseFloat(removeBtn.dataset.uid);
        bundle = bundle.filter((i) => i.uid !== uid);
        updateUI();
        return;
      }

      const cartBtnClick = e.target.closest('#bundle-add-cart');
      if (cartBtnClick && !cartBtnClick.disabled) {
        const discountCode = cartBtnClick.dataset.discountCode;
        const originalText = cartBtnClick.innerText;
        cartBtnClick.innerText = 'Adding to cart...';
        cartBtnClick.disabled = true;

        (async function () {
          try {
            await fetch(window.Shopify.routes.root + 'cart/clear.js', { method: 'POST' });
            const itemsToAdd = bundle.map((i) => ({ id: parseInt(i.id), quantity: 1 }));
            const response = await fetch(window.Shopify.routes.root + 'cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ items: itemsToAdd }),
            });
            if (!response.ok) throw new Error('Failed to add items');
            setTimeout(() => {
              window.location.href = discountCode ? `/cart?discount=${discountCode}` : '/cart';
            }, 500);
          } catch (error) {
            console.error('Cart Error:', error);
            alert('There was an issue adding items to your cart.');
            cartBtnClick.innerText = originalText;
            cartBtnClick.disabled = false;
          }
        })();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBundleBuilder);
  } else {
    initBundleBuilder();
  }
})();
</script>

{% schema %}
{
  "name": "Bundle Builder",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Unbeatable prices with bundle." },
    {
      "type": "inline_richtext",
      "id": "subtext",
      "label": "Subheading",
      "default": "Create your personalized skincare ritual."
    },
    {
      "type": "header",
      "content": "Product List Layout"
    },
    {
      "type": "select",
      "id": "grid_scroll_direction",
