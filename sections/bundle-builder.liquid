<section class="bundle-builder" id="BundleBuilder-{{ section.id }}" style="--bundle-scroll-color: {{ section.settings.p_color }};">
  <div class="bundle-container">
    <div class="bundle-products-area">

      <div class="bundle-header">
        <h2 class="bundle-main-title">{{ section.settings.heading }}</h2>
        <p class="bundle-subtitle">{{ section.settings.subtext }}</p>
      </div>

      <div class="toggle-sidebar-wrapper">
        <span>Show Items</span>
        <label class="switch">
          <input type="checkbox" id="toggle-sidebar-view" checked>
          <span class="slider round"></span>
        </label>
      </div>

      <div class="bundle-tabs-wrapper">
        <div class="bundle-tabs">
          {% for block in section.blocks %}
            <button class="bundle-tab {% if forloop.first %}active{% endif %}" data-tab="{{ forloop.index }}">
              {% render 'icon-step', icon: block.settings.step_icon, custom_icon: block.settings.custom_icon %}
              {{ block.settings.step_title }}
            </button>
          {% endfor %}
        </div>
      </div>

      {% for block in section.blocks %}
        <div class="bundle-tab-content {% if forloop.first %}active{% endif %}" data-content="{{ forloop.index }}">

          <div
            class="bundle-grid-wrapper"
            data-scroll-dir="{{ section.settings.grid_scroll_direction }}"
          >

            <button class="bundle-scroll-arrow prev" type="button" aria-label="Previous products">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
            </button>

            <div
              class="bundle-grid"
              data-scroll-dir="{{ section.settings.grid_scroll_direction }}"
              style="
                --h-cols: {{ section.settings.h_cols_desktop }};
                --h-rows: {{ section.settings.h_rows_desktop }};
                --v-cols: {{ section.settings.v_cols_desktop }};
                --v-rows: {{ section.settings.v_rows_desktop }};
              "
            >
              {% for product in block.settings.collection.products limit: 12 %}
                <div class="bundle-product-card" style="padding-top:40px;">
                  <img
                    src="{{ product.featured_image | image_url: width: 300 }}"
                    alt="{{ product.title }}"
                    loading="lazy"
                    width="300"
                    height="300"
                  >
                  <h4>{{ product.title }}</h4>
                  <div class="price-container">
                    {% if product.compare_at_price > product.price %}
                      <span class="compare-price-strike">{{ product.compare_at_price | money }}</span>
                    {% endif %}
                    <span class="price-actual">{{ product.price | money }}</span>
                  </div>
                  <button
                    class="bundle-add"
                    data-id="{{ product.variants.first.id }}"
                    data-title="{{ product.title }}"
                    data-price="{{ product.price }}"
                    data-image="{{ product.featured_image | image_url: width: 100 }}"
                    data-step="{{ forloop.parentloop.index }}"
                  >
                    ADD TO BUNDLE
                  </button>
                </div>
              {% endfor %}
            </div>

            <button class="bundle-scroll-arrow next" type="button" aria-label="Next products">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
            </button>

            <div class="bundle-scroll-track">
              <div class="bundle-scroll-fill"></div>
            </div>

          </div>

        </div>
      {% endfor %}

    </div>

    <div class="bundle-summary">
      <h3 class="summary-title">{{ section.settings.bundle_h }}</h3>
      <p class="summary-promo" id="promo-text">Add items to unlock discounts.</p>

      <div class="bundle-progress-container">
        <div class="progress-line">
          <div id="progress-bar-fill"></div>
        </div>
        <div class="progress-labels">
          <span class="tier-label">{{ section.settings.tier1_discount }}% off</span>
          <span class="tier-label">{{ section.settings.tier2_discount }}% off</span>
          <span class="tier-label">{{ section.settings.tier3_discount }}% off</span>
        </div>
      </div>

      <div class="steps-tracker">
        {% for block in section.blocks %}
          <div class="step-group">
            <div class="step-row" id="step-row-{{ forloop.index }}">
              <div class="step-info">
                <div class="step-titles-box">
                  <span class="step-label"> {{ block.settings.tier1_head }} Bundle</span>
                  <span class="step-requirement">{{ block.settings.required_qty }} required</span>
                </div>
                <span class="step-status"><span class="count">0</span> added</span>
              </div>
            </div>
            <div class="selected-items-sidebar" id="selected-list-{{ forloop.index }}"></div>
          </div>
        {% endfor %}
      </div>

      <div class="bundle-footer">
        <div class="total-row">
          <span>Total</span>
          <div class="price-stack">
            <span id="bundle-total-strike" class="total-strike"></span>
            <span id="bundle-total">$0.00</span>
          </div>
        </div>
        <button id="bundle-add-cart" disabled>Add all to cart</button>
      </div>
    </div>

  </div>

  <div id="bundle-toast">Item added!</div>
</section>

<style>
  /* Force a consistent box model on everything in this section — a theme's
     global reset may not apply border-box the same way, which throws off
     every width/padding calculation above. */
  .bundle-builder, .bundle-builder * { box-sizing: border-box !important; }

  .selected-items-sidebar {
    display: flex !important;
    flex-wrap: nowrap !important;
    overflow-x: auto !important;
    overflow-y: hidden !important;
    gap: 10px !important;
    padding: 10px 0 !important;
    -webkit-overflow-scrolling: touch !important;
  }
  .selected-items-sidebar::-webkit-scrollbar { height: 4px !important; }
  .selected-items-sidebar::-webkit-scrollbar-thumb { background: #ccc !important; border-radius: 10px !important; }

  .sidebar-item {
    flex: 0 0 auto !important;
    display: flex !important;
    align-items: center !important;
  }

  .toggle-sidebar-wrapper {
    display: flex !important;
    align-items: center !important;
    gap: 10px !important;
    margin-bottom: 20px !important;
    font-size: 14px !important;
    font-weight: 600 !important;
  }

  .switch { position: relative !important; display: inline-block !important; width: 40px !important; height: 22px !important; }
  .switch input { opacity: 0 !important; width: 0 !important; height: 0 !important; }
  .slider { position: absolute !important; cursor: pointer !important; top: 0 !important; left: 0 !important; right: 0 !important; bottom: 0 !important; background-color: #ccc !important; transition: .4s !important; border-radius: 34px !important; }
  .slider:before { position: absolute !important; content: "" !important; height: 16px !important; width: 16px !important; left: 3px !important; bottom: 3px !important; background-color: white !important; transition: .4s !important; border-radius: 50% !important; }
  input:checked + .slider { background-color: #000 !important; }
  input:checked + .slider:before { transform: translateX(18px) !important; }
  .hide-sidebar-list { display: none !important; }

  .bundle-builder { padding: 40px 0 !important; background: #fff !important; position: relative !important; }
  .bundle-container { display: flex !important; gap: 30px !important; max-width: 1300px !important; margin: 0 auto !important; padding: 0 20px !important; align-items: start !important; }
  .bundle-products-area { flex: 1 !important; min-width: 0 !important; }
  .bundle-summary { width: 360px !important; position: sticky !important; top: 20px !important; background: #fff !important; border: 1px solid #eee !important; border-radius: 16px !important; padding: 20px !important; }

  .progress-line { height: 5px !important; background: #e0e0e0 !important; border-radius: 10px !important; overflow: hidden !important; margin-bottom: 8px !important; position: relative !important; width: 100% !important; }
  #progress-bar-fill { height: 100% !important; width: 0% !important; transition: width 0.4s ease !important; display: block !important; background-color: {{ section.settings.p_color }} !important; }
  .progress-labels { display: flex !important; justify-content: space-between !important; font-size: 11px !important; color: #999 !important; margin-bottom: 20px !important; }
  .tier-label.active { color: {{ section.settings.p_color }} !important; font-weight: 700 !important; text-decoration: underline !important; }

  .bundle-tabs { display: flex !important; gap: 8px !important; background: #f4f4f4 !important; padding: 6px !important; border-radius: 100px !important; width: 100% !important; margin: 0 auto 30px !important; }
  .bundle-tab {
    flex: 1 !important;
    border: none !important;
    background: transparent !important;
    padding: 10px 18px !important;
    border-radius: 100px !important;
    cursor: pointer !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    gap: 6px !important;
    font-weight: 500 !important;
    height: auto !important;
    line-height: normal !important;
    box-shadow: none !important;
  }
  .bundle-tab.active { background: #fff !important; box-shadow: 0 4px 10px rgba(0,0,0,0.05) !important; }

  .bundle-tab-content { display: none !important; }
  .bundle-tab-content.active { display: block !important; }

  /* --- Scrollable product grid --- */
  .bundle-grid-wrapper {
    position: relative !important;
    padding: 0 6px 22px !important;
    width: 100% !important;
    max-width: 100% !important;
  }

  .bundle-grid {
    display: grid !important;
    gap: 15px !important;
    scroll-behavior: smooth !important;
    -webkit-overflow-scrolling: touch !important;
    width: 100% !important;
  }
  .bundle-grid::-webkit-scrollbar { display: none !important; }
  .bundle-grid { scrollbar-width: none !important; -ms-overflow-style: none !important; }

  /* Horizontal mode: N rows x M columns per "page", scrolls sideways for more columns.
     Column width is set in JS as a plain px custom property (--card-w) rather than a
     percentage — percentages inside grid-auto-columns don't reliably resolve when the
     grid also has overflow-x:auto in every browser, so this guarantees exact counts. */
  .bundle-grid[data-scroll-dir="horizontal"] {
    grid-auto-flow: column !important;
    grid-template-rows: repeat(var(--h-rows, 1), 1fr) !important;
    grid-auto-columns: var(--card-w, 200px) !important;
    overflow-x: auto !important;
    overflow-y: hidden !important;
    scroll-snap-type: x mandatory !important;
  }

  /* Vertical mode: M columns, height locked to N rows worth, scrolls down for more */
  .bundle-grid[data-scroll-dir="vertical"] {
    grid-auto-flow: row !important;
    grid-template-columns: repeat(var(--v-cols, 3), 1fr) !important;
    overflow-y: auto !important;
    overflow-x: hidden !important;
    scroll-snap-type: y mandatory !important;
  }

    /* Mobile column-count overrides, at the ACTUAL mobile breakpoint (749px) —
     deliberately separate from the 1024px breakpoint below, where the
     summary stacks underneath the grid. Merging these two was the real bug:
     at 1024px the product area suddenly gets much wider, and if that same
     moment also drops to Mobile's column count (as low as 1.2), you get the
     widest possible container divided by the smallest possible number at
     once. Keeping this at 749px means 750–1024px stays stacked but still
     uses Desktop's column count — a far saner combination. */
  @media (max-width: 749px) {
    .bundle-grid {
      --h-cols: {{ section.settings.h_cols_mobile }} !important;
      --h-rows: {{ section.settings.h_rows_mobile }} !important;
      --v-cols: {{ section.settings.v_cols_mobile }} !important;
      --v-rows: {{ section.settings.v_rows_mobile }} !important;
    }
  }

  .bundle-scroll-arrow {
    position: absolute !important;
    top: 50% !important;
    transform: translateY(-50%) !important;
    width: 34px !important;
    height: 34px !important;
    border-radius: 50% !important;
    border: 1px solid #eee !important;
    background: #fff !important;
    cursor: pointer !important;
    display: flex !important;
    align-items: center !important;
    justify-content: center !important;
    z-index: 2 !important;
    box-shadow: 0 2px 8px rgba(0,0,0,0.08) !important;
    transition: opacity 0.2s, transform 0.2s !important;
    color: #333 !important;
    padding: 0 !important;
  }
  .bundle-scroll-arrow.prev { left: -6px !important; }
  .bundle-scroll-arrow.next { right: -6px !important; }
  .bundle-scroll-arrow:hover { transform: translateY(-50%) scale(1.06) !important; }
  .bundle-scroll-arrow.disabled { opacity: 0.25 !important; pointer-events: none !important; }

  .bundle-grid-wrapper[data-scroll-dir="vertical"] .bundle-scroll-arrow.prev {
    top: -6px !important; left: 50% !important; transform: translateX(-50%) rotate(90deg) !important;
  }
  .bundle-grid-wrapper[data-scroll-dir="vertical"] .bundle-scroll-arrow.next {
    top: auto !important; bottom: -6px !important; left: 50% !important; right: auto !important; transform: translateX(-50%) rotate(90deg) !important;
  }
  .bundle-grid-wrapper[data-scroll-dir="vertical"] .bundle-scroll-arrow.prev:hover,
  .bundle-grid-wrapper[data-scroll-dir="vertical"] .bundle-scroll-arrow.next:hover {
    transform: translateX(-50%) rotate(90deg) scale(1.06) !important;
  }
  .bundle-grid-wrapper[data-scroll-dir="vertical"] { padding: 22px 6px 0 !important; }

  /* Custom "comet" progress track: fades out behind, stays dark ahead */
  .bundle-scroll-track {
    position: absolute !important;
    left: 0 !important;
    right: 0 !important;
    bottom: 0 !important;
    height: 3px !important;
    background: rgba(0,0,0,0.08) !important;
    border-radius: 10px !important;
    overflow: hidden !important;
  }
  .bundle-grid-wrapper[data-scroll-dir="vertical"] .bundle-scroll-track {
    top: 0 !important;
    bottom: 0 !important;
    left: auto !important;
    right: 0 !important;
    width: 3px !important;
    height: auto !important;
  }
  .bundle-scroll-fill {
    position: absolute !important;
    top: 0 !important;
    left: 0 !important;
    height: 100% !important;
    border-radius: 10px !important;
    transition: left 0.35s ease, top 0.35s ease, width 0.35s ease, height 0.35s ease, background 0.35s ease !important;
  }

  .bundle-product-card {
    background: #f8fbf8 !important;
    border-radius: 12px !important;
    padding: 15px !important;
    text-align: center !important;
    width: 100% !important;
    min-width: 0 !important;
    max-width: 100% !important;
    height: auto !important;
    min-height: 0 !important;
    max-height: none !important;
    overflow: hidden !important;
    display: block !important;
    scroll-snap-align: start !important;
    scroll-snap-stop: always !important;
  }
  .bundle-product-card img {
    width: 100% !important;
    max-width: 100% !important;
    aspect-ratio: 1 / 1 !important;
    max-height: 280px !important; /* independent ceiling: even if a card ends up wide for any reason, the photo stops growing here instead of becoming a giant square */
    object-fit: cover !important;
    mix-blend-mode: multiply !important;
    background: #ececec !important;
    display: block !important;
    border: none !important;
    border-radius: 0 !important;
    margin: 0 !important;
  }
  @media (max-width: 749px) {
    
    .bundle-product-card img { max-height: 220px !important; }
    {% comment %} .bundle-product-card img { max-width: 220px !important; } {% endcomment %}
  }
  .bundle-product-card h4 {
    margin: 10px 0 0 !important;
    font-size: 14px !important;
    font-weight: 600 !important;
    line-height: 1.3 !important;
  }
  /* TABLET */
  @media (min-width: 750px) and (max-width: 1024px) {

  

  .bundle-product-card img {
    max-height: 260px !important;
    {% comment %} max-width: 260px !important; {% endcomment %}
  }

}
  .price-container { margin: 10px 0 !important; display: flex !important; justify-content: center !important; gap: 8px !important; }
  .compare-price-strike { text-decoration: line-through !important; color: #999 !important; font-size: 13px !important; }
  .bundle-add {
    width: 100% !important;
    padding: 10px !important;
    border-radius: 100px !important;
    border: 1px solid #ddd !important;
    background: #fff !important;
    cursor: pointer !important;
    font-weight: 600 !important;
    font-size: 12px !important;
    height: auto !important;
    line-height: normal !important;
    box-shadow: none !important;
    text-transform: none !important;
  }

  .sidebar-item { display: flex !important; align-items: center !important; gap: 10px !important; background: #fafafa !important; padding: 8px !important; border-radius: 8px !important; border: 1px solid #f0f0f0 !important; margin-bottom: 8px !important; }
  .sidebar-item img { width: 40px !important; height: 40px !important; max-width: none !important; object-fit: cover !important; border-radius: 4px !important; }
  .sidebar-item span { flex: 1 !important; font-size: 12px !important; font-weight: 500 !important; text-align: left !important; }
  .remove-item { background: none !important; border: none !important; color: #ccc !important; cursor: pointer !important; font-size: 18px !important; padding: 0 !important; }

  .total-strike { text-decoration: line-through !important; color: #999 !important; font-size: 15px !important; display: none !important; }
  #bundle-total { font-size: 24px !important; font-weight: 700 !important; color: #000 !important; }
  #bundle-add-cart {
    width: 100% !important;
    margin-top: 15px !important;
    padding: 15px !important;
    border-radius: 100px !important;
    border: none !important;
    background: #ccc !important;
    color: #fff !important;
    font-weight: 700 !important;
    cursor: not-allowed !important;
    transition: 0.3s !important;
    height: auto !important;
    box-shadow: none !important;
    text-transform: none !important;
  }
  #bundle-add-cart.ready { background: #000 !important; cursor: pointer !important; }

  #bundle-toast { position: fixed !important; bottom: 20px !important; right: 20px !important; background: #000 !important; color: #fff !important; padding: 10px 20px !important; border-radius: 50px !important; font-size: 12px !important; opacity: 0 !important; visibility: hidden !important; transition: 0.3s !important; z-index: 999 !important; }
  #bundle-toast.show { opacity: 1 !important; visibility: visible !important; }

  @media (max-width: 1024px) {
    .bundle-container { flex-direction: column !important; }
    .bundle-products-area { width: 100% !important; }
    .bundle-summary { width: 100% !important; position: static !important; margin-top: 30px !important; }
  }
</style>

<script>
(function () {
  function initBundleBuilder() {
    const sidebarToggle = document.getElementById('toggle-sidebar-view');
    const sidebarLists = document.querySelectorAll('.selected-items-sidebar');

    if (sidebarToggle) {
      sidebarToggle.addEventListener('change', function () {
        sidebarLists.forEach((list) => {
          list.style.display = this.checked ? 'flex' : 'block';
        });
      });
      if (!sidebarToggle.checked) {
        sidebarLists.forEach((list) => (list.style.display = 'block'));
      }
    }

    let bundle = [];
    const settings = {
      t1: parseInt('{{ section.settings.tier1_qty }}') || 3,
      d1: parseInt('{{ section.settings.tier1_discount }}') || 5,
      t2: parseInt('{{ section.settings.tier2_qty }}') || 5,
      d2: parseInt('{{ section.settings.tier2_discount }}') || 10,
      t3: parseInt('{{ section.settings.tier3_qty }}') || 8,
      d3: parseInt('{{ section.settings.tier3_discount }}') || 15,
    };

    function updateUI() {
      const counts = { 1: 0, 2: 0, 3: 0 };
      let rawTotal = 0;
      document.querySelectorAll('.selected-items-sidebar').forEach((list) => (list.innerHTML = ''));

      bundle.forEach((item) => {
        counts[item.step]++;
        rawTotal += item.price;
        const listContainer = document.getElementById(`selected-list-${item.step}`);
        if (listContainer) {
          listContainer.insertAdjacentHTML(
            'beforeend',
            `<div class="sidebar-item"><img src="${item.image}"><span>${item.title}</span><button class="remove-item" data-uid="${item.uid}">×</button></div>`
          );
        }
      });

      Object.keys(counts).forEach((step) => {
        const el = document.querySelector(`#step-row-${step} .count`);
        if (el) el.innerText = counts[step];
      });

      let discountPercent = 0;
      let appliedCode = '';
      const labels = document.querySelectorAll('.tier-label');
      labels.forEach((l) => l.classList.remove('active'));
      let promoMsg = '';

      if (bundle.length >= settings.t3) {
        discountPercent = settings.d3;
        appliedCode = 'BUNDLE' + settings.d3;
        if (labels[2]) labels[2].classList.add('active');
        promoMsg = 'Maximum discount reached!';
      } else if (bundle.length >= settings.t2) {
        discountPercent = settings.d2;
        appliedCode = 'BUNDLE' + settings.d2;
        if (labels[1]) labels[1].classList.add('active');
        promoMsg = `Add ${settings.t3 - bundle.length} more to get ${settings.d3}% off.`;
      } else if (bundle.length >= settings.t1) {
        discountPercent = settings.d1;
        appliedCode = 'BUNDLE' + settings.d1;
        if (labels[0]) labels[0].classList.add('active');
        promoMsg = `Add ${settings.t2 - bundle.length} more to get ${settings.d2}% off.`;
      } else {
        promoMsg = `Add ${settings.t1 - bundle.length} more to get ${settings.d1}% off.`;
      }

      const promoEl = document.getElementById('promo-text');
      if (promoEl) promoEl.innerText = promoMsg;

      const progressBar = document.getElementById('progress-bar-fill');
      if (progressBar) {
        const percentage = Math.min((bundle.length / settings.t3) * 100, 100);
        progressBar.style.width = percentage + '%';
      }

      const finalTotal = rawTotal * (1 - discountPercent / 100);
      const strikeEl = document.getElementById('bundle-total-strike');
      const totalEl = document.getElementById('bundle-total');
      const format = (v) => '$' + (v / 100).toFixed(2);

      if (strikeEl) {
        if (discountPercent > 0) {
          strikeEl.innerText = format(rawTotal);
          strikeEl.style.display = 'block';
        } else {
          strikeEl.style.display = 'none';
        }
      }
      if (totalEl) totalEl.innerText = format(finalTotal);

      const cartBtn = document.getElementById('bundle-add-cart');
      if (cartBtn) {
        cartBtn.disabled = bundle.length === 0;
        cartBtn.classList.toggle('ready', bundle.length > 0);
        cartBtn.dataset.discountCode = appliedCode;
      }
    }

    /* ---------- Scrollable grid: arrows + comet progress track ---------- */
    const gridRefreshers = [];

    function setupGridScroller(wrapper) {
      const grid = wrapper.querySelector('.bundle-grid');
      if (!grid) return;

      const direction = grid.dataset.scrollDir === 'vertical' ? 'vertical' : 'horizontal';
      const prevBtn = wrapper.querySelector('.bundle-scroll-arrow.prev');
      const nextBtn = wrapper.querySelector('.bundle-scroll-arrow.next');
      const fill = wrapper.querySelector('.bundle-scroll-fill');
      let lastPos = 0;

      function measureCard() {
        const card = grid.querySelector('.bundle-product-card');
        if (!card) return { size: 0, gap: 15 };
        const gap = parseFloat(getComputedStyle(grid).gap) || 15;
        const size = direction === 'vertical'
          ? card.getBoundingClientRect().height
          : card.getBoundingClientRect().width;
        return { size, gap };
      }

      function readVar(name, fallback) {
        const raw = getComputedStyle(grid).getPropertyValue(name);
        const n = parseFloat(raw);
        return n > 0 ? n : fallback;
      }

      function currentRows() {
        return readVar(direction === 'vertical' ? '--v-rows' : '--h-rows', direction === 'vertical' ? 2 : 1);
      }

      // The one true source of "how wide is a single card right now" — for
      // BOTH directions. Pure calculation from the container's own width and
      // the active column count. Deliberately does NOT read any element's
      // rendered/clientWidth, because that depends on layout having already
      // settled with the correct value — which is the exact race that was
      // producing the runaway sizes.
      function getCardWidthPx() {
        const gap = parseFloat(getComputedStyle(grid).gap) || 15;
        const containerWidth = grid.clientWidth;
        if (containerWidth <= 0) return 200;

        let cols = readVar(direction === 'vertical' ? '--v-cols' : '--h-cols', direction === 'vertical' ? 3 : 4);
        if (!Number.isFinite(cols)) cols = direction === 'vertical' ? 3 : 4;
        cols = Math.min(Math.max(cols, 0.5), 10);

        let cardWidth = (containerWidth - gap * (cols - 1)) / cols;
        if (!Number.isFinite(cardWidth) || cardWidth <= 0) cardWidth = 200;
        // A card can never be wider than its own container. Full stop, no exceptions.
        return Math.min(Math.max(cardWidth, 80), containerWidth);
      }

      function applyHorizontalWidth() {
        if (direction !== 'horizontal') return;
        grid.style.setProperty('--card-w', getCardWidthPx() + 'px');
      }

      // Same formula, both directions — sizes every product image to a real,
      // explicit square in px, computed from the card width above rather than
      // measured back off the DOM.
      {% comment %} function applyImageSquares() {
        const cardWidth = getCardWidthPx();
        const sample = grid.querySelector('.bundle-product-card');
        let padH = 30; // fallback: matches .bundle-product-card's 15px+15px padding
        if (sample) {
          const cs = getComputedStyle(sample);
          const pl = parseFloat(cs.paddingLeft) || 0;
          const pr = parseFloat(cs.paddingRight) || 0;
          if (pl + pr > 0) padH = pl + pr;
        }
                // Cap how tall a square photo can get, independent of how wide the
        // card is — otherwise a low column count (wide cards) always means
        // a very tall image, since it's forced to stay a perfect square.
        const imgSize = Math.min(Math.max(cardWidth - padH, 40), 220);
        grid.querySelectorAll('.bundle-product-card img').forEach((img) => {
          img.style.height = imgSize + 'px';
        });
      } {% endcomment %}

      function applyVerticalCap() {
        if (direction !== 'vertical') return;
        const { size, gap } = measureCard();
        const rows = currentRows();
        if (size > 0) grid.style.maxHeight = (Math.min(size, 2000) * rows + gap * (rows - 1)) + 'px';
      }

      function updateScrollUI() {
        const pos = direction === 'vertical' ? grid.scrollTop : grid.scrollLeft;
        const viewSize = direction === 'vertical' ? grid.clientHeight : grid.clientWidth;
        const fullSize = direction === 'vertical' ? grid.scrollHeight : grid.scrollWidth;
        const maxScroll = Math.max(fullSize - viewSize, 0);

        // Scroll-snap can lock the reachable position slightly short of the
        // true geometric max when items don't divide evenly into snap points
        // — likely here, since Mobile's column count allows fractional values
        // like 1.2 on purpose. Treat anything within ~60% of one card's width
        // of the true end as "fully scrolled", so the bar and the arrow both
        // agree with where scrolling can actually reach, instead of the bar
        // showing a gap that's physically impossible to close.
        const { size: cardSize } = measureCard();
        const snapTolerance = cardSize > 0 ? cardSize * 0.6 : 20;
        const atEnd = maxScroll <= 0 || pos >= maxScroll - snapTolerance;

        if (prevBtn) prevBtn.classList.toggle('disabled', pos <= 2);
        if (nextBtn) nextBtn.classList.toggle('disabled', atEnd);

        if (fill) {
          const visibleRatio = fullSize > 0 ? viewSize / fullSize : 1;
          const headPct = Math.min(Math.max(visibleRatio * 100, 10), 100);
          const remainingPct = 100 - headPct;
          const pct = atEnd ? 1 : (maxScroll > 0 ? pos / maxScroll : 0);
          const headStart = pct * remainingPct;
          const goingForward = pos >= lastPos;
          lastPos = pos;

          if (direction === 'vertical') {
            fill.style.top = headStart + '%';
            fill.style.height = headPct + '%';
            fill.style.left = '0';
            fill.style.width = '100%';
            fill.style.background = goingForward
              ? 'linear-gradient(to bottom, transparent, var(--bundle-scroll-color, #000))'
              : 'linear-gradient(to top, transparent, var(--bundle-scroll-color, #000))';
          } else {
            fill.style.left = headStart + '%';
            fill.style.width = headPct + '%';
            fill.style.top = '0';
            fill.style.height = '100%';
            fill.style.background = goingForward
              ? 'linear-gradient(to right, transparent, var(--bundle-scroll-color, #000))'
              : 'linear-gradient(to left, transparent, var(--bundle-scroll-color, #000))';
          }
        }
      }

      // Order matters: get the card's width settled first (horizontal), then
      // square the images to match, then (vertical only) measure the resulting
      // card height to set the 2-row cap.
      function refresh() {
        applyHorizontalWidth();
        {% comment %} applyImageSquares(); {% endcomment %}
        applyVerticalCap();
        updateScrollUI();
      }

      function scrollOneCard(dir) {
        const { size, gap } = measureCard();
        const amount = (size + gap) * dir;
        grid.scrollBy(
          direction === 'vertical' ? { top: amount, behavior: 'smooth' } : { left: amount, behavior: 'smooth' }
        );
      }

      if (prevBtn) prevBtn.addEventListener('click', () => scrollOneCard(-1));
      if (nextBtn) nextBtn.addEventListener('click', () => scrollOneCard(1));
      grid.addEventListener('scroll', updateScrollUI);

      gridRefreshers.push(refresh);
      refresh();
    }

    document.querySelectorAll('.bundle-grid-wrapper').forEach(setupGridScroller);

    // Coalesce every refresh request (load, resize, tab switch, ResizeObserver)
    // into a single call per animation frame. Sizing this section also changes
    // its own rendered size (card width -> image height -> section height),
    // which re-triggers the ResizeObserver below — without this coalescing,
    // that back-and-forth can compound in the same tick instead of settling.
    let refreshScheduled = false;
    function scheduleRefresh() {
      if (refreshScheduled) return;
      refreshScheduled = true;
      requestAnimationFrame(() => {
        refreshScheduled = false;
        gridRefreshers.forEach((fn) => fn());
      });
    }

    setTimeout(scheduleRefresh, 150);
    window.addEventListener('resize', scheduleRefresh);

    if (window.ResizeObserver) {
      const ro = new ResizeObserver(() => scheduleRefresh());
      document.querySelectorAll('.bundle-builder').forEach((section) => ro.observe(section));
    }

    /* ---------- Delegated clicks (tabs, add, remove, checkout) ---------- */
    document.addEventListener('click', function (e) {
      const tabBtn = e.target.closest('.bundle-tab');
      if (tabBtn) {
        document.querySelectorAll('.bundle-tab, .bundle-tab-content').forEach((el) => el.classList.remove('active'));
        tabBtn.classList.add('active');
        const target = document.querySelector(`[data-content="${tabBtn.dataset.tab}"]`);
        if (target) target.classList.add('active');
        // Newly-visible tab's grid had 0 dimensions while hidden — remeasure now
        // Newly-visible tab's grid had 0 dimensions while hidden — remeasure now
        scheduleRefresh();
        return;
      }

      const addBtn = e.target.closest('.bundle-add');
      if (addBtn) {
        bundle.push({
          uid: Date.now() + Math.random(),
          id: addBtn.dataset.id,
          title: addBtn.dataset.title,
          price: parseInt(addBtn.dataset.price),
          image: addBtn.dataset.image,
          step: addBtn.dataset.step,
        });
        const toast = document.getElementById('bundle-toast');
        if (toast) {
          toast.innerText = addBtn.dataset.title + ' added!';
          toast.classList.add('show');
          setTimeout(() => toast.classList.remove('show'), 2000);
        }
        updateUI();
        return;
      }

      const removeBtn = e.target.closest('.remove-item');
      if (removeBtn) {
        const uid = parseFloat(removeBtn.dataset.uid);
        bundle = bundle.filter((i) => i.uid !== uid);
        updateUI();
        return;
      }

      const cartBtnClick = e.target.closest('#bundle-add-cart');
      if (cartBtnClick && !cartBtnClick.disabled) {
        const discountCode = cartBtnClick.dataset.discountCode;
        const originalText = cartBtnClick.innerText;
        cartBtnClick.innerText = 'Adding to cart...';
        cartBtnClick.disabled = true;

        (async function () {
          try {
            await fetch(window.Shopify.routes.root + 'cart/clear.js', { method: 'POST' });
            const itemsToAdd = bundle.map((i) => ({ id: parseInt(i.id), quantity: 1 }));
            const response = await fetch(window.Shopify.routes.root + 'cart/add.js', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({ items: itemsToAdd }),
            });
            if (!response.ok) throw new Error('Failed to add items');
            setTimeout(() => {
              window.location.href = discountCode ? `/cart?discount=${discountCode}` : '/cart';
            }, 500);
          } catch (error) {
            console.error('Cart Error:', error);
            alert('There was an issue adding items to your cart.');
            cartBtnClick.innerText = originalText;
            cartBtnClick.disabled = false;
          }
        })();
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBundleBuilder);
  } else {
    initBundleBuilder();
  }
})();
</script>

