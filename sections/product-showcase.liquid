  {%- liquid
  assign s = section.settings
  assign sec_id = section.id
  assign layout = s.layout_type
-%}

<section
  id="ProductShowcase-{{ sec_id }}"
  class="pgs pgs--{{ layout }}{% if s.equal_card_height %} pgs--equal-height{% endif %}"
  data-product-showcase
  data-layout="{{ layout }}"
  data-autoplay="{{ s.enable_autoplay }}"
  data-autoplay-speed="{{ s.autoplay_speed }}"
  data-loop="{{ s.enable_loop }}"
>
  <div class="pgs__inner">

    <div class="pgs__header">
      <div class="pgs__heading-block">
        {%- if s.heading != blank -%}<h2 class="pgs__heading">{{ s.heading }}</h2>{%- endif -%}
        {%- if s.subheading != blank -%}<p class="pgs__subheading">{{ s.subheading }}</p>{%- endif -%}
        {%- if s.description != blank -%}<div class="pgs__description">{{ s.description }}</div>{%- endif -%}
      </div>

      {%- if layout == 'carousel' and s.show_arrows -%}
        <div class="pgs__nav" data-pgs-nav>
          <button type="button" class="pgs__nav-btn pgs__nav-btn--prev" data-pgs-prev aria-label="Previous products">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
          </button>
          <button type="button" class="pgs__nav-btn pgs__nav-btn--next" data-pgs-next aria-label="Next products">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
          </button>
        </div>
      {%- endif -%}
    </div>

    <div class="pgs__track-wrap" data-pgs-track-wrap>
      <ul class="pgs__track" data-pgs-track role="list">

        {%- liquid
          assign selected_block_count = 0
          for block in section.blocks
            if block.settings.product != blank
              assign selected_block_count = selected_block_count | plus: 1
            endif
          endfor
          assign use_manual_products = false
          if s.product_source == 'manual' or selected_block_count > 0
            assign use_manual_products = true
          endif
        -%}

        {%- if use_manual_products -%}

          {%- for block in section.blocks -%}
            {%- liquid
              assign product = block.settings.product
              if product == blank
                continue
              endif
            -%}
            <li class="pgs__card" data-pgs-card {{ block.shopify_attributes }}>
              {%- liquid
                assign variant = product.selected_or_first_available_variant
                assign product_label = blank
                if product.tags contains 'new'
                  assign product_label = 'New'
                endif
                if product_label == blank
                  for tag in product.tags
                    if tag contains 'label:'
                      assign product_label = tag | remove_first: 'label:'
                      break
                    endif
                  endfor
                endif
                if block.settings.custom_label != blank
                  assign product_label = block.settings.custom_label
                endif
                assign show_sale = false
                if s.show_sale_badge and variant.compare_at_price > variant.price
                  assign show_sale = true
                endif
                assign first_option = product.options_with_values.first
                assign is_color_option = false
                if first_option.name == 'Color' or first_option.name == 'Colour'
                  assign is_color_option = true
                endif
                assign has_swatches = false
                if s.show_swatches and first_option != blank and is_color_option
                  assign has_swatches = true
                endif
              -%}

              <div class="pgs__card-top">
                {%- if show_sale -%}
                  <span class="pgs__badge pgs__badge--sale">
                    {%- if s.badge_style == 'percent_off' -%}
                      {%- assign pct = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price -%}
                      -{{ pct }}%
                    {%- else -%}
                      Save {{ variant.compare_at_price | minus: variant.price | money }}
                    {%- endif -%}
                  </span>
                {%- elsif product_label != blank -%}
                  <span class="pgs__badge pgs__badge--label">{{ product_label }}</span>
                {%- elsif variant.available == false -%}
                  <span class="pgs__badge pgs__badge--soldout">Sold Out</span>
                {%- else -%}
                  <span class="pgs__badge pgs__badge--spacer" aria-hidden="true"></span>
                {%- endif -%}

                {%- if s.show_quick_view -%}
                  <button
                    type="button"
                    class="pgs__quick-look"
                    data-pgs-quickview
                    data-qv-title="{{ product.title | escape }}"
                    data-qv-vendor="{{ product.vendor | escape }}"
                    data-qv-price="{{ variant.price | money }}"
                    data-qv-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}"
                    data-qv-image="{{ product.featured_image | image_url: width: 700 }}"
                    data-qv-url="{{ product.url }}"
                    data-qv-description="{{ product.description | strip_html | truncatewords: 28 | escape }}"
                    data-qv-variant-id="{{ variant.id }}"
                    data-qv-available="{{ variant.available }}"
                  >Quick Look</button>
                {%- else -%}
                  <span></span>
                {%- endif -%}
              </div>

              <div class="pgs__image-wrap">
                {%- if s.show_wishlist -%}
                  <button type="button" class="pgs__wishlist" data-wishlist-toggle data-product-id="{{ product.id }}" aria-label="Add {{ product.title | escape }} to wishlist">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-6.7-4.35-9.3-8.28C1 10.1 1.5 6.5 4.6 5 7 3.8 9.6 4.7 12 7c2.4-2.3 5-3.2 7.4-2 3.1 1.5 3.6 5.1 1.9 7.72C18.7 16.65 12 21 12 21z"/></svg>
                  </button>
                {%- endif -%}

                <label class="pgs__compare-toggle" title="Add to compare" onclick="event.stopPropagation()">
                  <input
                    type="checkbox"
                    data-compare-checkbox
                    data-product-id="{{ product.id }}"
                    data-product-handle="{{ product.handle }}"
                    data-product-title="{{ product.title | escape }}"
                    aria-label="Compare {{ product.title | escape }}"
                  >
                  <span>Compare</span>
                </label>

                <a href="{{ product.url }}" class="pgs__image-link" data-pgs-image-link>
                  {%- if product.featured_image -%}
                    <img
                      class="pgs__image pgs__image--primary"
                      data-pgs-primary-image
                      src="{{ product.featured_image | image_url: width: 600 }}"
                      srcset="{{ product.featured_image | image_url: width: 300 }} 300w, {{ product.featured_image | image_url: width: 600 }} 600w, {{ product.featured_image | image_url: width: 900 }} 900w"
                      sizes="(max-width: 749px) 50vw, 300px"
                      alt="{{ product.featured_image.alt | default: product.title | escape }}"
                      loading="lazy"
                      width="{{ product.featured_image.width }}"
                      height="{{ product.featured_image.height }}"
                    >
                  {%- else -%}
                    <div class="pgs__image-placeholder" data-pgs-primary-image>{{ 'product-1' | placeholder_svg_tag: 'pgs__placeholder-svg' }}</div>
                  {%- endif -%}
                  {%- if product.images.size > 1 -%}
                    <img
                      class="pgs__image pgs__image--secondary"
                      src="{{ product.images[1] | image_url: width: 600 }}"
                      alt=""
                      loading="lazy"
                      aria-hidden="true"
                    >
                  {%- endif -%}
                </a>

                {%- if s.show_quick_add -%}
                  <form class="pgs__quick-add-form" data-quick-add-form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="id" value="{{ variant.id }}" data-pgs-variant-input>
                    <button type="submit" class="pgs__quick-add-btn" aria-label="Add {{ product.title | escape }} to cart" {% unless variant.available %}disabled{% endunless %}>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                    </button>
                  </form>
                {%- endif -%}
              </div>

              <div class="pgs__info">
                {%- if s.show_vendor -%}
                  <span class="pgs__vendor">{{ product.type | default: product.vendor }}</span>
                {%- endif -%}

                <a href="{{ product.url }}" class="pgs__title">{{ product.title }}</a>

                {%- if s.show_rating -%}
                  {%- assign rating = product.metafields.reviews.rating.value -%}
                  {%- if rating -%}
                    <div class="pgs__rating" aria-label="Rated {{ rating }} out of 5">
                      {%- for i in (1..5) -%}
                        <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                {%- endif -%}

                <div class="pgs__price-row" data-pgs-price-row>
                  <span class="pgs__price" data-pgs-price>{{ variant.price | money }}</span>
                  {%- if s.show_compare_price and variant.compare_at_price > variant.price -%}
                    <s class="pgs__compare" data-pgs-compare>{{ variant.compare_at_price | money }}</s>
                  {%- else -%}
                    <s class="pgs__compare" data-pgs-compare hidden></s>
                  {%- endif -%}
                </div>

                {%- if has_swatches -%}
                  <div class="pgs__swatch-label">Color: <span data-pgs-color-name>{{ first_option.values.first }}</span></div>
                  <div class="pgs__swatches" data-pgs-swatches>
                    {%- for value in first_option.values -%}
                      {%- liquid
                        assign swatch_variant = product.variants | where: 'option1', value | first
                        assign swatch_image_url = blank
                        if swatch_variant.image
                          assign swatch_image_url = swatch_variant.image | image_url: width: 600
                        else
                          for img in product.images
                            if img.alt contains value
                              assign swatch_image_url = img | image_url: width: 600
                              break
                            endif
                          endfor
                        endif
                      -%}
                      {%- if swatch_variant -%}
                        <button
                          type="button"
                          class="pgs__swatch{% if forloop.first %} is-active{% endif %}"
                          data-pgs-swatch
                          data-color-name="{{ value | escape }}"
                          data-variant-id="{{ swatch_variant.id }}"
                          data-price="{{ swatch_variant.price | money }}"
                          data-compare="{% if swatch_variant.compare_at_price > swatch_variant.price %}{{ swatch_variant.compare_at_price | money }}{% endif %}"
                          data-available="{{ swatch_variant.available }}"
                          {%- if swatch_image_url != blank -%}
                            data-image="{{ swatch_image_url }}"
                          {%- endif -%}
                          style="--swatch-color: {{ value | remove: ' ' }};"
                          aria-label="{{ value | escape }}"
                          aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}"
                        ></button>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}

        {%- else -%}

          {%- liquid
            assign coll = collections[s.collection]
            if s.show_all_products
              assign product_list = coll.products
            else
              assign product_list = coll.products | slice: 0, s.product_count
            endif
          -%}
          {%- for product in product_list -%}
            <li class="pgs__card" data-pgs-card>
              {%- liquid
                assign variant = product.selected_or_first_available_variant
                assign product_label = blank
                if product.tags contains 'new'
                  assign product_label = 'New'
                endif
                if product_label == blank
                  for tag in product.tags
                    if tag contains 'label:'
                      assign product_label = tag | remove_first: 'label:'
                      break
                    endif
                  endfor
                endif
                assign show_sale = false
                if s.show_sale_badge and variant.compare_at_price > variant.price
                  assign show_sale = true
                endif
                assign first_option = product.options_with_values.first
                assign is_color_option = false
                if first_option.name == 'Color' or first_option.name == 'Colour'
                  assign is_color_option = true
                endif
                assign has_swatches = false
                if s.show_swatches and first_option != blank and is_color_option
                  assign has_swatches = true
                endif
              -%}

              <div class="pgs__card-top">
                {%- if show_sale -%}
                  <span class="pgs__badge pgs__badge--sale">
                    {%- if s.badge_style == 'percent_off' -%}
                      {%- assign pct = variant.compare_at_price | minus: variant.price | times: 100 | divided_by: variant.compare_at_price -%}
                      -{{ pct }}%
                    {%- else -%}
                      Save {{ variant.compare_at_price | minus: variant.price | money }}
                    {%- endif -%}
                  </span>
                {%- elsif product_label != blank -%}
                  <span class="pgs__badge pgs__badge--label">{{ product_label }}</span>
                {%- elsif variant.available == false -%}
                  <span class="pgs__badge pgs__badge--soldout">Sold Out</span>
                {%- else -%}
                  <span class="pgs__badge pgs__badge--spacer" aria-hidden="true"></span>
                {%- endif -%}

                {%- if s.show_quick_view -%}
                  <button
                    type="button"
                    class="pgs__quick-look"
                    data-pgs-quickview
                    data-qv-title="{{ product.title | escape }}"
                    data-qv-vendor="{{ product.vendor | escape }}"
                    data-qv-price="{{ variant.price | money }}"
                    data-qv-compare="{% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money }}{% endif %}"
                    data-qv-image="{{ product.featured_image | image_url: width: 700 }}"
                    data-qv-url="{{ product.url }}"
                    data-qv-description="{{ product.description | strip_html | truncatewords: 28 | escape }}"
                    data-qv-variant-id="{{ variant.id }}"
                    data-qv-available="{{ variant.available }}"
                  >Quick Look</button>
                {%- else -%}
                  <span></span>
                {%- endif -%}
              </div>

              <div class="pgs__image-wrap">
                {%- if s.show_wishlist -%}
                  <button type="button" class="pgs__wishlist" data-wishlist-toggle data-product-id="{{ product.id }}" aria-label="Add {{ product.title | escape }} to wishlist">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 21s-6.7-4.35-9.3-8.28C1 10.1 1.5 6.5 4.6 5 7 3.8 9.6 4.7 12 7c2.4-2.3 5-3.2 7.4-2 3.1 1.5 3.6 5.1 1.9 7.72C18.7 16.65 12 21 12 21z"/></svg>
                  </button>
                {%- endif -%}

                <label class="pgs__compare-toggle" title="Add to compare" onclick="event.stopPropagation()">
                  <input
                    type="checkbox"
                    data-compare-checkbox
                    data-product-id="{{ product.id }}"
                    data-product-handle="{{ product.handle }}"
                    data-product-title="{{ product.title | escape }}"
                    aria-label="Compare {{ product.title | escape }}"
                  >
                  <span>Compare</span>
                </label>

                <a href="{{ product.url }}" class="pgs__image-link" data-pgs-image-link>
                  {%- if product.featured_image -%}
                    <img
                      class="pgs__image pgs__image--primary"
                      data-pgs-primary-image
                      src="{{ product.featured_image | image_url: width: 600 }}"
                      srcset="{{ product.featured_image | image_url: width: 300 }} 300w, {{ product.featured_image | image_url: width: 600 }} 600w, {{ product.featured_image | image_url: width: 900 }} 900w"
                      sizes="(max-width: 749px) 50vw, 300px"
                      alt="{{ product.featured_image.alt | default: product.title | escape }}"
                      loading="lazy"
                      width="{{ product.featured_image.width }}"
                      height="{{ product.featured_image.height }}"
                    >
                  {%- else -%}
                    <div class="pgs__image-placeholder" data-pgs-primary-image>{{ 'product-1' | placeholder_svg_tag: 'pgs__placeholder-svg' }}</div>
                  {%- endif -%}
                  {%- if product.images.size > 1 -%}
                    <img
                      class="pgs__image pgs__image--secondary"
                      src="{{ product.images[1] | image_url: width: 600 }}"
                      alt=""
                      loading="lazy"
                      aria-hidden="true"
                    >
                  {%- endif -%}
                </a>

                {%- if s.show_quick_add -%}
                  <form class="pgs__quick-add-form" data-quick-add-form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
                    <input type="hidden" name="id" value="{{ variant.id }}" data-pgs-variant-input>
                    <button type="submit" class="pgs__quick-add-btn" aria-label="Add {{ product.title | escape }} to cart" {% unless variant.available %}disabled{% endunless %}>
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
                    </button>
                  </form>
                {%- endif -%}
              </div>

              <div class="pgs__info">
                {%- if s.show_vendor -%}
                  <span class="pgs__vendor">{{ product.type | default: product.vendor }}</span>
                {%- endif -%}

                <a href="{{ product.url }}" class="pgs__title">{{ product.title }}</a>

                {%- if s.show_rating -%}
                  {%- assign rating = product.metafields.reviews.rating.value -%}
                  {%- if rating -%}
                    <div class="pgs__rating" aria-label="Rated {{ rating }} out of 5">
                      {%- for i in (1..5) -%}
                        <svg viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87L18.18 21 12 17.27 5.82 21 7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
                      {%- endfor -%}
                    </div>
                  {%- endif -%}
                {%- endif -%}

                <div class="pgs__price-row" data-pgs-price-row>
