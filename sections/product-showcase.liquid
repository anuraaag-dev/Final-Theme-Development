                        ></button>
                      {%- endif -%}
                    {%- endfor -%}
                  </div>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}

        {%- endif -%}

      </ul>
    </div>

    {%- if layout == 'carousel' and s.show_dots -%}
      <div class="pgs__dots" data-pgs-dots aria-hidden="true"></div>
    {%- endif -%}
  </div>

  <!-- Quick View Modal (shared, one per section) -->
  <div class="pgs__modal-overlay" data-pgs-modal-overlay hidden>
    <div class="pgs__modal" role="dialog" aria-modal="true" aria-label="Quick view">
      <button type="button" class="pgs__modal-close" data-pgs-modal-close aria-label="Close quick view">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
      <div class="pgs__modal-image-wrap">
        <img class="pgs__modal-image" data-pgs-modal-image src="" alt="">
      </div>
      <div class="pgs__modal-info">
        <span class="pgs__modal-vendor" data-pgs-modal-vendor></span>
        <h3 class="pgs__modal-title" data-pgs-modal-title></h3>
        <div class="pgs__modal-price-row">
          <span class="pgs__modal-price" data-pgs-modal-price></span>
          <s class="pgs__modal-compare" data-pgs-modal-compare hidden></s>
        </div>
        <p class="pgs__modal-description" data-pgs-modal-description></p>
        <form class="pgs__modal-add-form" data-pgs-modal-add-form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data">
          <input type="hidden" name="id" value="" data-pgs-modal-variant-input>
          <button type="submit" class="pgs__modal-add-btn" data-pgs-modal-add-btn>Add to Cart</button>
        </form>
        <a href="#" class="pgs__modal-link" data-pgs-modal-link>View full details</a>
      </div>
    </div>
  </div>

  <!-- Add to Cart confirmation toast / mini-cart (theme-agnostic: this does
       NOT depend on the store's own cart drawer existing or listening for
       any particular event, so it always shows the item that was just
       added, right away, no page refresh needed. -->
  <div class="pgs__cart-toast" data-pgs-cart-toast hidden aria-live="polite" role="status">
    <div class="pgs__cart-toast-header">
      <span class="pgs__cart-toast-label">Added to cart</span>
      <button type="button" class="pgs__cart-toast-close" data-pgs-toast-close aria-label="Close">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>
    <div class="pgs__cart-toast-item">
      <img class="pgs__cart-toast-image" data-pgs-toast-image src="" alt="">
      <div class="pgs__cart-toast-info">
        <span class="pgs__cart-toast-title" data-pgs-toast-title></span>
        <span class="pgs__cart-toast-price" data-pgs-toast-price></span>
      </div>
    </div>
    <div class="pgs__cart-toast-footer">
      <span class="pgs__cart-toast-count" data-pgs-toast-count></span>
      <div class="pgs__cart-toast-actions">
        <a href="{{ routes.cart_url }}" class="pgs__cart-toast-view">View cart</a>
        <a href="{{ routes.checkout_url }}" class="pgs__cart-toast-checkout">Checkout</a>
      </div>
    </div>
  </div>
</section>

{% render 'compare-widget' %}

<style>
  #ProductShowcase-{{ sec_id }} {
    --pgs-bg: {{ s.background_color }};
    --pgs-heading-color: {{ s.heading_color }};
    --pgs-subheading-color: {{ s.subheading_color }};
