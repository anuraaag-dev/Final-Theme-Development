<div class="wishlist-page-wrapper" data-wishlist-page style="--wishlist-columns: {{ section.settings.columns }}">
  <h1 class="wishlist-page-title">{{ section.settings.heading }}</h1>
  <div class="wishlist-grid" data-wishlist-grid></div>
  <p class="wishlist-empty-message" data-wishlist-empty hidden>{{ section.settings.empty_message }}</p>
</div>

<script>
  document.addEventListener('DOMContentLoaded', async () => {
    const grid = document.querySelector('[data-wishlist-grid]');
    const emptyMsg = document.querySelector('[data-wishlist-empty]');
    const handles = window.Wishlist.getWishlist();

    if (!handles.length) {
      emptyMsg.hidden = false;
      return;
    }

    const formatMoney = (cents) => {
      const amount = (cents / 100).toFixed(2);
      return window.Shopify?.currency?.active
        ? `${amount} ${window.Shopify.currency.active}`
        : `$${amount}`;
    };

    for (const handle of handles) {
      try {
        const res = await fetch(`/products/${handle}.js`);
        if (!res.ok) continue;
        const product = await res.json();

        const card = document.createElement('div');
        card.className = 'wishlist-card';
        card.innerHTML = `
          <a href="${product.url}" class="wishlist-card__link">
            <img src="${product.featured_image}" alt="${product.title}" width="300" height="300" loading="lazy">
            <p class="wishlist-card__title">${product.title}</p>
            <p class="wishlist-card__price">${formatMoney(product.price)}</p>
          </a>
          <button type="button" data-wishlist-button data-product-handle="${handle}" class="wishlist-button is-active" aria-pressed="true">
            Remove
          </button>
        `;
        grid.appendChild(card);
      } catch (e) {
        console.error('Wishlist fetch failed for', handle, e);
      }
    }

    if (!grid.children.length) {
      emptyMsg.hidden = false;
    }
  });
</script>

<style>
  .wishlist-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .wishlist-card img {
    width: 100%;
    height: auto;
    object-fit: cover;
  }

  .wishlist-card__title,
  .wishlist-card__price {
    color: rgb(var(--color-foreground));
  }
</style>

<style>
  .wishlist-grid {
    display: grid;
    grid-template-columns: repeat(var(--wishlist-columns, 4), 1fr);
    gap: var(--grid-desktop-horizontal-spacing, 24px);
  }

  @media screen and (max-width: 749px) {
    .wishlist-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>

{% schema %}
{
  "name": "Wishlist",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "My Wishlist"
    },
    {
      "type": "text",
      "id": "empty_message",
      "label": "Empty state message",
      "default": "You haven't added anything yet."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Products per row (desktop)",
      "min": 2,
      "max": 5,
      "default": 4
    }
  ],
  "presets": [
    { "name": "Wishlist" }
  ]
}
{% endschema %}