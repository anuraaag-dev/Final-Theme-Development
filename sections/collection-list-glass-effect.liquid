{% comment %}
  Section: Collection Glass Grid (Fully Responsive)
  Description: Desktop grid, Mobile flex column. Blur fades from bottom up, text stays 100% opaque.
{% endcomment %}

<div class="collection-glass-section page-width" data-section-id="{{ section.id }}">
  {%- if section.settings.heading != blank -%}
    <div class="section-header text-center">
      <h2 class="section-heading">{{ section.settings.heading | escape }}</h2>
      {%- if section.settings.subheading != blank -%}
        <p class="section-subheading">{{ section.settings.subheading | escape }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="collection-grid-wrapper">
    <div class="collection-grid" 
         style="--per-row: {{ section.settings.per_row }}; --gap: {{ section.settings.gap }}px;">
      
      {%- for block in section.blocks -%}
        {%- assign collection = collections[block.settings.collection] -%}
        {%- if collection != blank -%}
          <div class="collection-card" {{ block.shopify_attributes }} style="--anim-delay: {{ forloop.index0 | times: 0.1 }}s;">
            <div class="card-image-wrapper">
              {%- if collection.image != blank -%}
                {{ collection.image | image_url: width: 800, height: 1000, crop: 'center' | image_tag: 
                   loading: 'lazy', 
                   sizes: '(min-width: 1200px) calc((1200px - 80px) / 3), (min-width: 750px) calc((100vw - 80px) / 2), calc(100vw - 40px)',
                   widths: '400, 600, 800, 1000',
                   class: 'collection-img'
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>

            <!-- Gradient Blur Overlay (fades from bottom up) -->
            <div class="blur-overlay">
              <div class="overlay-content">
                <h3 class="collection-title">{{ collection.title | escape }}</h3>
                
                {%- if section.settings.show_description -%}
                  <p class="collection-desc">
                    {{- block.settings.description | default: collection.description | strip_html | truncate: 70 -}}
                  </p>
                {%- endif -%}
                
                <a href="{{ collection.url }}" class="btn btn--primary">
                  {{- section.settings.button_label | default: 'Shop Now' -}}
                  <span class="btn-arrow">→</span>
                </a>
              </div>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
      
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection Glass Grid",
  "class": "section-collection-glass-grid",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Explore our collections"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "Find the perfect style for every moment"
    },
    {
      "type": "range",
      "id": "per_row",
      "label": "Collections per row",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap between cards",
      "min": 10,
      "max": 50,
      "step": 5,
      "default": 25,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Discover",
      "info": "Leave empty to use default 'Shop Now'"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Choose collection"
        },
        {
          "type": "text",
          "id": "description",
          "label": "One-line description",
          "info": "Overrides the default collection description. Keep it short."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collection Glass Grid",
      "blocks": [
        { "type": "collection" },
        { "type": "collection" },
        { "type": "collection" }
      ]
    }
  ]
}
{% endschema %}

{% style %}
.collection-glass-section {
  padding: 50px;
  
}

.section-header {
  margin-bottom: 45px;
}
.section-heading {
  font-size: 2.4rem;
  font-weight: 700;
  margin: 0 0 8px 0;
  letter-spacing: -0.02em;
}
.section-subheading {
  font-size: 1.1rem;
  color: #6b6b7b;
  margin: 0;
}

/* ----- Grid ----- */
.collection-grid-wrapper {
  overflow: hidden;
}
.collection-grid {
  display: grid;
  grid-template-columns: repeat(var(--per-row, 3), 1fr);
  gap: var(--gap, 25px);
}

/* ----- Card ----- */
.collection-card {
  position: relative;
  border-radius: 18px;
  overflow: hidden;
  aspect-ratio: 3 / 4;
  background: #f0f0f0;
  box-shadow: 0 10px 30px rgba(0,0,0,0.05);
  transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.5s ease;
  opacity: 0;
  transform: translateY(40px) scale(0.97);
  animation: fadeUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  animation-delay: var(--anim-delay, 0s);
}

.collection-card:hover {
  transform: scale(1.02) translateY(-6px);
  box-shadow: 0 25px 50px rgba(0,0,0,0.15);
  z-index: 2;
}

@keyframes fadeUp {
  0% { opacity: 0; transform: translateY(40px) scale(0.97); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

/* ----- Image ----- */
.card-image-wrapper {
  width: 100%;
  height: 100%;
  overflow: hidden;
}
.collection-img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
}
.collection-card:hover .collection-img {
  transform: scale(1.08);
}
.placeholder-svg {
  width: 100%;
  height: 100%;
  background: #e8e8e8;
}

/* ----- Gradient Blur Overlay (Text is 100% opaque) ----- */
.blur-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 80px 18px 18px 18px; 
  min-height: 50%;
  
  display: flex;
  flex-direction: column;
  justify-content: flex-end;
  
  border: none;
  border-radius: 0;
  box-shadow: none;
  color: #fff;
}

/* The blur and gradient live in a pseudo-element */
.blur-overlay::before {
  content: '';
  position: absolute;
  inset: 0;
  z-index: 0;
  
  background: linear-gradient(to top, rgba(0, 0, 0, 0.35) 0%, transparent 100%);
  
  backdrop-filter: blur(10px) saturate(180%);
  -webkit-backdrop-filter: blur(10px) saturate(180%);
  
  -webkit-mask-image: linear-gradient(to top, 
    rgba(0,0,0,1) 0%, 
    rgba(0,0,0,1) 40%, 
    rgba(0,0,0,0) 100%
  );
  mask-image: linear-gradient(to top, 
    rgba(0,0,0,1) 0%, 
    rgba(0,0,0,1) 40%, 
    rgba(0,0,0,0) 100%
  );
}

.collection-card:hover .blur-overlay::before {
  backdrop-filter: blur(14px) saturate(200%);
  -webkit-backdrop-filter: blur(14px) saturate(200%);
  background: linear-gradient(to top, rgba(0, 0, 0, 0.45) 0%, transparent 100%);
}

/* Fallback for older browsers */
@supports not (backdrop-filter: blur(10px)) {
  .blur-overlay::before {
    background: linear-gradient(to top, rgba(0, 0, 0, 0.7) 0%, transparent 100%);
  }
}

/* ----- Content inside the overlay (100% opaque) ----- */
.overlay-content {
  position: relative;
  z-index: 1;
  display: flex;
  flex-direction: column;
  gap: 4px;
  max-width: 90%;
  opacity: 1;
}

.collection-title {
  font-size: 1.4rem;
  font-weight: 700;
  margin: 0;
  line-height: 1.2;
  letter-spacing: -0.01em;
  color: #fff;
  opacity: 1;
}
.collection-desc {
  font-size: 0.85rem;
  margin: 4px 0 10px;
  opacity: 1;
  line-height: 1.5;
  color: #fff;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

/* ----- Button ----- */
.btn--primary {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 10px 24px 10px 26px;
  background: #ffffff;
  color: #1a1a2a;
  font-weight: 600;
  font-size: 0.8rem;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  border-radius: 60px;
  text-decoration: none;
  transition: all 0.3s ease;
  border: none;
  box-shadow: 0 4px 16px rgba(0,0,0,0.15);
  width: fit-content;
  margin-top: 2px;
  opacity: 1;
}
.btn--primary .btn-arrow {
  transition: transform 0.3s ease;
  display: inline-block;
}
.btn--primary:hover {
  background: #000000;
  color: #ffffff;
  box-shadow: 0 8px 24px rgba(0,0,0,0.30);
  transform: scale(1.04);
}
.btn--primary:hover .btn-arrow {
  transform: translateX(4px);
}

/* ================================================================ */
/*  RESPONSIVE: TABLET & MOBILE (EXPLICIT FLEX COLUMN ON MOBILE)  */
/* ================================================================ */

@media (max-width: 1024px) {
  .collection-grid {
    --per-row: 2;
  }
}

@media (max-width: 749px) {
  .collection-glass-section {
    padding: 20px;
  }
  .section-heading {
    font-size: 1.8rem;
  }
  
  /* ----- MOBILE: OVERRIDE GRID -> FLEX COLUMN ----- */
  .collection-grid {
    display: flex;               /* Switch from grid to flex */
    flex-direction: column;      /* Stack cards vertically */
    align-items: center;         /* Center the cards */
    gap: var(--gap, 20px);
    grid-template-columns: unset; /* Remove grid columns */
  }
  
  .collection-card {
    max-width: 480px;            /* Prevents cards from stretching too wide on large phones */
    width: 100%;
    aspect-ratio: 3 / 4;         /* Keep the 3:4 proportion on mobile */
  }

  .blur-overlay {
    padding: 60px 20px 20px 20px;
    min-height: 45%;
  }
  .collection-title {
    font-size: 1.2rem;
  }
  .btn--primary {
    padding: 8px 18px 8px 20px;
    font-size: 0.7rem;
  }
}
{% endstyle %}

{% javascript %}
document.addEventListener('DOMContentLoaded', function() {
  // All animations are handled by CSS.
});
{% endjavascript %}